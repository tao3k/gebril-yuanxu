(import :clan/poo/object (only-in :core/types poo-flow-predicate-contract))
(export ProcessScriptContract OpsConfigContract OpsScopeContract OpsEnvironmentContract)
(def (environment? value)
  (and (object? value)
       (every (lambda (key)
                (and (symbol? key) (not (string-empty? (symbol->string key)))
                     (not (string-index (symbol->string key) #\=))
                     (string? (.ref value key))))
              (.all-slots value))))
(def OpsEnvironmentContract
  (poo-flow-predicate-contract 'ops/environment environment? (lambda (_v _c) '())))
(def (execution-options? value)
  (and (object? value)
       (every (cut .slot? value <>) '(directory environment timeout log check-status))
       (or (not (.get value directory)) (string? (.get value directory)))
       (environment? (.get value environment))
       (or (not (.get value timeout))
           (and (real? (.get value timeout)) (> (.get value timeout) 0)))
       (or (not (.get value log)) (string? (.get value log)))
       (boolean? (.get value check-status))))
(def (process-script? value)
  (and (execution-options? value) (.slot? value 'command)
       (pair? (.get value command)) (every string? (.get value command))
       (not (string-empty? (car (.get value command))))))
(def OpsConfigContract
  (poo-flow-predicate-contract 'ops/config execution-options? (lambda (_v _c) '())))
(def (ops-scope? scope)
  (and (object? scope)
       (every (cut .slot? scope <>) '(config types prototypes validate prepare-command merge-environment preview run))
       (execution-options? (.get scope config))
       (object? (.get scope types))
       (every (cut .slot? (.get scope types) <>) '(ProcessScript Config Environment))
       (eq? (.get scope types ProcessScript) ProcessScriptContract)
       (eq? (.get scope types Config) OpsConfigContract)
       (eq? (.get scope types Environment) OpsEnvironmentContract)
       (every (lambda (name) (procedure? (.ref scope name)))
              '(validate prepare-command merge-environment preview run))
       (object? (.get scope prototypes))
       (every (lambda (name)
                (and (.slot? (.get scope prototypes) name)
                     (let (prototype (.ref (.get scope prototypes) name))
                       (and (object? prototype) (.slot? prototype '.run)
                            (procedure? (.get prototype .run))))))
              '(Script SelectedPackages))))
(def OpsScopeContract
  (poo-flow-predicate-contract 'ops/scope ops-scope? (lambda (_v _c) '())))
(def ProcessScriptContract
  (poo-flow-predicate-contract 'ops/process-script process-script? (lambda (_v _c) '())))

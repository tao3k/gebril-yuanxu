(import "/tmp/agenticailab-pipeline-receiver-pin/object")
(def count 0)
(def (check label condition)
  (unless condition (error "FAIL" label))
  (set! count (+ count 1)))
(def (same-values? objects expected)
  (equal? (map (lambda (item) (.get item value)) objects) expected))
(def pipeline-demands 0)
(def check-demands 0)
(def Root
  (.o (:: effective-config [])
    build: (.o value: 'build)
    test: (.o value: 'test)
    package: (.o value: 'package)
    pipeline:
    (begin
      (set! pipeline-demands (+ pipeline-demands 1))
      (.o selected-checks: '(build test package)
          checks:
          (begin
            (set! check-demands (+ check-demands 1))
            (map (lambda (name) (.ref effective-config name)) selected-checks))))))
(.def OtherRoot extra: 'other)
(.def RightRoot flag: 'right)
(.def RootContract identity: 'root-contract)
(.def OtherContract identity: 'other-contract)
(.def RightContract identity: 'right-contract)
(def anchors (make-hash-table-eq))
(hash-put! anchors Root (list RootContract))
(hash-put! anchors OtherRoot (list OtherContract))
(hash-put! anchors RightRoot (list RightContract))
(def (native-profile-anchors candidate-value anchor-index)
  (let ((state (make-hash-table-eq))
        (found '()))
    (let walk ((current candidate-value))
      (unless (object? current)
        (error "profile-parent-is-not-native-object" current))
      (let ((mark (hash-ref state current #f)))
        (cond
          ((eq? mark 'visiting) (error "cyclic-profile-parent-graph" current))
          ((eq? mark 'done) (void))
          (else
            (hash-put! state current 'visiting)
            (set! found (append (hash-ref anchor-index current '()) found))
            (for-each walk (object-supers current))
            (hash-put! state current 'done)))))
    (when (null? found)
      (error "missing-published-profile-root" candidate-value))
    found))

(def (has-contract? candidate descriptor)
  (and (memq descriptor (native-profile-anchors candidate anchors)) #t))
(def parent-checks (.get Root pipeline checks))
(check 'parent-values (same-values? parent-checks '(build test package)))
(check 'parent-cached (and (= pipeline-demands 1) (= check-demands 1)))
(.def (Child @ Root)
  build: =>.+ (.o value: 'child-build)
  test: =>.+ (.o value: 'child-test)
  package: =>.+ (.o value: 'child-package)
  smoke: (.o value: 'smoke)
  pipeline: =>.+ (.o selected-checks: '(build test package smoke)))
(check 'def-direct-parent (memq Root (object-supers Child)))
(check 'def-contract-retained (has-contract? Child RootContract))
(check 'declaration-keeps-pipeline-lazy (= pipeline-demands 1))
(check 'declaration-keeps-checks-lazy (= check-demands 1))
(def final-checks (.get Child pipeline checks))
(check 'final-values (same-values? final-checks '(child-build child-test child-package smoke)))
(check 'child-pipeline-cache-distinct (not (eq? (.get Child pipeline) (.get Root pipeline))))
(check 'child-list-cache-distinct (not (eq? final-checks parent-checks)))
(check 'child-demand-count (and (= pipeline-demands 2) (= check-demands 2)))
(for-each (lambda (object name)
            (check name (eq? object (.ref Child name))))
          final-checks '(build test package smoke))
(check 'child-cache-stable (eq? final-checks (.get Child pipeline checks)))
(check 'parent-cache-stable (eq? parent-checks (.get Root pipeline checks)))
(check 'parent-values-unchanged (same-values? parent-checks '(build test package)))
(check 'nested-refinement-has-base
  (pair? (object-supers (.get Child build))))
(check 'nested-base-has-inherited-value
  (same-values? (object-supers (.get Child build)) '(build)))
(check 'inline-parent-recomputed-for-child
  (not (memq (.get Root build) (object-supers (.get Child build)))))
(def SharedCheck (.o value: 'shared))
(.def SharedProfile build: SharedCheck)
(.def (SharedChild @ SharedProfile) build: =>.+ (.o value: 'shared-child))
(check 'constant-export-base-identity-retained
  (memq SharedCheck (object-supers (.get SharedChild build))))
(.def (Multi @ [Child OtherRoot]))
(check 'multiple-direct-parents (= (length (object-supers Multi)) 2))
(check 'multiple-root-contracts
  (and (has-contract? Multi RootContract) (has-contract? Multi OtherContract)))
(check 'multiple-keeps-final-values
  (same-values? (.get Multi pipeline checks) '(child-build child-test child-package smoke)))
(def Mixed (.+ Root (.o extra: 'added)))
(check 'plus-left-parent (memq Root (object-supers Mixed)))
(check 'plus-left-contract (has-contract? Mixed RootContract))
(check 'plus-copied-field (eq? (.get Mixed extra) 'added))
(def LostRight (.+ Root RightRoot))
(check 'right-field-copied (eq? (.get LostRight flag) 'right))
(check 'right-object-not-parent (not (memq RightRoot (object-supers LostRight))))
(check 'right-contract-not-discoverable (not (has-contract? LostRight RightContract)))
(.def (RightChild @ RightRoot) extra: 'child)
(def KeptRightAncestor (.+ Root RightChild))
(check 'right-ancestor-parent (memq RightRoot (object-supers KeptRightAncestor)))
(check 'right-ancestor-contract-retained (has-contract? KeptRightAncestor RightContract))
(check 'right-child-identity-not-parent
  (not (memq RightChild (object-supers KeptRightAncestor))))
(def RightChildContract (.o identity: 'right-child-contract))
(hash-put! anchors RightChild (list RightChildContract))
(check 'right-child-own-contract-not-retained
  (not (has-contract? KeptRightAncestor RightChildContract)))
(.def (RightSame @ Root))
(def SameRootPlus (.+ Root RightSame))
(check 'same-root-duplicate-retained
  (= (length (filter (lambda (x) (eq? x Root)) (object-supers SameRootPlus))) 2))
;; A known-stale list is a refusal control, not a passing effective Pipeline.
(.def (Frozen @ Child)
  pipeline: =>.+ (.o checks: parent-checks))
(def (final-check-identities? config)
  (let ((actual (.get config pipeline checks))
        (expected (map (lambda (name) (.ref config name))
                       (.get config pipeline selected-checks))))
    (and (= (length actual) (length expected))
         (every eq? actual expected))))
(check 'final-identity-admission (final-check-identities? Child))
(check 'stale-parent-list-refused (not (final-check-identities? Frozen)))
(.def (SameCountChild @ Root)
  build: =>.+ (.o value: 'same-count-child))
(.def (SameCountFrozen @ SameCountChild)
  pipeline: =>.+ (.o checks: parent-checks))
(check 'same-count-final-values
  (same-values? (.get SameCountChild pipeline checks) '(same-count-child test package)))
(check 'same-count-final-identities (final-check-identities? SameCountChild))
(check 'same-count-parent-list-refused
  (not (final-check-identities? SameCountFrozen)))
(def (accept-child-build? candidate)
  (eq? (.get candidate build value) 'child-build))
(.def FinalValueContract
  identity: 'final-value-contract
  .admit: accept-child-build?)
(hash-put! anchors Root (list FinalValueContract))
(def linked (native-profile-anchors Child anchors))
(check 'associated-contract-observed (memq FinalValueContract linked))
(check 'associated-contract-accepts-final-child
  ((.get (car linked) .admit) Child))
(check 'associated-contract-rejects-old-parent
  (not ((.get (car linked) .admit) Root)))
(def Copy (.o value: 'copy))
(check 'copy-without-parent-has-no-origin
  (with-catch (lambda (caught) #t)
    (lambda () (native-profile-anchors Copy anchors) #f)))
(displayln "PASS native-parent probe assertions=" count)

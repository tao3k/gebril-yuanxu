(import :clan/poo/object :yuanxu/types)
(def assertions 0)
(def (check label accepted)
  (unless accepted (error "native correspondence assertion failed" label))
  (set! assertions (+ assertions 1)))
(def identity-table (make-hash-table-eq))
(def identity-values '())
(def next-id 0)
(def (identity-of value)
  (if (hash-key? identity-table value) (hash-ref identity-table value)
    (let ((new-id next-id))
      (set! next-id (+ next-id 1))
      (hash-put! identity-table value new-id)
      (set! identity-values (cons value identity-values))
      new-id)))
(def (bit value) (if value 1 0))
(def (emit value)
  ;; Serialize an unshared numeric tree; do not emit Gambit #n= graph labels.
  (write (let copy ((current value))
           (if (pair? current) (cons (copy (car current)) (copy (cdr current))) current)))
  (newline))
(def pipeline-forces 0)
(def checks-forces 0)
(def Root
  (.o (:: effective-config [])
    build: (.o value: 'build)
    test: (.o value: 'test)
    package: (.o value: 'package)
    pipeline:
    (begin
      (set! pipeline-forces (+ pipeline-forces 1))
      (.o selected-checks: '(build test package)
          checks:
          (begin
            (set! checks-forces (+ checks-forces 1))
            (map (lambda (name) (.ref effective-config name)) selected-checks))))))
(def parent-checks (.get Root pipeline checks))
(check 'parent-cache-forced (and (= pipeline-forces 1) (= checks-forces 1)))
(.def (Child @ Root)
  build: =>.+ (.o value: 'child-build)
  smoke: (.o value: 'smoke)
  pipeline: =>.+ (.o selected-checks: '(build test package smoke)))
(check 'child-declaration-lazy (and (= pipeline-forces 1) (= checks-forces 1)))
(.def Other extra: #t)
(.def (Multi @ [Child Other]))
(.def (Left @ Root))
(.def (Right @ Root))
(.def (Diamond @ [Left Right]))
(.def RightProvider flag: 'unapproved)
(def LostRight (.+ Root RightProvider))
(.def (Frozen @ Child)
  pipeline: =>.+ (.o checks: parent-checks))
(.def (SameCount @ Root) build: =>.+ (.o value: 'same-count))
(.def (SameCountFrozen @ SameCount)
  pipeline: =>.+ (.o checks: parent-checks))
(def obligation-calls 0)
(def (final-identities? candidate)
  (let ((actual (.get candidate pipeline checks))
        (expected (map (lambda (name) (.ref candidate name))
                       (.get candidate pipeline selected-checks))))
    (and (= (length actual) (length expected)) (every eq? actual expected))))
(def (final-obligations candidate context)
  (set! obligation-calls (+ obligation-calls 1))
  (if (and (eq? candidate (.get context target)) (final-identities? candidate)) '()
    (list (.o kind: 'stale-final-checks))))
(def RootContract (yuanxu-predicate-contract 'probe/root object? final-obligations))
(def SecondRootContract (yuanxu-predicate-contract 'probe/shared-root object? final-obligations))
(def (extra-obligations candidate context)
  (if (.get candidate extra) '() (list (.o kind: 'missing-extra))))
(def OtherContract (yuanxu-predicate-contract 'probe/other object? extra-obligations))
(def (right-obligations candidate context)
  (if (eq? (.get candidate flag) 'approved) '() (list (.o kind: 'right-policy-failed))))
(def RightContract (yuanxu-predicate-contract 'probe/right object? right-obligations))
(def anchor-index (make-hash-table-eq))
(hash-put! anchor-index Root (list RootContract SecondRootContract))
(hash-put! anchor-index Other (list OtherContract))
(hash-put! anchor-index RightProvider (list RightContract))
(def root-bindings (list (list Root RootContract) (list Root SecondRootContract)
                         (list Other OtherContract) (list RightProvider RightContract)))
(def (native-profile-anchors candidate-value anchor-index)
  (let ((state (make-hash-table-eq))
        (found '()))
    (let walk ((current candidate-value))
      (unless (object? current)
        (error "profile-parent-is-not-native-object" current))
      (let ((mark (hash-ref state current #f)))
        (cond
          ((eq? mark 'visiting) (error "cyclic-profile-parent-graph" current))
          ((eq? mark 'done) (void))
          (else
            (hash-put! state current 'visiting)
            (set! found (append (hash-ref anchor-index current '()) found))
            (for-each walk (object-supers current))
            (hash-put! state current 'done)))))
    (when (null? found)
      (error "missing-published-profile-root" candidate-value))
    found))

(def (graph-of root)
  (let ((seen (make-hash-table-eq)) (rows '()))
    (let visit ((current root))
      (unless (hash-key? seen current)
        (hash-put! seen current #t)
        (set! rows (cons (list (identity-of current)
                              (map identity-of (object-supers current))) rows))
        (for-each visit (object-supers current))))
    (reverse rows)))
(def (contract-id descriptor) (identity-of (.get descriptor identity)))
(def (check-ids config)
  (map identity-of (.get config pipeline checks)))
(def (expected-ids config)
  (map (lambda (name) (identity-of (.ref config name)))
       (.get config pipeline selected-checks)))
(def (checked-receipt? descriptor candidate context evidence)
  (and (yuanxu-validation-evidence? evidence)
       (yuanxu-validation-evidence-accepted? evidence)
       (eq? (.get evidence contract-identity) (.get descriptor identity))
       (eq? (.get evidence candidate) candidate)
       (eq? (.get evidence context) context)
       (eq? (.get evidence classification type-identity) (.get descriptor identity))
       (eq? (.get evidence classification candidate) candidate)
       (eq? (.get evidence classification context) context)))
(def (evidence-row descriptor candidate context evidence)
  (let* ((classified (.get evidence classification accepted?))
         (obligations (.get evidence obligation-evidence))
         (accepted (.get evidence accepted?)))
    (check 'actual-core-rule (eq? accepted (and classified (null? obligations))))
    (list (contract-id descriptor) (identity-of candidate) (identity-of context)
          (bit (yuanxu-validation-evidence? evidence))
          (identity-of (.get evidence contract-identity))
          (identity-of (.get evidence candidate)) (identity-of (.get evidence context))
          (identity-of (.get evidence classification type-identity))
          (bit classified) (map identity-of obligations) (bit accepted)
          (identity-of (.get evidence classification candidate))
          (identity-of (.get evidence classification context))
          (bit (checked-receipt? descriptor candidate context evidence)))))
(def (emit-responsibility descriptor candidate context evidence)
  (let* ((children (.get evidence responsibility-evidence))
         (own-failures
          (filter (lambda (failure) (not (memq failure children)))
                  (.get evidence obligation-evidence))))
    (check 'actual-responsibility-rule
      (eq? (.get evidence accepted?)
           (and (.get evidence classification accepted?)
                (every yuanxu-validation-evidence-accepted? children)
                (null? own-failures))))
    (emit (list 'responsibility
      (evidence-row descriptor candidate context evidence)
      (map (lambda (entry)
             (let ((role (.get entry responsibility)))
               (evidence-row (.ref (.get descriptor responsibilities) role)
                             (.ref candidate role) context entry))) children)
      (map identity-of own-failures)))))
(def (emit-case name config accepted?)
  (let* ((found (native-profile-anchors config anchor-index))
         (context (.o target: config))
         (evidence (yuanxu-contract-admit RootContract config context)))
    (check 'actual-profile-admission
      (eq? (yuanxu-validation-evidence-accepted? evidence) accepted?))
    (emit (list 'case name (identity-of config) (graph-of config)
                (map (lambda (pair) (list (identity-of (car pair)) (contract-id (cadr pair)))) root-bindings)
                (map contract-id found) (check-ids config) (expected-ids config)
                (evidence-row RootContract config context evidence)))))
(emit-case 0 Child #t)
(emit-case 1 Multi #t)
(emit-case 2 Diamond #t)
(emit-case 3 LostRight #t)
(emit-case 4 Frozen #f)
(emit-case 5 SameCountFrozen #f)
(check 'parent-cache-unchanged (eq? parent-checks (.get Root pipeline checks)))
(check 'inline-inherited-base-not-parent-cache
  (not (memq (.get Root build) (object-supers (.get Child build)))))
(check 'two-shared-root-contracts-found
  (and (memq RootContract (native-profile-anchors Diamond anchor-index))
       (memq SecondRootContract (native-profile-anchors Diamond anchor-index))))
(check 'other-root-found (memq OtherContract (native-profile-anchors Multi anchor-index)))
(check 'right-root-lost (not (memq RightContract (native-profile-anchors LostRight anchor-index))))
(def multi-context (.o target: Multi))
(emit (list 'receipt (evidence-row OtherContract Multi multi-context
  (yuanxu-contract-admit OtherContract Multi multi-context))))
(emit (list 'receipt (evidence-row SecondRootContract Multi multi-context
  (yuanxu-contract-admit SecondRootContract Multi multi-context))))
(def rhs-context (.o target: LostRight))
(def right-evidence (yuanxu-contract-admit RightContract LostRight rhs-context))
(check 'right-real-contract-refused (not (yuanxu-validation-evidence-accepted? right-evidence)))
(emit (list 'receipt (evidence-row RightContract LostRight rhs-context right-evidence)))
(def accepted-evidence (yuanxu-contract-admit RootContract Child (.o target: Child)))
(def stale-context (.o target: Child))
(check 'stale-context-receipt-refused
  (not (checked-receipt? RootContract Child stale-context accepted-evidence)))
(emit (list 'receipt (evidence-row RootContract Child stale-context accepted-evidence)))
(check 'stale-candidate-receipt-refused
  (not (checked-receipt? RootContract Root (.get accepted-evidence context) accepted-evidence)))
(emit (list 'receipt (evidence-row RootContract Root (.get accepted-evidence context) accepted-evidence)))
(def before-obligations obligation-calls)
(def invalid-context (.o target: 42))
(def invalid-evidence (yuanxu-contract-admit RootContract 42 invalid-context))
(check 'classifier-refusal (not (yuanxu-validation-evidence-accepted? invalid-evidence)))
(check 'classifier-refusal-skips-obligations (= before-obligations obligation-calls))
(emit (list 'receipt (evidence-row RootContract 42 invalid-context invalid-evidence)))
(def (empty-obligations candidate context) '())
(def CheckObjectContract
  (yuanxu-predicate-contract 'probe/check-object object? empty-obligations))
(def PipelineObjectContract
  (yuanxu-predicate-contract 'probe/pipeline-object object? empty-obligations))
(.def (ProfileShapeContract @ YuanxuObjectContract.)
  identity: 'probe/profile-shape
  proto: Root
  responsibilities:
  (.o build: CheckObjectContract pipeline: PipelineObjectContract)
  .obligations: final-obligations)
(def shape-context (.o target: Child))
(def shape-evidence (yuanxu-contract-admit ProfileShapeContract Child shape-context))
(check 'responsibility-admission-accepts-final-child
  (yuanxu-validation-evidence-accepted? shape-evidence))
(emit-responsibility ProfileShapeContract Child shape-context shape-evidence)
(.def (InvalidBuild @ Child) build: 42)
(def bad-context (.o target: InvalidBuild))
(def before-shape-obligations obligation-calls)
(def bad-shape (yuanxu-contract-admit ProfileShapeContract InvalidBuild bad-context))
(check 'responsibility-child-failure-refused
  (not (yuanxu-validation-evidence-accepted? bad-shape)))
(check 'responsibility-failure-skips-parent-obligations
  (= before-shape-obligations obligation-calls))
(emit-responsibility ProfileShapeContract InvalidBuild bad-context bad-shape)
(def Plain (.o build: (.o value: 'plain) pipeline: (.o)))
(def plain-context (.o target: Plain))
(def plain-before obligation-calls)
(def plain-evidence (yuanxu-contract-admit ProfileShapeContract Plain plain-context))
(check 'native-prototype-mismatch-refused
  (not (yuanxu-validation-evidence-accepted? plain-evidence)))
(check 'native-prototype-mismatch-skips-obligations (= plain-before obligation-calls))
(emit-responsibility ProfileShapeContract Plain plain-context plain-evidence)
(def discovered (map contract-id (native-profile-anchors LostRight anchor-index)))
(def mandatory (list (contract-id RootContract) (contract-id RightContract)))
(def (compose-accepted? retained results)
  (and (every (lambda (requirement) (memq requirement retained)) mandatory)
       (every (lambda (requirement) (cdr (assq requirement results))) retained) #t))
(def root-ok (yuanxu-contract-admit RootContract LostRight rhs-context))
(def shared-ok (yuanxu-contract-admit SecondRootContract LostRight rhs-context))
(def results (list (cons (contract-id RootContract) (.get root-ok accepted?))
                   (cons (contract-id RightContract) (.get right-evidence accepted?))
                   (cons (contract-id SecondRootContract) (.get shared-ok accepted?))))
(check 'mandatory-rhs-loss-refused (not (compose-accepted? discovered results)))
(emit (list 'gate mandatory discovered
  (map (lambda (pair) (list (car pair) (bit (cdr pair)))) results)
  (bit (compose-accepted? discovered results))))
(check 'retained-failed-rhs-refused (not (compose-accepted? mandatory results)))
(emit (list 'gate mandatory mandatory
  (map (lambda (pair) (list (car pair) (bit (cdr pair)))) results)
  (bit (compose-accepted? mandatory results))))
(def (emit-boundary config context rhs-contracts retained-contracts expected?)
  (let* ((found (native-profile-anchors config anchor-index))
         (all (append found rhs-contracts))
         (evidence
          (map (lambda (descriptor)
                 (yuanxu-contract-admit descriptor config context)) all))
         (mandatory-ids (map contract-id all))
         (retained-ids (map contract-id retained-contracts))
         (accepted
          (and (every (lambda (id) (memq id retained-ids)) mandatory-ids)
               (every (lambda (descriptor entry)
                        (checked-receipt? descriptor config context entry)) all evidence))))
    (check 'actual-checked-boundary (eq? accepted expected?))
    (emit (list 'boundary (identity-of config) (identity-of context) (graph-of config)
      (map (lambda (pair) (list (identity-of (car pair)) (contract-id (cadr pair)))) root-bindings)
      (map contract-id rhs-contracts) retained-ids
      (map (lambda (descriptor entry) (evidence-row descriptor config context entry)) all evidence)
      (bit accepted)))))
(emit-boundary Multi multi-context '() (native-profile-anchors Multi anchor-index) #t)
(emit-boundary LostRight rhs-context (list RightContract)
  (native-profile-anchors LostRight anchor-index) #f)
(emit-boundary LostRight rhs-context (list RightContract)
  (append (native-profile-anchors LostRight anchor-index) (list RightContract)) #f)
(def Cycle (.o))
(set! (object-supers Cycle) (list Cycle))
(check 'actual-dfs-cycle-refused
  (with-catch (lambda (caught) #t)
    (lambda () (native-profile-anchors Cycle anchor-index) #f)))
(emit (list 'cycle (identity-of Cycle) (graph-of Cycle)))
(def EqualA (.o value: 1))
(def EqualB (.o value: 1))
(def identity-samples
  (list Root Root Child Multi Other (.get Root pipeline) (.get Child pipeline)
        (.get Root pipeline) (.get Root build) (.get Child build) EqualA EqualB))
(emit (list 'identity
  (apply append
    (map (lambda (left)
      (map (lambda (right)
        (list (identity-of left) (identity-of right) (bit (eq? left right)))) identity-samples))
      identity-samples))))
(check 'identity-injective-on-observed-values
  (every (lambda (left)
    (every (lambda (right) (eq? (eq? left right) (= (identity-of left) (identity-of right)))) identity-values))
    identity-values))
(emit (list 'pass assertions next-id))

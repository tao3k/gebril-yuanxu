;;; A selected source package, not a compiler/runtime or a catalog copier.
(import :clan/poo/object
        (only-in :std/io/tempfile make-temporary-file-name)
        (only-in :std/string/path path-absolute?)
        (only-in :yuanxu/module-system/source/admission module-source-type module-source-admit-current!)
        (only-in :yuanxu/module-system/source/objects yuanxu-module-source-ref-metadata))
(export write-selected-package)
(def (write-text path text)
  (create-directory* (path-directory path))
  (call-with-output-file path (cut display text <>)))
(def (datum-text value)
  (call-with-output-string (lambda (port) (write value port) (newline port))))
(def (remove-staging! path)
  (when (module-source-type path)
    (if (eq? (module-source-type path) 'directory)
      (begin (for-each (lambda (name) (remove-staging! (path-expand name path))) (directory-files path))
             (delete-directory path))
      (delete-file path))))
(def (package-location owner)
  (def parts (string-split (symbol->string owner) #\/))
  ;; The current init grammar has an optional category and one literal name.
  (unless (<= 1 (length parts) 2) (error "package init cannot represent Module identity" owner))
  (values (and (= (length parts) 2) (string->symbol (string-append ":" (car parts))))
          (string->symbol (car (reverse parts)))
          (string-append "modules/" (symbol->string owner))))
(def (write-selected-package graph directory)
  ((.get graph admit-current))
  (unless (and (null? (.get graph external-packages)) (null? (.get graph other-projections)))
    (error "source packaging requires realized external contributions"))
  (when (module-source-type directory) (error "package output must be fresh" directory))
  (def destination (path-expand directory))
  (def selected (.get graph selected-graph))
  (def publications (filter (lambda (entry) (eq? (.get entry kind) 'publication)) (.get graph entries)))
  (def writes '())
  (def init-rows '())
  (def (stage! path text)
    (unless (and (string? path) (not (path-absolute? path))
                 (andmap (lambda (part) (not (member part '("" "." "..")))) (string-split path #\/)))
      (error "invalid package-relative path" path))
    (let (old (assoc path writes))
      (if old
        (unless (equal? text (cdr old)) (error "conflicting package path" path))
        (set! writes (cons (cons path text) writes)))))
  (for-each
    (lambda (entry)
      (def owner (.get entry owner))
      (def input (.get entry input))
      (def metadata (yuanxu-module-source-ref-metadata (.get input source)))
      (def source-root (cdr (or (assq 'module-root metadata) (assq 'module-tree-root metadata))))
      (def prefix (string-append (path-strip-trailing-directory-separator (path-normalize source-root)) "/"))
      (defvalues (category name relative) (package-location owner))
      ;; Preserve the actual native package and prelude, not an invented alias.
      (def package-id (string->symbol (path-strip-trailing-directory-separator
                                      (path-directory (symbol->string (.get entry compiler-identity))))))
      (stage! (string-append relative "/gerbil.pkg")
        (datum-text (append (list 'package: package-id)
                           (if (.get input prelude) (list 'prelude: (.get input prelude)) '()))))
      (for-each
        (lambda (source)
          (def path (.get source path))
          (when (and (eq? (.get source kind) 'source) (eq? (.get source owner) owner) (string-prefix? prefix path))
            (let (snapshot (assoc path (.get source input source-inputs)))
              (unless (and snapshot (string? (cdr snapshot))) (error "package source has no snapshot" path))
              (stage! (string-append relative "/" (substring path (string-length prefix) (string-length path)))
                      (cdr snapshot))
            (for-each
              (lambda (observation)
                (let (file (path-normalize (car observation)))
                  (when (and (cdr observation) (string-prefix? prefix file)
                             (string=? (path-strip-directory file) "gerbil.pkg")
                             (not (string=? file (path-expand "gerbil.pkg" source-root))))
                    (stage! (string-append relative "/" (substring file (string-length prefix) (string-length file)))
                            (cdr observation)))))
              (.get source input source-inputs)))))
        (.get graph entries))
      ;; interface is not a source entry: copy its admitted body, without absolute includes.
      (def interface-path (path-expand "interface.ss" source-root))
      (stage! (string-append relative "/interface.ss") (cdr (assoc interface-path (.get input source-inputs))))
      (for-each
        (lambda (asset)
          (when (eq? (.get asset owner) owner)
            (stage! (string-append relative "/" (.get asset relative-path))
                    (cdr (assoc (.get asset path) (.get asset source-inputs))))))
        (.get graph assets)))
    publications)
  ;; Preserve declaration order for independent Feature decisions. Package file
  ;; order and dependency topological order must not become execution precedence.
  (def decisions (.get selected decisions))
  (def declared (map (lambda (row) (.get row identity)) decisions))
  (def order
    (append declared
      (filter (lambda (owner) (not (memq owner declared)))
              (append (.get selected module-order) (.get selected denied-modules)))))
  ;; Ungrouped names precede categories, matching the native init grammar.
  (def ordered
    (append (filter (lambda (owner) (not (memv #\/ (string->list (symbol->string owner))))) order)
            (filter (lambda (owner) (memv #\/ (string->list (symbol->string owner)))) order)))
  (for-each
    (lambda (owner)
      (when (or (memq owner (.get selected module-order)) (memq owner (.get selected denied-modules)))
        (let-values (((category name relative) (package-location owner)))
          (let* ((row (find (lambda (row) (eq? (.get row identity) owner)) decisions))
                 (flags (if row (.get row selection selection-flags) '())))
            (set! init-rows
              (append init-rows
                (if category (list category) '())
                (list (if (memq owner (.get selected denied-modules))
                    (append (list name 'disable: #t) flags)
                    (append (list name '@ (string-append "./" relative)) flags)))))))))
    ordered)
  (stage! "init.ss" (datum-text (append '(yuanxu! mode: explicit) init-rows)))
  ((.get graph admit-current))
  (create-directory* (path-directory destination))
  (def staging (make-temporary-file-name (string-append destination ".staging-")))
  (dynamic-wind void
    (lambda ()
      (for-each (lambda (row) (write-text (path-expand (car row) staging) (cdr row))) (reverse writes))
      ((.get graph admit-current))
      (when (module-source-type destination) (error "package output appeared during staging" destination))
      (rename-file staging destination))
    (lambda () (remove-staging! staging)))
  (.o root: destination files: (map car (reverse writes))
      selected-graph: selected))

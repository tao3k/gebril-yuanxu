;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Isolation experiment, NOT the production SourceAdmissionContract protocol.
(import :std/test :clan/poo/object
        (only-in :std/error Error? Error-message)
        (only-in :yuanxu/object-types/contracts yuanxu-classification-evidence)
        (only-in :yuanxu/admission/source SourceAdmissionContract.)
        (only-in :yuanxu/configuration/diagnostics config-diagnostic-locator)
        (only-in :yuanxu/module-system/source/admission
                 current-module-source-observer current-module-source-phase module-source-read)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/t/qualification/mop-state/closed-tail probe on-file refuses)
        (only-in :yuanxu/t/qualification/service-publication/fixtures
                 DirectoryFixture ServicesFixture write-source))
(export source-admission-closed-tail-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (check-equal? completed 8)
  (displayln "SOURCE-ADMISSION-CLOSED-TAIL: 8 cases completed"))

;; The only tail operation here is an integer update on privately owned storage.
;; No callback whitelist, pure flag, object slot dispatch, or arbitrary event key
;; hashing inside the tail. Foreign procedures may run BEFORE this phase only.
;; The phase is set by the real adapter; the experiment never sets it itself.
(def (closed-admit contract candidate context (foreign (current-module-source-observer)))
  (def counts (box 0))
  (def result-value
    (with-catch values
      (lambda ()
        (parameterize ((current-module-source-observer
                        (lambda (key amount)
                          (if (eq? (current-module-source-phase) 'return-currentness)
                            (begin
                              (when foreign (error "opaque source observer in return tail"))
                              (set-box! counts (+ (unbox counts) 1)))
                            (when foreign (foreign key amount))))))
          (.call contract .admit candidate context)))))
  (.o outcome: result-value events: (unbox counts)))
(def source-admission-closed-tail-test
 (test-suite "Closed instrumentation tail, with unchanged native admission"
  (yuanxu-test-fixture "fixed counter accepts cold and warm native admission without retaining a write lock"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def sample (probe (list path)))
    (def Contract (.get sample contract))
    (def subject (.get sample candidate))
    (def prior (current-module-source-observer))
    (for-each
      (lambda (_mode)
        (def result (closed-admit Contract subject #f))
        (check-equal? (.get result outcome accepted?) #t)
        (check-equal? (> (.get result events) 0) #t)
        (check-equal? (eq? prior (current-module-source-observer)) #t))
      '(cold warm))
    (.putslot! subject 'port ($constant-slot-spec 5433))
    (check-equal? (.get subject port) 5433)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "opaque observer cannot late-write receiver candidate or external dependency"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (for-each
      (lambda (target)
        (def sample (probe (list path)))
        (def Contract (.get sample contract))
        (def subject (.get sample candidate))
        (check-equal? (.get (.call Contract .admit subject #f) accepted?) #t)
        (def receiver (case target ((receiver) Contract) ((candidate) subject)
                               ((external) (.get sample external))))
        (def key (if (eq? target 'receiver) 'marker 'port))
        (def before (object-revision receiver))
        (def called 0)
        (def observer
          (on-file path (lambda ()
                          (set! called (+ called 1))
                          (.putslot! receiver key ($constant-slot-spec 9000)))))
        (def result (closed-admit Contract subject #f observer))
        (refuses (.get result outcome) "opaque source observer in return tail")
        (check-equal? called 0)
        (check-equal? (object-revision receiver) before)
        (check-equal? (.ref receiver key) (if (eq? target 'receiver) 0 5432)))
      '(receiver candidate external))
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "second file callback cannot rewrite the first file in the closed tail"
    (fixture DirectoryFixture)
    (def first (path-expand "first.json" (.get fixture root)))
    (def second (path-expand "second.json" (.get fixture root)))
    (write-source first "{}") (write-source second "{}")
    (def sample (probe (list first second)))
    (def called 0)
    (def result
      (closed-admit (.get sample contract) (.get sample candidate) #f
        (on-file second (lambda ()
                          (set! called (+ called 1))
                          (write-source first "{\"late\":true}")))))
    (refuses (.get result outcome) "opaque source observer in return tail")
    (check-equal? called 0)
    (check-equal? (module-source-read first) "{}")
    (check-equal? (module-source-read second) "{}")
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "even an apparently benign foreign observer is refused, not asserted pure"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def sample (probe (list path)))
    (def early 0)
    (def late 0)
    (def observer
      (lambda (_key _amount)
        (if (eq? (current-module-source-phase) 'return-currentness)
          (set! late (+ late 1)) (set! early (+ early 1)))))
    (def result
      (parameterize ((current-module-source-observer observer))
        (def result (closed-admit (.get sample contract) (.get sample candidate) #f))
        (check-equal? (eq? (current-module-source-observer) observer) #t)
        result))
    (refuses (.get result outcome) "opaque source observer in return tail")
    (check-equal? (> early 0) #t)
    (check-equal? late 0)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "existing pre-tail source diagnostic keeps precedence over object staleness"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def sample (probe (list path)))
    (def dependency (.get sample external))
    (def context
      (.o admit-current: (lambda ()
                           (.putslot! dependency 'port ($constant-slot-spec 5433))
                           (write-source path "{\"changed\":true}"))))
    (def result (closed-admit (.get sample contract) (.get sample candidate) context))
    (refuses (.get result outcome) "configuration source changed")
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "post-MOP cache-exit observer writes and removes itself before return checks: retained limitation"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def sample (probe (list path)))
    (def dependency (.get sample external))
    (def fired 0)
    (def attack
      (lambda (key _amount)
        (when (and (eq? (current-module-source-phase) 'slot-replay)
                   (eq? key 'check-seconds))
          (set! fired (+ fired 1))
          (.putslot! dependency 'port ($constant-slot-spec 5433))
          (current-module-source-observer #f))))
    (def result (closed-admit (.get sample contract) (.get sample candidate) #f attack))
    (check-equal? (.get result outcome accepted?) #t)
    (check-equal? fired 1)
    (check-equal? (.get dependency port) 5433)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "caller wrapper can be replaced by an earlier context callback: retained limitation"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def sample (probe (list path)))
    (def dependency (.get sample external))
    (def fired 0)
    (def attack
      (on-file path (lambda ()
                      (set! fired (+ fired 1))
                      (.putslot! dependency 'port ($constant-slot-spec 5433)))))
    (def context (.o admit-current: (lambda () (current-module-source-observer attack))))
    (def result (closed-admit (.get sample contract) (.get sample candidate) context))
    (check-equal? (.get result outcome accepted?) #t)
    (check-equal? fired 1)
    (check-equal? (.get dependency port) 5433)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "real service obligations and parent cache survive; late normalized candidate write never runs"
    (fixture ServicesFixture)
    (def publication (.get fixture publication))
    (def Contract (.get publication contract))
    (def Context (.get publication context))
    (def keys (map (lambda (entry) (.get entry origin key)) (.get Context contributions)))
    (check-equal? (length keys) 2)
    (check-equal? (and (memq 'postgresql-port keys) (memq 'gitea-port keys) #t) #t)
    (def Parent (.get publication value))
    (def cached (.get Parent plan))
    (.def (Release @ Parent)
      config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (def analyzed #f)
    (def analyze (.get Context .contract-obligations))
    (def Observed
      (.cc Context .contract-obligations:
        (lambda (actual candidate)
          (def issues (analyze actual candidate))
          (when (eq? actual Contract) (set! analyzed candidate))
          issues)))
    (for-each
      (lambda (_mode)
        (def evidence (.get (closed-admit Contract Release Observed) outcome))
        (check-equal? (.get evidence accepted?) #t)
        (check-equal? (.get analyzed config postgresql settings port) 5433)
        (check-equal? (.get analyzed plan postgresql port) 5433)
        (check-equal? (.get analyzed plan gitea database-port) 5433)
        (check-equal? (eq? (.get analyzed config) (.get analyzed plan configuration)) #t)
        (def child-config (car (.get evidence responsibility-evidence)))
        (check-equal? (eq? (.get child-config candidate) (.get analyzed config)) #t)
        (check-equal? (length (.get child-config responsibility-evidence)) 2))
      '(cold warm))
    (def called 0)
    (def result
      (closed-admit Contract Release Observed
        (lambda (key _amount)
          (when (and (eq? (current-module-source-phase) 'return-currentness)
                     (pair? key) (eq? (car key) 'file-read))
            (set! called (+ called 1))
            (.putslot! (.get analyzed config postgresql settings)
                       'port ($constant-slot-spec 5440))))))
    (refuses (.get result outcome) "opaque source observer in return tail")
    (check-equal? called 0)
    (check-equal? (.get analyzed config postgresql settings port) 5433)
    (check-equal? (.get analyzed plan postgresql port) 5433)
    (check-equal? (.get cached postgresql port) 5432)
    (check-equal? (eq? cached (.get Parent plan)) #t)
    (check-equal? (length (.get Context contributions)) 2)
    (set! completed (+ completed 1)))))

(import :std/test :clan/poo/object
        (only-in :std/source this-source-file)
        (only-in :std/io/tempfile make-temporary-file-name clear-temporary-file!)
        (only-in "../init.ss" yuanxu.init.exports )
        (rename-in (only-in "../init.ss" yuanxu.init.exports) (yuanxu.init.exports ModuleNamespace))
        (only-in :yuanxu/module-system/interface yuanxu-load-modules)
        (only-in :yuanxu/module-system/building/test-projection module-test-projection module-test-file-source)
        (only-in :yuanxu/object-types/contracts yuanxu-predicate-contract)
        (only-in :yuanxu/module-system/source/admission module-source-read)
        (only-in :yuanxu/observability/testing-fixture
                 with-yuanxu-fixture yuanxu-test-fixture)
        (only-in :yuanxu/ops/objects ProcessScript.))
(export module-testing-test)
(def root (path-expand ".." (path-directory (this-source-file))))
(.def Workspace
  .acquire: (lambda () (let (directory (make-temporary-file-name "module-testing-"))
                         (create-directory directory) directory))
  .release: clear-temporary-file!)
(def (write-forms path forms)
  (call-with-output-file (list path: path truncate: #t)
    (lambda (port) (for-each (cut pretty-print <> port) forms))))
(def FixtureContract
  (yuanxu-predicate-contract 'test/fixture-scope object? (lambda (_v _c) '())))
;; This fixture supplies an inert publication, not a qualified domain scope.
;; Real JsonSchema and Funflow are selected and executed by Core init above.
(def (fixture-reader source)
  (when (string-contains (.get source value) "/poison/")
    (error "unselected publication reader called"))
  (.o identity: 'json-schema features: (.o)
      core: (.o requires: (.o) scope-contract: FixtureContract link: (lambda (_deps) (.o)))))
(def (test-session source)
  (module-test-projection (yuanxu-load-modules source read-publication: fixture-reader)))
(def module-testing-test
  (test-suite "Selected module atomic testing"
    (test-case "importing the init source does not acquire a Graph or enumerate tests"
      (check-equal? (.slot? (.get yuanxu.init.exports tests) '.run) #t)
      (check-equal? (.ref/cached (.get yuanxu.init.exports tests) 'command) #f)
      (check-equal? (.ref/cached (.get yuanxu.init.exports tests) 'spec) #f)
      (check-equal? (.ref/cached (.get yuanxu.init.exports tests) 'selected-graph) #f))
    (test-case "namespace reflection returns real keys without demanding leaf values"
      (def scenarios (.get yuanxu.init.exports Scenarios))
      (check-equal? (.all-slots/sort scenarios) '(applications services))
      (check-equal? (.all-slots/sort (.get scenarios services)) '(gitea postgresql))
      (check-equal? (.all-slots/sort (.get scenarios applications)) '(gitea-postgresql))
      (check-equal? (.ref/cached (.get scenarios applications) 'gitea-postgresql) #f)
      (check-equal? (.ref/cached (.get scenarios services) 'postgresql) #f)
      (def modules (.get yuanxu.init.exports Modules))
      (check-equal? (eq? modules (.get yuanxu.init.exports Modules)) #t)
      (check-equal? (eq? modules (.get ModuleNamespace Modules)) #t)
      (check-equal? (let ((init-modules-getter 'caller-binding))
                      (eq? modules (.get ModuleNamespace Modules))) #t)
      (check-equal? (.all-slots/sort modules) '(funflow json-schema))
      (check-equal? (.slot? modules 'json-schema) #t)
      (check-equal? (.slot? modules 'missing) #f)
      (check-equal? (.slot? modules '.fallback-handler) #f)
      (check-equal? (.ref/cached modules 'json-schema) #f)
      (check-equal? (.ref/cached modules 'funflow) #f)
      (check-equal? (.ref/cached (.get yuanxu.init.exports tests) 'spec) #f)
      (check-equal? (.ref/cached (.get yuanxu.init.exports tests) 'selected-graph) #f)
      (def module (.get modules json-schema))
      (check-equal? (.all-slots/sort module) '(identity scope tests))
      (check-equal? (.slot? module 'tests) #t)
      (check-equal? (.slot? module 'missing) #f)
      (check-equal? (.ref/cached module 'scope) #f)
      (check-equal? (.ref/cached module 'tests) #f))
    (test-case "init exports inert test files selected from its existing Graph"
      (def json (.get (.call (.get yuanxu.init.exports tests) .select '(json-schema)) spec))
      (def flow (.get (.call (.get yuanxu.init.exports tests) .select '(funflow)) spec))
      (check-equal? (map path-strip-directory json) '("atomic-test.ss"))
      (check-equal? (map path-strip-directory flow) '("atomic-test.ss"))
      (check-equal? (.get (.call (.get yuanxu.init.exports tests) .select '()) spec) '())
      ;; Empty selection must never become gxtest's implicit directory scan.
      (check-exception (.call (.call (.get yuanxu.init.exports tests) .select '()) .run) error?)
      (check-exception (.get (.call (.get yuanxu.init.exports tests) .select '(unselected)) spec) error?)
      (def scenarios
        (.get (.call (.get yuanxu.init.exports tests) .select
                '(services/postgresql services/gitea applications/gitea-postgresql)) spec))
      (check-equal? (map path-strip-directory scenarios) '("config-test.ss"))
      (check-equal? (.get yuanxu.init.exports tests spec) (append json flow scenarios))
      (check-equal? (eq? json (.get (.call (.get yuanxu.init.exports tests) .select '(json-schema)) spec)) #t)
      (def selected (.call (.get yuanxu.init.exports tests) .select '(json-schema)))
      (check-equal? (.slot? selected '.run) #t)
      (check-equal? (eq? selected (.call (.get yuanxu.init.exports tests) .select '(json-schema))) #t)
      (check-equal? (eq? (.get selected selected-graph) (.get yuanxu.init.exports tests selected-graph)) #t)
      (check-equal? (eq? (.get selected admit-current) (.get selected source admit-current)) #t)
      (def module (.get yuanxu.init.exports Modules json-schema))
      (check-equal? (eq? module (.get yuanxu.init.exports Modules json-schema)) #t)
      (check-equal? (eq? selected (.get module tests)) #t)
      (check-equal? (.ref/cached module 'scope) #f)
      (check-equal? (eq? (.get yuanxu.init.exports tests spec) (.get yuanxu.init.exports tests spec)) #t)
      ((.get yuanxu.init.exports tests admit-current)))
    (test-case "build and testing reuse one source epoch without building test files"
      (def files (.get yuanxu.init.exports tests spec))
      (def spec ((.get yuanxu.init.exports std-make-spec) '()))
      (check-equal? (eq? spec ((.get yuanxu.init.exports std-make-spec) '())) #t)
      (check-equal? (and (member "modules/json-schema/interface" (map cadr spec)) #t) #t)
      (check-equal? (and (member "modules/funflow/interface" (map cadr spec)) #t) #t)
      (check-equal? (and (member "scenarios/gitea-postgresql/interface" (map cadr spec)) #t) #t)
      (check-equal? (ormap (lambda (entry) (string-contains (cadr entry) "/tests/")) spec) #f)
      (check-equal? (eq? files (.get yuanxu.init.exports tests spec)) #t)
      ((.get yuanxu.init.exports admit-current))
      ((.get yuanxu.init.exports tests admit-current)))
    (test-case "hygienic fixtures isolate resources and clean after exceptions"
      (def paths '())
      ;; Deliberately collide with names used in the expansion/implementation.
      (def procedure 'caller-procedure)
      (def resource 'caller-resource)
      (def fixture 'caller-fixture)
      (do ((index 0 (+ index 1))) ((= index 2))
        (check-exception
          (with-yuanxu-fixture (workspace Workspace)
            (set! paths (cons workspace paths))
            (.call (.cc ProcessScript. command: '("touch" "marker") directory: workspace) .run)
            (check-equal? (file-exists? (path-expand "marker" workspace)) #t)
            (error "deliberate fixture body failure")) error?))
      (check-equal? (equal? (car paths) (cadr paths)) #f)
      (check-equal? (ormap file-exists? paths) #f)
      (check-equal? (list procedure resource fixture) '(caller-procedure caller-resource caller-fixture)))
    (yuanxu-test-fixture "explicit qualification files bind their own currentness" (workspace Workspace)
      (def file (path-expand "source-test.ss" workspace))
      (write-forms file '((import :std/test)))
      (def source (module-test-file-source (list file)))
      (check-equal? (.get source spec) (list file))
      ((.get source admit-current))
      (write-forms file '((import :std/test) (export changed)))
      (check-exception ((.get source admit-current)) error?))
    (yuanxu-test-fixture "package admission effects never share the following source window"
      (workspace Workspace)
      (def module-root (path-expand "modules/json-schema" workspace))
      (create-directory* (path-expand "tests" module-root))
      (for-each (lambda (name) (write-forms (path-expand name module-root) '((def Config #t))))
                '("types.ss" "objects.ss" "config.ss"))
      (write-forms (path-expand "interface.ss" module-root)
                   '((.def Published identity: 'json-schema)))
      (def file (path-expand "tests/atomic-test.ss" module-root))
      (write-forms file '((import :std/test)))
      (def init (path-expand "init.ss" workspace))
      (write-forms init '((yuanxu! mode: explicit source: "./modules" (json-schema))))
      (def view (yuanxu-load-modules init read-publication: fixture-reader))
      ;; A bounded package-effect probe over the actual selection/Graph. Reading
      ;; before the write would hide this change under an incorrectly wide cache.
      (.def (Effectful @ view)
        package-current: void
        admit-current: (lambda ()
                         (module-source-read file)
                         (write-forms file '((import :std/test) (export changed)))))
      (check-exception (module-test-projection Effectful) error?))
    (yuanxu-test-fixture "unselected broken publication and test remain unloaded; edits invalidate selected tests"
      (workspace Workspace)
      (def modules (path-expand "modules" workspace))
      (create-directory modules)
      (def poison (path-expand "poison" modules))
      (create-directory poison)
      (for-each (lambda (name) (write-forms (path-expand name poison) '((error "unselected publication loaded"))))
                '("types.ss" "objects.ss" "config.ss" "interface.ss"))
      (create-directory (path-expand "tests" poison))
      (write-forms (path-expand "tests/atomic-test.ss" poison) '((error "unselected test loaded")))
      ;; The real JsonSchema module is selected by its admitted source mapping.
      (def declaration
        `(yuanxu! mode: explicit source: "./modules"
                    (json-schema @ ,(path-expand "modules/json-schema" root)) (poison disable: #t)))
      (def init (path-expand "init.ss" workspace))
      (write-forms init (list declaration))
      (def view (yuanxu-load-modules init read-publication: fixture-reader))
      (def session (module-test-projection view))
      (check-equal? (.get session spec) (.get (.call (.get yuanxu.init.exports tests) .select '(json-schema)) spec))
      (check-exception (module-test-projection view '(poison)) error?)
      ((.get session admit-current))
      ;; A disabled owner is not silently accepted when explicitly selected.
      (def changed `(yuanxu! mode: explicit source: "./modules" (poison)))
      (write-forms init (list changed))
      (check-exception ((.get session admit-current)) error?)
      (check-exception (test-session init) error?))
    (test-case "Ops executes selected native std/test modules without another runner"
      (.call (.get yuanxu.init.exports tests) .run))
    (yuanxu-test-fixture "selected test edits and additions invalidate a real source session" (workspace Workspace)
      (write-forms (path-expand "gerbil.pkg" workspace)
                   '((package: module-test-fixture prelude: :yuanxu/module-system/source/module-prelude)))
      (def module-root (path-expand "modules/json-schema" workspace))
      (create-directory* module-root)
      (def original (path-expand "modules/json-schema" root))
      (for-each (lambda (name)
                  (when (string-suffix? ".ss" name)
                    (copy-file (path-expand name original) (path-expand name module-root))))
                (directory-files original))
      (create-directory (path-expand "tests" module-root))
      (def suite (path-expand "tests/atomic-test.ss" module-root))
      (write-forms suite '((error "discovery must not evaluate a test body")))
      (def integration (path-expand "tests/integration/external-test.ss" module-root))
      (create-directory (path-directory integration))
      (write-forms integration '((error "unselected integration must not evaluate")))
      (def init (path-expand "init.ss" workspace))
      (def declaration '(yuanxu! mode: explicit source: "./modules" (json-schema)))
      (write-forms init (list declaration))
      (def view (yuanxu-load-modules init read-publication: fixture-reader))
      (def session (module-test-projection view))
      (check-equal? (.get session spec) (list (path-normalize suite)))
      (def external (module-test-projection view #f 'integration))
      (check-equal? (.get external spec) (list (path-normalize integration)))
      (check-equal? (eq? (.get session selected-graph) (.get external selected-graph)) #t)
      (write-forms integration '((error "changed selected integration")))
      ((.get session admit-current))
      (check-exception ((.get external admit-current)) error?)
      (write-forms suite '((error "changed selected test")))
      (check-exception ((.get session admit-current)) error?)
      (def next (test-session init))
      (check-equal? (.get next spec) (list (path-normalize suite)))
      (write-forms (path-expand "tests/second-test.ss" module-root) '((error "new selected test")))
      (check-exception ((.get next admit-current)) error?))))

;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Work counts and matched cold/warm costs; no timing acceptance threshold.
(import :std/test :std/iter :clan/poo/object
        (only-in :clan/poo/mop call-with-slot-read-observer replay-slot-reads!
                 slot-read-dependencies)
        (only-in :clan/poo/t/closure-measure measure)
        (only-in :std/error Error? Error-message)
        (only-in :yuanxu/object-types/contracts yuanxu-classification-evidence)
        (only-in :yuanxu/admission/source SourceAdmissionContract.)
        (only-in :yuanxu/module-system/source/admission current-module-source-observer)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/t/qualification/service-publication/fixtures
                 ServicesFixture write-source))
(export slot-read-cost-test test-cleanup!)

(def completed 0)
(def (test-cleanup!)
  (unless (= completed 3) (error "incomplete slot cost controls" completed))
  (displayln "SLOT-READ-COST: 3 cases completed"))
(def (report row) (write row) (newline))
(def (counted-obligations previous calls)
  (lambda (candidate context)
    (set-box! calls (+ 1 (unbox calls)))
    (previous candidate context)))
(def (contextual-contract base calls)
  ;; The real publication first normalizes/admit its candidate. A contextual
  ;; fixture must retain that exact child, not normalize/replace it a second time.
  (def preflight (.get base .preflight))
  (.def (Database @ (.get base database-contract))
    (.obligations => counted-obligations calls))
  (.cc base value-contract: #f .preflight: preflight database-contract: Database))

;; Depth is a fixture parameter, not a new public Scenario/container protocol.
(.def (EnvelopeContract @ SourceAdmissionContract.)
  identity: 'test/cost-envelope
  .classify:
  (lambda (candidate context)
    (yuanxu-classification-evidence identity candidate #t '() context)))

(def (check-plan receipt)
  (check-equal? (.get receipt accepted?) #t)
  (def final (.get receipt candidate))
  (check-equal? (.get final plan postgresql port) 5433)
  (check-equal? (.get final plan gitea database-port) 5433)
  (check-equal? (eq? (.get final config) (.get final plan configuration)) #t))
(def (check-envelope receipt depth)
  (check-equal? (.get receipt accepted?) #t)
  (if (zero? depth) (check-plan receipt)
    (check-envelope (car (.get receipt responsibility-evidence)) (- depth 1))))
(def (sample-admission phase action (verify check-plan))
  (for (round (in-range 3))
    (defvalues (receipt costs) (measure action 3))
    (verify receipt)
    (report (list 'ADMISSION-COST phase round 3 costs))))

;; Independent graph-size oracle only; native replay remains the only validator.
(def (graph-size roots)
  (def seen (make-hash-table-eq))
  (let loop ((pending roots) (edges 0))
    (cond
      ((null? pending) (values (hash-length seen) edges))
      ((hash-key? seen (car pending)) (loop (cdr pending) edges))
      (else
       (def dependencies (slot-read-dependencies (car pending)))
       (hash-put! seen (car pending) #t)
       (loop (append dependencies (cdr pending)) (+ edges (length dependencies)))))))
(def (trace-work phase action (sample-replay? #f))
  (def roots (make-hash-table-eq))
  (def io (make-hash-table))
  (def events 0)
  (def (observe read)
    (set! events (+ events 1))
    (hash-put! roots read #t))
  (def result
    (parameterize ((current-module-source-observer
                    (lambda (key amount)
                      (hash-put! io key (+ amount (hash-ref io key 0))))))
      (call-with-slot-read-observer observe action)))
  (def roots-list (hash-keys roots))
  (defvalues (nodes edges) (graph-size roots-list))
  (def callbacks 0)
  (replay-slot-reads! roots-list
    (lambda (_receiver _key) (set! callbacks (+ callbacks 1))))
  (check-equal? callbacks nodes)
  (report (list 'READ-WORK phase events (hash-length roots) nodes edges callbacks
                (hash-ref io 'read-requests 0) (hash-ref io 'reads 0)
                (hash-ref io 'checks 0)))
  (def phases (make-hash-table))
  (for-each
    (lambda (key)
      (when (and (pair? key) (eq? (car key) 'file-read))
        (let ((phase-name (cadr key)) (count (hash-ref io key)))
          (hash-put! phases phase-name (+ count (hash-ref phases phase-name 0)))
          (report (list 'SOURCE-FILE phase phase-name (caddr key) count)))))
    (hash-keys io))
  (for-each (lambda (key) (report (list 'SOURCE-PHASE phase key (hash-ref phases key))))
            (hash-keys phases))
  (when sample-replay?
    ;; Validate the same stable graph; this callback has no source I/O. Real
    ;; source-currentness remains in the separately measured admission path.
    (for (round (in-range 3))
      (defvalues (replayed costs)
        (measure (lambda ()
                   (replay-slot-reads! roots-list (lambda (_receiver _key) (void)))
                   result) 200))
      (check-equal? replayed result)
      (report (list 'REPLAY-COST phase round 200 costs))))
  result)

(def slot-read-cost-test
  (test-suite "Real Scenario read/replay costs"
    (yuanxu-test-fixture "maintained contracts cold warm and nested admission"
      (fixture ServicesFixture)
      (def publication (.get fixture publication))
      (def Contract (.get publication contract))
      (def context (.get publication context))
      (def Parent (.get publication value))
      (def cached (.get Parent plan))
      (check-equal? (.get cached postgresql port) 5432)
      (def (child)
        (.o (:: @ Parent)
          config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433)))))
      (def (admit value) (.call Contract .admit value context))
      (def Warm (child))
      (check-plan (admit Warm))
      ;; Counter passes are outside the uninstrumented timing windows.
      (check-plan (trace-work 'cold (cut admit (child))))
      (check-plan (trace-work 'warm (cut admit Warm)))
      (sample-admission 'cold (cut admit (child)))
      (sample-admission 'warm (cut admit Warm))
      (def Final (.get (admit Warm) candidate))
      (def calls (box 0))
      (def Contextual (contextual-contract Contract calls))
      (def unused-calls 0)
      (def Wrapped (.o selected: Final
                       unused: (begin (set! unused-calls (+ unused-calls 1)) (error "unselected"))))
      (.def (Outer @ EnvelopeContract) responsibilities: (.o selected: Contextual))
      (let* ((before (unbox calls))
             (nested (trace-work 'nested (cut .call Outer .admit Wrapped #f))))
        (check-equal? (.get nested accepted?) #t)
        (check-plan (car (.get nested responsibility-evidence)))
        (check-equal? (unbox calls) (+ before 1)))
      (sample-admission 'nested (cut .call Outer .admit Wrapped #f)
                        (cut check-envelope <> 1))
      (.def (Outer2 @ EnvelopeContract) responsibilities: (.o selected: Outer))
      (def Wrapped2 (.o selected: Wrapped))
      ;; Keep the before/after pair in an explicit temporal scope after sampling.
      (let (before2 (unbox calls))
        (check-envelope (trace-work 'nested2 (cut .call Outer2 .admit Wrapped2 #f)) 2)
        (check-equal? (unbox calls) (+ before2 1)))
      (sample-admission 'nested2 (cut .call Outer2 .admit Wrapped2 #f)
                        (cut check-envelope <> 2))
      (check-equal? unused-calls 0)
      (check-equal? (.get cached postgresql port) 5432)
      (.def (Frozen @ Warm) plan: cached)
      (def rejected (admit Frozen))
      (check-equal? (.get rejected accepted?) #f)
      (check-equal? (.get (car (.get rejected diagnostics)) kind) 'stale-parent-plan)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "shared endpoint dependencies replay once per token"
      (fixture ServicesFixture)
      (def publication (.get fixture publication))
      (def Parent (.get publication value))
      (def endpoint (.get Parent plan postgresql))
      (for (width '(1 8 64 512))
        (def (new-probe)
          (.o value: (for/fold (last #f) (_ (in-range width))
                         (.get endpoint port))))
        (def probe (new-probe))
        ;; Warm outside every observer, just like a cached upstream Profile.
        (check-equal? (.get probe value) 5432)
        (check-equal? (trace-work (list 'shared width) (cut .get probe value) #t) 5432)
        (for (round (in-range 3))
          (defvalues (value costs) (measure (lambda () (.get (new-probe) value)) 20))
          (check-equal? value 5432)
          (report (list 'DEPENDENCY-COST width round 20 costs))))
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "nested final currentness refuses a post-child source change"
      (fixture ServicesFixture)
      (def publication (.get fixture publication))
      (def Parent (.get publication value))
      (def cached (.get Parent plan))
      (def Final (.get (.call (.get publication contract) .admit Parent
                        (.get publication context)) candidate))
      (def calls (box 0))
      (def Contextual (contextual-contract (.get publication contract) calls))
      (def path (path-expand "modules/services/postgresql/postgresql.json" (.get fixture root)))
      (.def (Outer @ EnvelopeContract)
        responsibilities: (.o selected: Contextual)
        .obligations: (lambda (_candidate _context) (write-source path "{}") '()))
      (def before (unbox calls))
      (def cause (with-catch values
        (cut .call Outer .admit (.o selected: Final) #f)))
      (check-equal? (Error? cause) #t)
      (check-equal? (Error-message cause) "configuration source changed")
      (check-equal? (unbox calls) (+ before 1))
      (check-equal? (.get cached postgresql port) 5432)
      (set! completed (+ completed 1)))))

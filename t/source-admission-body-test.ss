;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Real SourceAdmissionContract; no recorded/replay replacement around admission.
(import :std/test :clan/poo/object
        (only-in :std/error Error? Error-message)
        (only-in :yuanxu/object-types/contracts YuanxuContract. yuanxu-classification-evidence)
        (only-in :yuanxu/admission/source SourceAdmissionContract.)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/t/qualification/service-publication/fixtures
                 ServicesFixture DirectoryFixture write-source))
(export source-admission-body-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (check-equal? completed 6)
  (displayln "SOURCE-ADMISSION-BODY: 6 cases completed"))
;; Only data, classification and hostile obligation callbacks are test-owned.
;; Root admission/child delegation/source collection/replay are production code.
(def (admission-probe child-prototype)
  (def observed-calls (vector 0 0))
  (def obligation-effect (box (lambda (_contract candidate _context) (.get candidate port) '())))
  (.def (Child @ child-prototype)
    identity: 'test/body-child
    marker: 0
    .classify: (lambda (candidate context)
                 (yuanxu-classification-evidence identity candidate #t '() context))
    .obligations: (lambda (candidate context)
                    (vector-set! observed-calls 1 (+ 1 (vector-ref observed-calls 1)))
                    ((unbox obligation-effect) Child candidate context)))
  (.def (Root @ SourceAdmissionContract.)
    identity: 'test/body-root
    responsibilities: (.o child: Child)
    .classify: (lambda (candidate context)
                 (yuanxu-classification-evidence identity candidate #t '() context))
    .obligations: (lambda (_candidate _context)
                    (vector-set! observed-calls 0 (+ 1 (vector-ref observed-calls 0))) '()))
  (.o contract: Root child-contract: Child calls: observed-calls effect: obligation-effect
      candidate: (.o child: (.o port: 5432) unused: (error "unselected branch forced"))))
(def (reject-admission contract candidate context message)
  (def returned? #f)
  (def failure
    (with-catch values
      (lambda ()
        (def evidence (.call contract .admit candidate context))
        (set! returned? #t) evidence)))
  (check-equal? returned? #f)
  (check-equal? (Error? failure) #t)
  (check-equal? (Error-message failure) message))
(def (warm! probe)
  (check-equal? (.get (.call (.get probe contract) .admit (.get probe candidate) #f) accepted?) #t))
(def source-admission-body-test
 (test-suite "Actual source admission observes nested function bodies"
  (yuanxu-test-case "hot root and child admission run their bodies again without replacing child evidence"
    (def probe (admission-probe YuanxuContract.))
    (def Contract (.get probe contract))
    (def Child (.get probe child-contract))
    (def candidate (.get probe candidate))
    (warm! probe)
    (def function (.get Contract .admit))
    (def child-function (.get Child .admit))
    (def evidence (.call Contract .admit candidate #f))
    (check-equal? (.get evidence accepted?) #t)
    (check-equal? (eq? function (.get Contract .admit)) #t)
    (check-equal? (eq? child-function (.get Child .admit)) #t)
    (check-equal? (vector->list (.get probe calls)) '(2 2))
    (def receipt (car (.get evidence responsibility-evidence)))
    (check-equal? (eq? (.get receipt candidate) (.get candidate child)) #t)
    (check-equal? (eq? (.get receipt admission-contract) Child) #t)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "nested ordinary child obligation edits its Contract receiver; root rejects before returning"
    (def probe (admission-probe YuanxuContract.))
    (warm! probe)
    (def applied? #f)
    (def Child (.get probe child-contract))
    (def before (object-revision Child))
    (set-box! (.get probe effect)
      (lambda (actual _candidate _context)
        (.get actual marker)
        (.putslot! actual 'marker ($constant-slot-spec 1))
        (set! applied? #t) '()))
    (reject-admission (.get probe contract) (.get probe candidate) #f "stale slot dependency")
    (check-equal? applied? #t)
    (check-equal? (.get Child marker) 1)
    (check-equal? (object-revision Child) (+ before 1))
    (check-equal? (vector->list (.get probe calls)) '(2 2))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "nested obligation edits an observed candidate; root rejects stale values"
    (def probe (admission-probe YuanxuContract.))
    (warm! probe)
    (set-box! (.get probe effect)
      (lambda (_actual candidate _context)
        (.get candidate port)
        (.putslot! candidate 'port ($constant-slot-spec 5433)) '()))
    (reject-admission (.get probe contract) (.get probe candidate) #f "stale slot dependency")
    (check-equal? (.get probe candidate child port) 5433)
    (check-equal? (vector->list (.get probe calls)) '(2 2))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "external reads inside ordinary and source-aware child obligations reach real replay"
    (for-each
      (lambda (prototype)
        (def probe (admission-probe prototype))
        (.def External port: 5432)
        (warm! probe)
        (def before (object-revision (.get probe contract)))
        (set-box! (.get probe effect)
          (lambda (_actual _candidate _context)
            (.get External port)
            (.putslot! External 'port ($constant-slot-spec 5433)) '()))
        (reject-admission (.get probe contract) (.get probe candidate) #f "stale slot dependency")
        (check-equal? (.get External port) 5433)
        (check-equal? (object-revision (.get probe contract)) before)
        ;; A source-aware child rejects in its own wrapper; the ordinary child
        ;; returns to Root and only Root's production replay can reject.
        (check-equal? (vector->list (.get probe calls))
          (if (eq? prototype YuanxuContract.) '(2 2) '(1 2))))
      (list YuanxuContract. SourceAdmissionContract.))
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "source error remains first when a nested obligation also invalidates an external read"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def probe (admission-probe YuanxuContract.))
    (def Contract (.cc (.get probe contract) source-inputs: (list (cons path "{}"))))
    (.def External port: 5432)
    (check-equal? (.get (.call Contract .admit (.get probe candidate) #f) accepted?) #t)
    (set-box! (.get probe effect)
      (lambda (_actual _candidate _context)
        (.get External port)
        (.putslot! External 'port ($constant-slot-spec 5433))
        (write-source path "{\"changed\":true}") '()))
    (reject-admission Contract (.get probe candidate) #f "configuration source changed")
    (check-equal? (.get External port) 5433)
    (check-equal? (vector->list (.get probe calls)) '(2 2))
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "real hot service admission preserves two requirements and parent cache while rejecting a nested external effect"
    (fixture ServicesFixture)
    (def publication (.get fixture publication))
    (def Contract (.get publication contract))
    (def Context (.get publication context))
    (def Parent (.get publication value))
    (def cached (.get Parent plan))
    (check-equal? (length (.get Context contributions)) 2)
    (.def (Release @ Parent)
      config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (.def External port: 5432)
    (def armed? #f)
    (def applied? #f)
    (def analyze (.get Context .responsibility-obligations))
    (def Observed
      (.cc Context .responsibility-obligations:
        (lambda (actual candidate)
          (def issues (analyze actual candidate))
          (when (and armed? (not applied?))
            (check-equal? (eq? actual Contract) #f)
            (.get External port)
            (.putslot! External 'port ($constant-slot-spec 5433))
            (set! applied? #t))
          issues)))
    (def evidence (.call Contract .admit Release Observed))
    (check-equal? (.get evidence accepted?) #t)
    (check-equal? (.get evidence candidate plan gitea database-port) 5433)
    (def function (.get Contract .admit))
    (set! armed? #t)
    (reject-admission Contract Release Observed "stale slot dependency")
    (check-equal? applied? #t)
    (check-equal? (eq? function (.get Contract .admit)) #t)
    (check-equal? (.get cached postgresql port) 5432)
    (check-equal? (eq? cached (.get Parent plan)) #t)
    ;; Failed collection must not poison a subsequent independent admission.
    (def fresh (.call Contract .admit Release Context))
    (check-equal? (.get fresh accepted?) #t)
    (check-equal? (.get fresh candidate plan gitea database-port) 5433)
    (check-equal? (length (.get Context contributions)) 2)
    (set! completed (+ completed 1)))))

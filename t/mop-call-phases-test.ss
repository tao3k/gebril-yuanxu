;;; Actual .call expansion; observe frames without installing or masking them.
(import :std/test :clan/poo/object
        (only-in :clan/poo/mop call-with-slot-read-observer replay-slot-reads!
                 slot-read-receiver)
        (only-in :std/error Error? Error-message)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case))
(export mop-call-phases-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (check-equal? completed 6)
  (displayln "MOP-CALL-PHASES: 6 cases completed"))
(def (recorded action)
  (def roots '())
  (call-with-slot-read-observer (lambda (read) (set! roots (cons read roots))) action)
  (reverse roots))
(def (refuses message action)
  (def failure (with-catch values action))
  (check-equal? (Error? failure) #t)
  (check-equal? (Error-message failure) message))
(def (has-frame? frames receiver slot)
  (and (find (lambda (entry) (and (eq? (car entry) receiver) (eq? (cdr entry) slot))) frames) #t))
(def (has-receiver? frames receiver) (and (assq receiver frames) #t))
(def mop-call-phases-test
 (test-suite "Function lookup frames and .call bodies"
  (yuanxu-test-case "cold acquisition has a method frame; warm calls reuse the function but execute its body"
    (def acquired 0)
    (def invoked 0)
    (def lookup-frames '())
    (def body-frames '())
    (.def Root
      port: 5432
      operation: (begin
                   (set! acquired (+ acquired 1))
                   (set! lookup-frames (active-slot-computations))
                   (lambda ()
                     (set! invoked (+ invoked 1))
                     (set! body-frames (active-slot-computations))
                     (.get Root port)))
      unused: (error "unselected branch forced"))
    (def previous (active-slot-computations))
    (check-equal? (.call Root operation) 5432)
    (check-equal? (has-frame? lookup-frames Root 'operation) #t)
    (check-equal? (has-receiver? body-frames Root) #f)
    (def function (.get Root operation))
    (check-equal? (.call Root operation) 5432)
    (check-equal? (eq? function (.get Root operation)) #t)
    (check-equal? acquired 1)
    (check-equal? invoked 2)
    (check-equal? (has-receiver? body-frames Root) #f)
    (check-equal? (eq? (active-slot-computations) previous) #t)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "top-level function body can edit receiver; enclosing read replay refuses"
    (def body-frames '())
    (def returned #f)
    (.def Root
      port: 5432
      operation: (lambda ()
                   (set! body-frames (active-slot-computations))
                   (let (port (.get Root port))
                     (.putslot! Root 'port ($constant-slot-spec 5433)) port)))
    (def before (object-revision Root))
    (def roots (recorded (lambda () (set! returned (.call Root operation)))))
    (check-equal? (has-receiver? body-frames Root) #f)
    (check-equal? returned 5432)
    (check-equal? (.get Root port) 5433)
    (check-equal? (object-revision Root) (+ before 1))
    (refuses "stale slot dependency"
      (cut replay-slot-reads! roots (lambda (_receiver _key) (void))))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "warm function body edits an independent demand; whole-call observation records it"
    (.def Database port: 5432)
    (def body-frames '())
    (.def Root operation: (lambda ()
                           (set! body-frames (active-slot-computations))
                           (let (port (.get Database port))
                             (.putslot! Database 'port ($constant-slot-spec 5433)) port)))
    (.get Root operation)
    (def before (object-revision Root))
    (def roots (recorded (cut .call Root operation)))
    (check-equal? (has-receiver? body-frames Root) #f)
    (check-equal? (has-receiver? body-frames Database) #f)
    (check-equal? (object-revision Root) before)
    (check-equal? (and (find (lambda (read) (eq? (slot-read-receiver read) Database)) roots) #t) #t)
    (check-equal? (.get Database port) 5433)
    (refuses "stale slot dependency"
      (cut replay-slot-reads! roots (lambda (_receiver _key) (void))))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "nested .call inherits caller frame; receiver mutation is rejected and frames unwind"
    (def body-frames '())
    (.def Root
      port: 5432
      operation: (lambda ()
                   (set! body-frames (active-slot-computations))
                   (.putslot! Root 'port ($constant-slot-spec 5433)))
      preview: (.call Root operation))
    (def before (object-revision Root))
    (def previous (active-slot-computations))
    (refuses "object mutation during computation" (cut .get Root preview))
    (check-equal? (has-frame? body-frames Root 'preview) #t)
    (check-equal? (has-frame? body-frames Root 'operation) #f)
    (check-equal? (object-revision Root) before)
    (check-equal? (.get Root port) 5432)
    (check-equal? (eq? (active-slot-computations) previous) #t)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "nested call preserves caller protection but permits independent dependency edits"
    (.def Database port: 5432)
    (def body-frames '())
    (.def Root
      operation: (lambda ()
                   (set! body-frames (active-slot-computations))
                   (let (port (.get Database port))
                     (.putslot! Database 'port ($constant-slot-spec 5433)) port))
      preview: (.call Root operation))
    (def before (object-revision Root))
    (def roots (recorded (cut .get Root preview)))
    (check-equal? (has-frame? body-frames Root 'preview) #t)
    (check-equal? (has-frame? body-frames Root 'operation) #f)
    (check-equal? (has-receiver? body-frames Database) #f)
    (check-equal? (object-revision Root) before)
    (check-equal? (.get Database port) 5433)
    (refuses "stale slot dependency"
      (cut replay-slot-reads! roots (lambda (_receiver _key) (void))))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "observing only function acquisition omits later body reads"
    (.def Database port: 5432)
    (.def Root operation: (lambda ()
                           (let (port (.get Database port))
                             (.putslot! Database 'port ($constant-slot-spec 5433)) port)))
    (def lookup-roots (recorded (cut .get Root operation)))
    (check-equal? (.call Root operation) 5432)
    ;; This intentionally insufficient scope sees no body demand to reject.
    (replay-slot-reads! lookup-roots (lambda (_receiver _key) (void)))
    (check-equal? (find (lambda (read) (eq? (slot-read-receiver read) Database)) lookup-roots) #f)
    (check-equal? (.get Database port) 5433)
    (set! completed (+ completed 1)))))

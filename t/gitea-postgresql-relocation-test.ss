(import :std/test :clan/poo/object
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/configuration/slot-origin field-slot-origins/value)
        (only-in :yuanxu/t/qualification/service-publication/fixtures
               ServicesFixture RelocatedServicesFixture relocate-services
               write-source read-overrides refused)
        (only-in :yuanxu/module-system/source/admission module-source-read))
(export relocation-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (unless (= completed 4) (error "incomplete relocated Scenario controls" completed))
  (displayln "GITEA-RELOCATED-PACKAGE: 4 cases completed"))
(def relocation-test
  (test-suite "Selected Scenario package relocation"
    (yuanxu-test-fixture "observed JSON follows the selected graph and relocated native sources"
      (fixture ServicesFixture)
      (with-slots (root selection) fixture
        (def graph (.get selection build-graph))
        (check-equal? (length (.get graph assets)) 2)
        (check-equal? (list-sort string<? (map (lambda (asset) (path-strip-directory (.get asset path))) (.get graph assets)))
                      '("gitea.json" "postgresql.json"))
        (check-equal? (andmap (lambda (asset) (assoc (.get asset path) (.get graph source-inputs))) (.get graph assets)) #t)
        (def relocated (relocate-services fixture))
        (def receipt (.get relocated package-receipt))
        (def moved (.get relocated source))
        (check-equal? (if (member "modules/services/postgresql/postgresql.json" (.get receipt files)) #t #f) #t)
        (check-equal? (file-exists? (path-expand "modules/services/unused" moved)) #f)
        (check-equal? (file-exists? (path-expand "modules/services/postgresql/unread.json" moved)) #f)
        (check-equal? (file-exists? (path-expand "modules" root)) #f)
        (def fresh (.get relocated selection))
        (check-equal? (.get fresh selected-graph denied-modules) (.get selection selected-graph denied-modules))
        (check-equal? (.get fresh selected-graph feature-order) (.get selection selected-graph feature-order))
        (def publication (.get relocated publication))
        (def parent (.get publication value))
        (def cached (.get parent plan))
        (check-equal? (.get cached postgresql port) 5432)
        (check-equal? (.get cached gitea database-port) 5432)
        (.def (Release @ parent)
          config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
        (defvalues (admission next failure) (.call publication .publish parent Release))
        (check-equal? failure #f)
        (check-equal? (.get admission accepted?) #t)
        (check-equal? (.get next plan gitea database-port) 5433)
        (check-equal? (.get cached postgresql port) 5432)
        (.def (Explicit @ Release)
          config: =>.+ (.o gitea: =>.+ (.o database: =>.+ (.o port: 5440))))
        (def evidence (.call (.get publication contract) .admit Explicit (.get publication context)))
        (def issue (car (.get evidence diagnostics)))
        (check-equal? (.get issue kind) 'connection-mismatch)
        (check-equal? (.get issue actual) 5440)
        (check-equal? (.get issue origin source)
                      (path-normalize (path-expand "modules/services/gitea/gitea.json" moved)))
        (check-equal? (.get issue origin path) '(database port))
        (.def (Frozen @ Release) plan: cached)
        (refused publication parent Frozen)
        (def json (path-expand "modules/services/postgresql/postgresql.json" moved))
        (write-source json (string-append (module-source-read json) "\n"))
        (refused publication parent Release "selected configuration asset changed")
        (set! completed (+ completed 1))))
    (yuanxu-test-fixture "relocated Scheme overrides retain exact source, JSON baseline and derivation"
      (fixture RelocatedServicesFixture)
      (with-slots (root selection publication) fixture
        (def moved (.get fixture source))
        (def parent (.get publication value))
        (def cached (.get parent plan))
        (def file (path-normalize (path-expand "release.ss" moved)))
        (def text
          (string-append
            "(def (release parent)\n"
            "  (.def (Release @ parent)\n"
            "    config.postgresql.settings: =>.+ {port: 5433})\n"
            "  Release)\n"
            "(def (explicit parent)\n"
            "  (.def (Explicit @ parent)\n"
            "    config.gitea.database: =>.+ {port: 5440})\n"
            "  Explicit)\n"))
        (write-source file text)
        (defvalues (release explicit) (read-overrides file))
        (def child (release parent))
        (defvalues (receipt next failure) (.call publication .publish parent child))
        (check-equal? failure #f)
        (check-equal? (.get receipt accepted?) #t)
        (check-equal? (.get next plan gitea database-port) 5433)
        (check-equal? (.get cached gitea database-port) 5432)
        (def bad (explicit child))
        (def evidence (.call (.get publication contract) .admit bad (.get publication context)))
        (def issue (car (.get evidence diagnostics)))
        (check-equal? (.get issue kind) 'connection-mismatch)
        (check-equal? (.get issue actual) 5440)
        (check-equal? (.get issue expected) 5433)
        (check-equal? (.get issue origin source) file)
        (check-equal? (.get issue origin line) 7)
        (check-equal? (.get issue origin column) 34)
        (check-equal? (.get issue expected-origin source) file)
        (check-equal? (.get issue expected-origin line) 3)
        (check-equal? (.get issue expected-origin column) 39)
        (check-equal? (.get issue origin baseline path) '(database port))
        (check-equal? (.get issue origin baseline presence) 'missing)
        (check-equal? (.get issue origin baseline source)
          (path-normalize (path-expand "modules/services/gitea/gitea.json" moved)))
        (def derived (.call (.get publication contract) .admit (explicit bad) (.get publication context)))
        (def inherited-origins (.get (car (.get derived diagnostics)) origin derived-from))
        (check-equal? (length inherited-origins) 1)
        (check-equal? (.get (car inherited-origins) source) file)
        (check-equal? (.get (car inherited-origins) line) 7)
        (.def (Frozen @ child) plan: cached)
        (refused publication parent Frozen)
        (def undemanded (release parent))
        ;; Cached final plans do not exempt the overriding source from checks.
        (write-source file (string-append text "\n"))
        (refused publication parent child "Scheme configuration source changed")
        (refused publication parent undemanded "Scheme configuration source changed")
        (check-exception (.call (.get publication contract) .admit bad (.get publication context)) error?)
        (check-equal? (.get (.call (.get publication contract) .admit parent (.get publication context)) accepted?) #t)
        (check-equal? (.get cached postgresql port) 5432)
        (set! completed (+ completed 1))))
    (yuanxu-test-fixture "native plus, cc and delayed refinement share source checks after parent and child caches"
      (fixture RelocatedServicesFixture)
      (with-slots (root selection publication) fixture
        (def moved (.get fixture source))
        (def parent (.get publication value))
        (def cached (.get parent plan))
        (def file (path-normalize (path-expand "operators.ss" moved)))
        (def text
          (string-append
            "(def (overlay)\n"
            "  (.o config.postgresql.settings: =>.+ {port: 5433}))\n"
            "(def (client parent)\n"
            "  (.def (Client @ parent)\n"
            "    config.gitea.database: =>.+ {port: 5440})\n"
            "  Client)\n"))
        (write-source file text)
        (defvalues (overlay client) (read-overrides file '(overlay client)))
        (def patch (overlay))
        (def merged (.+ parent patch))
        (def clone (.cc merged))
        ;; The right-hand object is not itself an ancestor of the result.
        (check-equal? (if (memq patch (compute-precedence-list! merged)) #t #f) #f)
        (def copied-origin (car (field-slot-origins/value clone '(config))))
        (check-equal? (.get copied-origin source) file)
        (check-equal? (.get copied-origin line) 2)
        (defvalues (receipt next failure) (.call publication .publish parent clone))
        (check-equal? failure #f)
        (check-equal? (.get receipt accepted?) #t)
        (check-equal? (.get merged plan gitea database-port) 5433)
        (check-equal? (.get next plan gitea database-port) 5433)
        (check-equal? (.get cached gitea database-port) 5432)
        (def refined (client clone))
        (def evidence (.call (.get publication contract) .admit refined (.get publication context)))
        (def issue (car (.get evidence diagnostics)))
        (check-equal? (.get issue kind) 'connection-mismatch)
        (check-equal? (.get issue origin source) file)
        (check-equal? (.get issue origin line) 5)
        (check-equal? (.get issue expected-origin source) file)
        (check-equal? (.get issue expected-origin line) 2)
        (def raw (.cc (.get refined config gitea database) port: 5450))
        (.def (Opaque @ refined)
          config: =>.+ (.o gitea: =>.+ (.o database: raw)))
        (check-equal? (.get Opaque config gitea database port) 5450)
        (check-equal? (field-slot-origins/value Opaque '(config gitea database port)) '())
        (def opaque (.call (.get publication contract) .admit Opaque (.get publication context)))
        (check-equal? (.get (car (.get opaque diagnostics)) origin kind) 'default)
        ;; A cached clone still checks the source of the copied right-hand spec.
        (write-source file (string-append text "\n"))
        (refused publication parent merged "Scheme configuration source changed")
        (refused publication parent clone "Scheme configuration source changed")
        (refused publication parent refined "Scheme configuration source changed")
        (check-equal? (.get (.call (.get publication contract) .admit parent (.get publication context)) accepted?) #t)
        (check-equal? (.get cached postgresql port) 5432)
        (set! completed (+ completed 1))))
    (yuanxu-test-fixture "changed observed asset refuses before package output is created"
      (fixture ServicesFixture)
      (with-slots (root selection publication) fixture
        (def graph (.get selection build-graph))
        (def json (path-expand "modules/services/postgresql/postgresql.json" root))
        (write-source json (string-append (module-source-read json) "\n"))
        (def output (path-expand "must-not-exist" root))
        (check-exception (.call graph .package output) error?)
        (check-equal? (file-exists? output) #f)
        (set! completed (+ completed 1))))))

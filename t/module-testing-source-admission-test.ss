(import :std/test :clan/poo/object
        (only-in :std/error Error? Error-message)
        (only-in :gerbil/runtime/syntax SyntaxError? SyntaxError-message)
        (only-in :tao3k/yuanxu/module-system/interface yuanxu-load-modules)
        (only-in :tao3k/yuanxu/module-system/building/test-projection module-test-projection)
        (only-in :tao3k/yuanxu/module-system/source/reader module-publication-reader)
        (only-in :tao3k/yuanxu/module-system/source/admission current-module-source-observer
                 yuanxu-default-module-style-policy)
        (only-in :tao3k/yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :std/io/tempfile make-temporary-file-name clear-temporary-file!))
(export module-testing-source-admission-test)
(.def Workspace
  .acquire: (lambda ()
              (let (root (make-temporary-file-name "test-source-admission-"))
                (create-directory root) root))
  .release: clear-temporary-file!)
(def (write-source path text)
  (create-directory* (path-directory path))
  (call-with-output-file (list path: path truncate: #t) (cut display text <>)))
(def (prepare-source root (imports ""))
  (write-source (path-expand "gerbil.pkg" root)
    (string-append "(package: " (symbol->string (gensym 'source-admission-)) ")"))
  (def directory (path-expand "modules/example" root))
  (write-source (path-expand "types.ss" directory)
    "(import (only-in :clan/poo/mop Type.) (only-in :clan/poo/object object?)) (def ScopeContract (.cc Type. identity: 'fixture .element?: object?)) (export ScopeContract)")
  (write-source (path-expand "private/helper.ss" directory)
    "(def greeting \"hello\") (export greeting)")
  (write-source (path-expand "objects.ss" directory)
    "(import (only-in :clan/poo/object .o) \"./private/helper.ss\") (def Scope (.o message: greeting)) (export Scope)")
  (write-source (path-expand "config.ss" directory) "(def Enabled #t) (export Enabled)")
  (write-source (path-expand "interface.ss" directory)
    (string-append imports " (.def Example identity: 'example core: (.o
      scope-contract: ScopeContract exports: Scope) features: (.o))"))
  ;; Neither the source guard nor test discovery may expand/evaluate this body.
  (write-source (path-expand "tests/atomic-test.ss" directory)
    "(begin-syntax (error \"test expanded during discovery\")) (error \"test evaluated during discovery\")")
  ;; This is a selected, unrelated owner, not a disabled fixture. If a full
  ;; publication resolver runs during narrow discovery it necessarily fails.
  (for-each (lambda (file)
              (write-source (path-expand file (path-expand "modules/poison" root))
                "(error \"unrelated selected publication evaluated\")"))
    '("types.ss" "objects.ss" "config.ss" "interface.ss"))
  (write-source (path-expand "init.ss" root)
    "(yuanxu! :test-dir \"./t\" source: \"./modules\" mode: explicit (example) (poison))")
  directory)
(def module-testing-source-admission-test
  (test-suite "Test source admission is distinct from complete Graph admission"
    (yuanxu-test-fixture "qualification discovery needs Loader metadata and test files only"
      (root Workspace)
      (prepare-source root "(import :unavailable/qualification-dependency)")
      (write-source (path-expand "init.ss" root)
        "(yuanxu! :load-modules \"./modules\" mode: explicit rename: App :test-dir \"./t\" (example))")
      (def file (path-expand "t/yanxu/App/example/layout-test.ss" root))
      (write-source file "(error \"qualification test evaluated during discovery\")")
      (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
      (def tests (module-test-projection selection '(example) 'qualification))
      (check-equal? (.get tests spec) (list file))
      (check-equal? (.ref/cached selection 'selected-graph) #f)
      ((.get tests admit-current))
      (write-source file "(error \"changed qualification test\")")
      (check-exception ((.get tests admit-current)) error?)
      (check-exception (.get tests selected-graph)
        (lambda (failure)
          (and (SyntaxError? failure)
               (equal? (SyntaxError-message failure) "cannot find library module")))))
    (yuanxu-test-fixture "one selected owner leaves the shared Graph and unrelated publication cold"
      (root Workspace)
      (def directory (prepare-source root))
      (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
      (def tests (module-test-projection selection '(example)))
      (check-equal? (.get tests spec) (list (path-normalize (path-expand "tests/atomic-test.ss" directory))))
      (check-equal? (.ref/cached selection 'selected-graph) #f)
      (check-equal? (.ref/cached tests 'selected-graph) #f)
      ((.get tests admit-current))
      (check-equal? (.ref/cached selection 'selected-graph) #f)
      ;; A deliberate configuration request still performs full admission.
      (check-exception (.get tests selected-graph) error?))
    (yuanxu-test-fixture "actual private dependency edits invalidate test source admission"
      (root Workspace)
      (def directory (prepare-source root))
      (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
      (def tests (module-test-projection selection '(example)))
      (write-source (path-expand "private/helper.ss" directory)
        "(def greeting \"changed\") (export greeting)")
      (check-exception ((.get tests admit-current)) error?))
    (yuanxu-test-fixture "reused runtime topology still projects private inputs into each publication"
      (root Workspace)
      (def directory (prepare-source root))
      (def helper (path-normalize (path-expand "private/helper.ss" directory)))
      (def marker (path-expand "runtime-initialized" root))
      (write-source (path-expand "objects.ss" directory)
        (call-with-output-string
          (lambda (port)
            (write '(import (only-in :clan/poo/object .o) "./private/helper.ss") port)
            (write `(when (file-exists? ,marker) (error "runtime initializer repeated")) port)
            (write `(call-with-output-file ,marker (lambda (out) (display "once" out))) port)
            (write '(def Scope (.o message: greeting)) port)
            (write '(export Scope) port))))
      ;; Finish writing the fixture before recording the selected source cut.
      (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
      (def source (.call (.get selection context) locate 'example))
      (def reader (module-publication-reader))
      (def preparation-requests 0)
      (def preparation-walks 0)
      (def policy-checks 0)
      (def (read!)
        (parameterize ((current-module-source-observer
                        (lambda (key amount)
                          (case key
                            ((publication-preparation-requests)
                             (set! preparation-requests (+ preparation-requests amount)))
                            ((publication-preparation-walks)
                             (set! preparation-walks (+ preparation-walks amount)))
                            ((publication-policy-checks)
                             (set! policy-checks (+ policy-checks amount)))))))
          (.call reader read source)))
      (def first (read!))
      (check-equal? (call-with-input-file marker read-line) "once")
      (check-equal? (and (member helper (map (cut .get <> path) (.call reader inputs source))) #t) #t)
      ;; Actual Gerbil contexts are reused; dependency lookup must still occur in
      ;; this publication's fresh input collector, not a prior captured list.
      (def second (read!))
      (check-equal? (eq? first second) #f)
      (check-equal? preparation-requests 2)
      (check-equal? preparation-walks 1)
      (check-equal? policy-checks 2)
      (def prepared (.call reader preparation source))
      (check-equal? (eq? (.get prepared source) source) #t)
      (check-equal? (eq? (.get prepared source-dependencies) (.call reader inputs source)) #t)
      (check-equal? (call-with-input-file marker read-line) "once")
      (check-equal? (and (member helper (map (cut .get <> path) (.call reader inputs source))) #t) #t)
      (write-source helper "(def greeting \"changed\") (export greeting)")
      (check-exception (.call reader admit-current) error?)
      (check-exception (read!) error?))
    (yuanxu-test-fixture "retained syntax does not cache mutable authoring policy admission"
      (root Workspace)
      (prepare-source root)
      (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
      (def source (.call (.get selection context) locate 'example))
      (def reader (module-publication-reader))
      (check-exception (.call reader preparation source) error?)
      (.call reader read source)
      (def policy yuanxu-default-module-style-policy)
      (def original (.get policy validate))
      (def refused 0)
      (dynamic-wind
        void
        (lambda ()
          (.put! policy 'validate
            (lambda (_policy _owner _root _read)
              (set! refused (+ refused 1)) (error "authoring policy revoked")))
          (check-exception (.call reader preparation source) error?)
          (check-exception (.call reader read source) error?)
          (check-equal? refused 2))
        (lambda () (.put! policy 'validate original))))
    (yuanxu-test-fixture "required dependency policy remains a Graph obligation"
      (root Workspace)
      (prepare-source root "(import \"../absent/objects.ss\")")
      (write-source (path-expand "modules/absent/interface.ss" root)
        "(.def Absent identity: 'absent core: (.o scope-contract: ScopeContract exports: Scope) features: (.o))")
      (write-source (path-expand "modules/absent/objects.ss" root)
        "(def Unavailable #t) (export Unavailable)")
      ;; Remove the sibling sensitivity probe: the Graph must now fail solely
      ;; because example's own required Module is unavailable.
      (write-source (path-expand "init.ss" root)
        "(yuanxu! :test-dir \"./t\" source: \"./modules\" mode: explicit (example))")
      (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
      (check-equal? (.ref/cached selection 'selected-graph) #f)
      (check-exception (module-test-projection selection '(example))
        (lambda (exception)
          (and (Error? exception)
               (string=? (Error-message exception) "source import belongs to an unselected Module"))))
      (check-equal? (.ref/cached selection 'selected-graph) #f)
      (check-exception (.get selection selected-graph) error?))
    (yuanxu-test-fixture "explicit Graph access returns the original selection object"
      (root Workspace)
      (prepare-source root)
      (write-source (path-expand "init.ss" root)
        "(yuanxu! :test-dir \"./t\" source: \"./modules\" mode: explicit (example))")
      (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
      (def tests (module-test-projection selection '(example)))
      (check-equal? (eq? (.get tests selected-graph) (.get selection selected-graph)) #t))))

(import :std/test :clan/poo/object
        (only-in "../init.ss" yuanxu.init.exports)
        (only-in :std/io/tempfile call-with-temporary-directory)
        (only-in :std/crypto/digest sha256)
        (only-in :std/misc/ports read-all-as-u8vector)
        (only-in :yuanxu/module-system/building/products artifact-files)
        (only-in :yuanxu/ops/interface Ops)
        (only-in :yuanxu/ops/func run-script)
        (only-in :yuanxu/ops/progress execution-progress!)
        (only-in :yuanxu/module-system/source/admission module-source-read)
        (only-in :yuanxu/observability/testing-script make-compiler-progress-reader TestingScript.))
(export thousand-package-downstream-test)
(def package-source (.get yuanxu.init.exports tests source))
(def prerequisites (load-path))
(def runtime-option (car (.get TestingScript. runtime-options)))
(def runtime-environment
  (string-append (let (inherited-options (getenv "GAMBOPT" #f))
                       (if inherited-options (string-append inherited-options ",") ""))
                 (substring runtime-option 2 (string-length runtime-option))))
(def actions 0)
(def (invoke command directory state producer (success? #t))
  (def started (real-time))
  (displayln "THOUSAND-ACTION start state=" (path-strip-directory state) " command=" command)
  (force-output)
  (def result
    (run-script
      (.cc (.get Ops prototypes Script)
        command: command directory: directory progress: make-compiler-progress-reader
        timeout: 180 idle-timeout: 60 check-status: #f
        environment: (.o GERBIL_PATH: state GAMBOPT: runtime-environment
          GERBIL_LOADPATH: (string-join (append (list (path-expand "lib" state)) prerequisites (list producer)) ":")))
      '() output-port: (if success? (current-error-port) (open-output-string))))
  (def output (.get result output))
  (unless (eq? (zero? (.get result status)) success?)
    (error "unexpected thousand-catalog action status" command (.get result status) output))
  (when (and success?
             (ormap (lambda (marker) (string-contains output marker))
               '("*** ERROR" "ERROR CASE" "ERROR CHECK" "ERROR HARNESS" "Heap overflow" "Stack overflow")))
    (error "thousand-catalog child reported failure" command output))
  (set! actions (1+ actions))
  (displayln "THOUSAND-ACTION done status=" (.get result status)
             " seconds=" (- (real-time) started))
  (force-output)
  (execution-progress! 'thousand-downstream-actions actions)
  output)
(def (action consumer state producer operation (success? #t))
  (invoke (if (member operation '("use" "owner"))
            (list "gxi" (if (equal? operation "owner") "owner-check.ss" "use.ss"))
            (list "gxi" "build.ss" operation))
          consumer state producer success?))
(def (compile-events output)
  (call-with-input-string output
    (lambda (port)
      (let loop ((events '()))
        (def line (read-line port))
        (cond ((eof-object? line) (list-sort string<? events))
              ((string-prefix? "... compile " line)
               (loop (cons (substring line 12 (string-length line)) events)))
              (else (loop events)))))))
(def (source-snapshot directory)
  (foldr append '()
    (map (lambda (name)
           (def path (path-expand name directory))
           (if (eq? (file-info-type (file-info path)) 'directory)
             (source-snapshot path)
             (list (cons path (module-source-read path)))))
         (directory-files directory))))
(def (product-digests targets state)
  (map (lambda (path) (cons path (sha256 (call-with-input-file path read-all-as-u8vector))))
       (list-sort string<? (artifact-files (map string->symbol targets) (path-expand "lib" state) #f))))
(def (compiled-interfaces state)
  (def (walk directory prefix)
    (foldl (lambda (name ids)
             (let ((path (path-expand name directory)) (id (string-append prefix name)))
               (cond ((eq? (file-info-type (file-info path)) 'directory)
                      (append (walk path (string-append id "/")) ids))
                     ((string-suffix? ".ssi" name) (cons (path-strip-extension id) ids))
                     (else ids))))
           '() (directory-files directory)))
  (list-sort string<? (walk (path-expand "lib" state) "")))
(def thousand-package-downstream-test
  (test-suite "Real thousand-directory catalog, independent downstream Profile"
    (test-case "selected scope and native compiler closures, cold/hot and clean isolation"
      (call-with-temporary-directory "thousand-downstream-"
        (lambda (temporary)
          (def fixture (path-expand "fixture" temporary))
          (def producer (path-expand "producer" fixture))
          (def consumer (path-expand "consumer" fixture))
          (def a (path-expand "a" temporary))
          (def b (path-expand "b" temporary))
          (for-each (lambda (state) (create-directory* (path-expand "lib" state))) (list a b))
          (invoke (list "python3" (path-expand "dev/thousand_package_fixture.py" (.get package-source source-root)) fixture "--profile")
                  (.get package-source source-root) a producer)
          (def modules (path-expand "modules" producer))
          (def owners
            (filter (lambda (name)
                      (eq? (file-info-type (file-info (path-expand name modules))) 'directory))
                    (directory-files modules)))
          (check-equal? (length owners) 1000)
          (for-each (lambda (name)
                      (for-each (lambda (role)
                                  (check-equal? (file-exists? (path-expand role (path-expand name modules))) #t))
                                '("types.ss" "objects.ss" "config.ss" "interface.ss")))
                    owners)
          (def original (source-snapshot producer))
          (def consumer-original (source-snapshot consumer))
          (def spec (call-with-input-string (action consumer a producer "spec") read))
          (def targets (list-sort string<? (map cadr spec)))
          (def selected-prefix "yuanxu-thousand-library/modules/")
          (def producer-targets (filter (lambda (id) (string-prefix? selected-prefix id)) targets))
          (check-equal? (pair? producer-targets) #t)
          (for-each (lambda (id)
                      (check-equal? (or (string-prefix? (string-append selected-prefix "module-0/") id)
                                        (string-prefix? (string-append selected-prefix "module-1/") id)) #t))
                    producer-targets)
          (check-equal? (and (member (string-append selected-prefix "module-1/support") targets) #t) #t)
          (check-equal? (member (string-append selected-prefix "module-1/build") targets) #f)
          (for-each (lambda (identity)
                      (check-equal? (file-exists? (path-expand (string-append "lib/" identity ".ssi") a)) #f)
                      (check-equal? (ormap (lambda (directory) (file-exists? (path-expand (string-append identity ".ssi") directory))) prerequisites) #f))
                    targets)
          (check-equal? (compile-events (action consumer a producer "compile")) targets)
          (check-equal? (compiled-interfaces a) targets)
          (for-each (lambda (identity)
                      (for-each (lambda (suffix)
                                  (check-equal? (file-exists? (path-expand (string-append "lib/" identity suffix) a)) #t))
                                '(".ssi" ".o1"))) targets)
          (check-equal? (compile-events (action consumer a producer "compile")) '())
          (check-equal? (and (string-contains (action consumer a producer "use") "THOUSAND-USE scopes=2") #t) #t)
          (check-equal? (compile-events (action consumer b producer "compile")) targets)
          (check-equal? (compiled-interfaces b) targets)
          (check-equal? (and (string-contains (action consumer b producer "use") "THOUSAND-USE scopes=2") #t) #t)
          (check-equal? (and (string-contains
                              (action (path-expand "scope-control" fixture) b producer "use")
                              "THOUSAND-SCOPE catalog=1000 declarations=3 scopes=2 unrelated-admitted-scope=cold") #t) #t)
          (check-equal? (file-exists? (path-expand "lib/yuanxu-thousand-library/modules/module-2/interface.ssi" b)) #f)
          (def sentinel (path-expand "lib/unrelated/keep.ss" a))
          (create-directory* (path-directory sentinel))
          (call-with-output-file sentinel (cut display "unrelated\n" <>))
          (def b-before-clean (product-digests targets b))
          (check-equal? (pair? b-before-clean) #t)
          (action consumer a producer "clean")
          (check-equal? (product-digests targets b) b-before-clean)
          (check-equal? (compiled-interfaces a) '())
          (check-equal? (compiled-interfaces b) targets)
          (for-each (lambda (identity)
                      (for-each (lambda (suffix)
                                  (check-equal? (file-exists? (path-expand (string-append "lib/" identity suffix) a)) #f)
                                  (check-equal? (file-exists? (path-expand (string-append "lib/" identity suffix) b)) #t))
                                '(".ssi" ".o1"))) targets)
          (check-equal? (file-exists? sentinel) #t)
          (check-equal? (compile-events (action consumer b producer "compile")) '())
          (check-equal? (and (string-contains (action consumer b producer "use") "THOUSAND-USE scopes=2") #t) #t)
          ;; A distinct source selection owns its own init and output root.
          ;; Never mutate a producer or either successful consumer's init.
          (def c (path-expand "missing-provider-state" temporary))
          (create-directory* (path-expand "lib" c))
          (def refused (action (path-expand "missing-provider" fixture) c producer "spec" #f))
          (check-equal? (and (string-contains refused "required module not explicitly declared") #t) #t)
          (check-equal? (compile-events refused) '())
          (for-each (lambda (identity)
                      (check-equal? (file-exists? (path-expand (string-append "lib/" identity ".ssi") c)) #f)) targets)
          (check-equal? (compile-events (action consumer b producer "compile")) '())
          (check-equal? (and (string-contains (action consumer b producer "use") "THOUSAND-USE scopes=2") #t) #t)
          (check-equal? (source-snapshot producer) original)
          (check-equal? (source-snapshot consumer) consumer-original)
          (displayln "THOUSAND-DOWNSTREAM catalog=1000 profile=security roots=1 declarations=2 scopes=2 targets=" (length targets)
                     " scope-control=3-to-2 owner-options=ok hot=0 clean-isolation=ok upstream=unchanged missing-provider=refused"))))))

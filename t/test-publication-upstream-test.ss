;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Native upstream controls, not a second build/publication implementation.
(import :std/test :clan/poo/object
        (only-in :std/io/tempfile call-with-temporary-directory)
        (only-in :std/error Error-message)
        (only-in :clan/poo/mop lens-of-get-set .lens)
        (only-in :clan/poo/component-closure component-group-builder)
        (only-in :clan/poo/lens-laws lens-check)
        (only-in :clan/poo/feedback-graph
          publish-feedback-graph graph-cache-values)
        (prefix-in :clan/poo/component-publication publication.)
        (prefix-in :clan/poo/component-revision revision.)
        (prefix-in :clan/poo/construction-cache cache.)
        (prefix-in :clan/poo/generalized-graph graph.)
        (prefix-in :clan/poo/dependency-analysis code.)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :yuanxu/module-system/source/admission
          module-source-read module-source-admit-current!))
(export test-publication-upstream-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (unless (= completed 4) (error "incomplete upstream publication controls" completed))
  (displayln "UPSTREAM-PUBLICATION: 4 cases completed"))

;; One selected native graph. These existing constructors supply the protocol;
;; no Core registry, Builder subclass or replacement scheduler is involved.
(def (initial)
  (def source (graph.declaration '(port) (list (cons 'port (code.pure 5432)))))
  (def focus (lens-of-get-set identity (lambda (value _) value)))
  (def construct (component-group-builder '(port) (lambda (_) focus) 0 0 8))
  (defvalues (approved failure)
    (publish-feedback-graph #f source construct (lambda (_ __) #t)))
  (when failure (raise failure))
  (values approved construct))
(def (port-edit port)
  (list (revision.fragment '() '() (list (cons 'port (code.pure port))))))
(def (caught action) (try (action) #f (catch (cause) cause)))
(def (write-config path text)
  (call-with-output-file (list path: path truncate: #t) (cut display text <>)))

(def test-publication-upstream-test
  (test-suite "PR native publication ownership and demanded test inputs"
    (yuanxu-test-case "one graph has independent production and test heads"
      (defvalues (selected construct) (initial))
      (def domain (publication.approval-domain))
      (def production (publication.publication selected domain: domain))
      (def tests (publication.publication selected domain: domain))
      (check (eq? (publication.current production) (publication.current tests)) => #t)
      (def request (publication.stage tests (port-edit 5433) construct (lambda (_ __) #t)))
      ;; submit! returns failures as a second value; a foreign owner never installs.
      (defvalues (held wrong-owner) (publication.submit! production request))
      (check (not (not wrong-owner)) => #t)
      (check-equal? (Error-message wrong-owner)
        "request belongs to another component publication")
      (check (eq? held selected) => #t)
      (defvalues (next ok) (publication.submit! tests request))
      (check-equal? ok #f)
      (check (eq? next selected) => #f)
      (check (eq? (publication.current production) selected) => #t)
      (check (eq? (publication.current tests) next) => #t)
      (def warm-request (publication.stage tests '() construct (lambda (_ __) #t)))
      (defvalues (warm ok-warm) (publication.submit! tests warm-request))
      (check-equal? ok-warm #f)
      (check-equal? (cache.cache-evaluated (graph-cache-values next)) '(port))
      (check-equal? (cache.cache-evaluated (graph-cache-values warm)) '())
      (check-equal? (cache.cache-reused (graph-cache-values warm)) '(port))
      (check (eq? (cache.cache-ref (graph-cache-values next) 'port)
                  (cache.cache-ref (graph-cache-values warm) 'port)) => #t)
      (check (eq? (publication.current production) selected) => #t)
      (defvalues (held-warm stale) (publication.submit! tests request))
      (check (eq? held-warm warm) => #t)
      (check-equal? (Error-message stale) "stale component revision snapshot")
      (set! completed (+ completed 1)))
    (yuanxu-test-case "cached parent plan does not substitute for child final values"
      (def hidden 0)
      (.def (Parent @ [] port)
        port: 5432
        plan: (.o final-port: port)
        unselected: (begin (set! hidden (+ hidden 1)) (error "unselected")))
      (def parent-plan (.get Parent plan))
      (.def (Child @ Parent) port: 5440)
      (check-equal? (.get Child plan final-port) 5440)
      (check-equal? (.get parent-plan final-port) 5432)
      (check (eq? parent-plan (.get Child plan)) => #f)
      (check-equal? hidden 0)
      (set! completed (+ completed 1)))
    (yuanxu-test-case "source revision refuses staging before callbacks and retains head"
      (defvalues (selected construct) (initial))
      (def owner (publication.publication selected))
      (def source (.o epoch: 1))
      (def called? #f)
      (def request
        (publication.stage owner (port-edit 5440) construct
          (lambda (_ __) (set! called? #t) #t)
          guards: (list (lens-check (.lens) (list source) sources: (list source)))))
      (.putslot! source 'epoch ($constant-slot-spec 2))
      (defvalues (held failure) (publication.submit! owner request))
      (check (not (not failure)) => #t)
      (check-equal? (Error-message failure) "stale or invalid lens checks")
      (check (eq? held selected) => #t)
      (check-equal? called? #f)
      (set! completed (+ completed 1)))
    (yuanxu-test-case "file changes and original failures are not successful publication"
      (call-with-temporary-directory "test-publication-source-"
        (lambda (directory)
          (def path (path-expand "config.ss" directory))
          (write-config path "port: 5432\n")
          (def inputs (list (cons path (module-source-read path))))
          (defvalues (selected construct) (initial))
          (def owner (publication.publication selected))
          (def request (publication.stage owner (port-edit 5440) construct
            (lambda (_ __) (module-source-admit-current! inputs) #t)))
          (write-config path "port: 5440\n")
          (defvalues (held stale) (publication.submit! owner request))
          (check (not (not stale)) => #t)
          (check-equal? (Error-message stale)
            "stale selected build input; regenerate the build entry")
          (check (eq? held selected) => #t)
          (def original (caught (lambda () (error "compiler diagnostic retained"))))
          (def failed (publication.stage owner (port-edit 5440) construct
            (lambda (_ __) (raise original))))
          (defvalues (unchanged failure) (publication.submit! owner failed))
          (check (eq? failure original) => #t)
          (check-equal? (Error-message failure) "compiler diagnostic retained")
          (check (eq? unchanged selected) => #t)
          (set! completed (+ completed 1)))))))

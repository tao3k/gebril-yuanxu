(import :std/test
        (only-in :std/io/tempfile call-with-temporary-directory)
        (only-in :std/text/pregexp pregexp-match)
        (only-in :gerbil/expander current-expander-context make-top-context)
        (only-in :gerbil/runtime/loader load-path set-load-path!)
        (only-in :clan/poo/object .get .call)
        (only-in :std/misc/ports read-all-as-u8vector)
        (only-in :std/make make)
        (only-in :tao3k/yuanxu/module-system/building/products
                 current-build-output-directory)
        (only-in :tao3k/yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :tao3k/yuanxu/module-system/source/observations
                 call-with-module-source-operation-measurement)
        (only-in "./qualification/module-init/fixture.ss" import-fixture-init! import-build-script! with-compiler-progress))
(export module-build-command-test)

(def (write-source path text)
  (create-directory* (path-directory path))
  (call-with-output-file path (lambda (port) (display text port))))

(def (write-module root path identity)
  (def owner (path-expand path root))
  (write-source (path-expand "types.ss" owner)
    "(import :clan/poo/object (only-in :clan/poo/type Type.)) (def Scope (.cc Type. identity: 'scope .element?: object?)) (export Scope)")
  (write-source (path-expand "objects.ss" owner)
    "(import :clan/poo/object) (def Defaults (.o)) (export Defaults)")
  (write-source (path-expand "interface.ss" owner)
    (string-append "(.def Module identity: '" identity
                   " core: (.o scope-contract: Scope exports: Defaults) features: (.o))")))

(def (linked-build root lib package name (entry-owner name) (imports #f))
  (def owner (string-append "modules/" name))
  (def init (string-append name "-init"))
  (def binding (string->symbol (string-append package "." init ".exports")))
  (def script (path-expand (string-append name "-build.ss") root))
  (def (write-forms path . forms)
    (write-source (path-expand path root)
      (call-with-output-string
        (lambda (port)
          (for-each (lambda (form) (write form port) (newline port)) forms)))))
  (write-module root owner name)
  (def support (string-append name "-support"))
  (def support-library (string->symbol (string-append ":" package "/" support)))
  (write-forms (string-append support ".ss")
    '(export support-value) '(def support-value 7))
  ;; Gerbil clean can leave generated Scheme beside a removed .ssi. The
  ;; linker must resolve the declared source root over that generated file.
  (write-source (path-expand (string-append package "/" support ".scm") lib)
    "(define generated-output 0)")
  (def entry (string->symbol (string-append package "/modules/" entry-owner "/entry")))
  (write-forms (string-append owner "/objects.ss")
    `(import :clan/poo/object (only-in ,support-library support-value)) '(export Defaults)
    `(def Defaults (.o program-entry: ',entry source-value: support-value
                    ,@(if imports `(program-runtime-imports: ',imports) '()))))
  (write-forms (string-append owner "/entry.ss")
    '(export main) '(def (main . args) 0))
  (write-forms (string-append owner "/interface.ss")
    '(import (only-in :clan/poo/object .def .o) "./types.ss" "./objects.ss")
    '(export Module)
    `(.def Module identity: ',(string->symbol name)
       core: (.o scope-contract: Scope exports: Defaults) features: (.o)))
  (write-forms (string-append owner "/build.ss")
    '(import (only-in :clan/poo/object .def .o)) '(export Build)
    '(.def Build defbuild-script: (.o spec: '("entry"))))
  (write-forms (string-append init ".ss")
    '(import :tao3k/yuanxu/module-system/selection/init-syntax)
    `(yuanxu! :build-roots (,init ,support)
       :load-modules "./modules" mode: explicit mount: Default (,(string->symbol name))))
  (write-forms script
    `(import (only-in :std/build-script defbuild-script)
             (only-in :std/source this-source-file)
             (only-in :clan/poo/object .get .call)
             (only-in ,(string-append "./" init ".ss") ,binding))
    `(defvalues (main)
       (.call ,binding .with-link (lambda () '())
         (let ()
           (defbuild-script (.get ,binding std-make-spec) libdir: ,lib)
           main))))
  (import-build-script! script))

(def (rejects? message)
  (lambda (error)
    (pregexp-match message (call-with-output-string (cut display-exception error <>)))))

(def module-build-command-test
  (test-suite "Explicit Module and mount compiler command"
    (yuanxu-test-case "one native build consumes the union without changing the default spec"
      (call-with-temporary-directory "module-build-command"
        (lambda (root)
          (def package (symbol->string (gensym 'build-command-)))
          (def init (path-expand "init.ss" root))
          (write-source (path-expand "gerbil.pkg" root) (string-append "(package: " package ")"))
          (write-source init
            "(import :tao3k/yuanxu/module-system/selection/init-syntax)
             (yuanxu!
               :load-modules \"./default\" mode: explicit mount: Default
               (main) (blocked disable: #t)
               :load-modules \"./tools\" mode: auto mount: Tools
               :load-modules \"./cold\" mode: explicit mount: Cold (unused disable: #t))")
          (write-module root "default/main" "main")
          (write-module root "tools/worker" "worker")
          (write-module root "tools/helper" "helper")
          ;; The default spec and individual leaf requests leave
          ;; unrelated builds cold.
          (write-module root "cold/unused" "unused")
          (write-source (path-expand "cold/unused/build.ss" root) "(error \"unexpected build\")")
          (parameterize ((current-expander-context (make-top-context))
                         (current-build-output-directory (path-expand "lib" root)))
            (def exports (import-fixture-init! init))
            (def (compile leaves mounts)
              (.call exports .compile-selection leaves mounts
                (lambda (targets source-root)
                  (make targets srcdir: source-root libdir: (path-expand "lib" root)))))
            (def (default-spec) (.get exports std-make-spec))
            (def default (default-spec))
            (def (make-target-names spec)
              (list-sort string<? (map (lambda (target)
                                       (if (string? target) target (cadr target))) spec)))
            (defvalues (selected-spec work)
              (call-with-module-source-operation-measurement
                (lambda () (.call exports .make-spec-for '(Tools/worker Tools/helper Tools/worker)))
                accounting?: #f))
            (check-equal? (hash-ref work '(calls scope-factory) 0) 0)
            (check-equal? (make-target-names selected-spec)
                          (make-target-names (.get exports Tools __std-make-spec)))
            (check-equal? (default-spec) default)
            (def (product path)
              (file-exists? (path-expand (string-append "lib/" package "/" path "/interface.ssi") root)))
            (check-equal? (product "tools/worker") #f)
            (check-equal? (product "tools/helper") #f)
            (check-exception (compile '() '(Missing)) (rejects? "unknown build mount"))
            (check-exception (compile '(Default/blocked) '()) (rejects? "disabled"))
            (check-exception (compile '(Default/missing) '()) (rejects? "outside selected"))
            (def input-path (load-path))
            (with-compiler-progress
              (lambda ()
                (compile '(Tools/worker Tools/helper Tools/worker) '())))
            (check-equal? (load-path) input-path)
            (check-equal? (product "tools/worker") #t)
            (check-equal? (product "tools/helper") #t)
            (check-equal? (product "default/main") #f)
            (check-equal? (product "cold/unused") #f)
            (check-equal? (default-spec) default)
            (with-compiler-progress
              (lambda ()
                (compile '(worker Tools/worker) '(Tools Default Default))))
            (check-equal? (product "default/main") #t)))))
    (yuanxu-test-case "native link clean removes only selected program products"
      (call-with-temporary-directory "module-link-clean"
        (lambda (root)
          (def package (symbol->string (gensym 'link-clean-)))
          (def lib (path-expand "lib" root))
          (def inputs (load-path))
          (write-source (path-expand "gerbil.pkg" root) (string-append "(package: " package ")"))
          (create-directory* lib)
          (dynamic-wind
            (lambda () (add-load-path! lib))
            (lambda ()
              (parameterize ((current-build-output-directory lib))
                (def alpha (linked-build root lib package "alpha"))
                (def beta (linked-build root lib package "beta" "beta" '()))
                (def foreign (linked-build root lib package "foreign" "beta"))
                (def (program name)
                  (path-expand (string-append package "/programs/modules/" name) lib))
                (def (entry name)
                  (path-expand (string-append package "/modules/" name "/entry.ssi") lib))
                (def (products name (metadata? #t))
                  (map (cut path-expand <> (program name))
                       (if metadata?
                         '("program.json" "program__exe.scm" "metadata-modules.dat")
                         '("program.json" "program__exe.scm"))))
                (def (entry-dynamic-products name)
                  (def directory (path-directory (entry name)))
                  (filter-map
                    (lambda (file)
                      (and (pregexp-match "^entry(~[0-9]+)?[.]o[0-9]+$" file)
                           (path-expand file directory)))
                    (directory-files directory)))
                (def (bytes path) (call-with-input-file path read-all-as-u8vector))
                (with-compiler-progress (lambda () (alpha "compile") (beta "compile")))
                (def alpha-dynamic (entry-dynamic-products "alpha"))
                (def beta-dynamic (entry-dynamic-products "beta"))
                (check (pair? alpha-dynamic) => #t)
                (check (pair? beta-dynamic) => #t)
                (def alpha-paths (cons (entry "alpha") (append (products "alpha") alpha-dynamic)))
                (def beta-paths (cons (entry "beta") (append (products "beta" #f) beta-dynamic)))
                (check (andmap file-exists? alpha-paths) => #t)
                (check-equal? (file-exists? (path-expand "metadata-modules.dat" (program "beta"))) #f)
                (def beta-before (map bytes beta-paths))
                (check-exception (foreign "clean") (rejects? "outside its selected module"))
                ;; A file that was never published by either Build stays in place.
                (def unrelated (path-expand "metadata/.other.scm" (program "alpha")))
                (write-source unrelated "unrelated")
                (alpha "clean")
                (check (ormap file-exists? alpha-paths) => #f)
                (check-equal? (directory-files (list path: (path-directory unrelated)
                                                    ignore-hidden: 'dot-and-dot-dot)) '(".other.scm"))
                (check-equal? (map bytes beta-paths) beta-before)
                (alpha "clean")
                (check-equal? (map bytes beta-paths) beta-before)
                (check-equal? (call-with-input-file unrelated read) 'unrelated)
                (beta "clean")
                (check (ormap file-exists? beta-paths) => #f)
                (check-equal? (file-exists? (program "beta")) #f)))
            (lambda () (set-load-path! inputs))))))))

;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Run only with the temporary dispatcher produced by the bounded Just recipe.
(import :std/test :clan/poo/object
        ;; Establish the real execution library before taking the reader's
        ;; immutable compiler-context snapshot. Importing does not execute it.
        (only-in :yuanxu/observability/testing-script TestingScript.)
        (only-in :yuanxu/admission/source SourceAdmissionContract.)
        (only-in :yuanxu/configuration/diagnostics config-diagnostic-locator)
        (only-in :yuanxu/module-system/source/admission
                 current-module-source-observer current-module-source-phase module-source-read)
        (only-in :yuanxu/t/qualification/mop-state/closed-tail probe on-file refuses)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/t/qualification/service-publication/fixtures
                 DirectoryFixture ServicesFixture write-source))
(export source-admission-gateway-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (check-equal? completed 7)
  (displayln "SOURCE-ADMISSION-GATEWAY: 7 cases completed"))
(def (admit Contract value context (observer #f))
  (with-catch values
    (lambda ()
      (parameterize ((current-module-source-observer observer))
        (.call Contract .admit value context)))))
(def source-admission-gateway-test
 (test-suite "Temporary producer-owned event gate, actual SourceAdmissionContract"
  (yuanxu-test-fixture "no opaque tail callback permits cold and hot admission without sealing objects"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def sample (probe (list path)))
    (for-each (lambda (_mode)
                (check-equal? (.get (admit (.get sample contract) (.get sample candidate) #f) accepted?) #t))
              '(cold warm))
    (.putslot! (.get sample candidate) 'port ($constant-slot-spec 5433))
    (check-equal? (.get sample candidate port) 5433)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "producer denies all three late object attacks before invocation"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (for-each
      (lambda (target)
        (def sample (probe (list path)))
        (def receiver (case target ((receiver) (.get sample contract))
                               ((candidate) (.get sample candidate))
                               ((external) (.get sample external))))
        (def key (if (eq? target 'receiver) 'marker 'port))
        (def before (object-revision receiver))
        (def fired 0)
        (def result
          (admit (.get sample contract) (.get sample candidate) #f
            (on-file path (lambda ()
                            (set! fired (+ fired 1))
                            (.putslot! receiver key ($constant-slot-spec 9000))))))
        (refuses result "opaque source observer in return tail")
        (check-equal? fired 0)
        (check-equal? (object-revision receiver) before))
      '(receiver candidate external))
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "producer denies second file callback before it can write the first"
    (fixture DirectoryFixture)
    (def first (path-expand "first.json" (.get fixture root)))
    (def second (path-expand "second.json" (.get fixture root)))
    (write-source first "{}") (write-source second "{}")
    (def sample (probe (list first second)))
    (def fired 0)
    (def result
      (admit (.get sample contract) (.get sample candidate) #f
        (on-file second (lambda () (set! fired (+ fired 1)) (write-source first "{\"late\":true}")))))
    (refuses result "opaque source observer in return tail")
    (check-equal? fired 0)
    (check-equal? (module-source-read first) "{}")
    (check-equal? (module-source-read second) "{}")
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "earlier callback rebinding the observer cannot replace the producer gate"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def sample (probe (list path)))
    (def dependency (.get sample external))
    (def before (object-revision dependency))
    (def fired 0)
    (def attack (on-file path (lambda ()
                               (set! fired (+ fired 1))
                               (.putslot! dependency 'port ($constant-slot-spec 5433)))))
    (def context (.o admit-current: (lambda () (current-module-source-observer attack))))
    (def prior (current-module-source-observer))
    (refuses (admit (.get sample contract) (.get sample candidate) context)
             "opaque source observer in return tail")
    (check-equal? fired 0)
    (check-equal? (object-revision dependency) before)
    (check-equal? (eq? prior (current-module-source-observer)) #t)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "verification-segment gate denies the cache-exit attack before it can remove itself"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def sample (probe (list path)))
    (def dependency (.get sample external))
    (def before (object-revision dependency))
    (def fired 0)
    (def attack
      (lambda (key _amount)
        (when (and (eq? (current-module-source-phase) 'slot-replay)
                   (eq? key 'check-seconds))
          (set! fired (+ fired 1))
          (.putslot! dependency 'port ($constant-slot-spec 5433))
          (current-module-source-observer #f))))
    (def result (admit (.get sample contract) (.get sample candidate) #f attack))
    ;; Matched compiled-policy control. This flag selects the EXPECTATION only;
    ;; it never changes the source dispatcher or skips a native admission.
    (case (string->symbol (getenv "CORE_SOURCE_TAIL_POLICY" "segment"))
      ((return-only)
       (check-equal? (.get result accepted?) #t)
       (check-equal? fired 1)
       (check-equal? (object-revision dependency) (+ before 1))
       (check-equal? (.get dependency port) 5433))
      ((segment)
       (refuses result "opaque source observer in return tail")
       (check-equal? fired 0)
       (check-equal? (object-revision dependency) before))
      (else (error "unknown compiled policy expectation")))
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "earlier source mismatch keeps priority over object staleness and tail denial"
    (fixture DirectoryFixture)
    (def path (path-expand "input.json" (.get fixture root)))
    (write-source path "{}")
    (def sample (probe (list path)))
    (def context
      (.o admit-current: (lambda ()
                           (.putslot! (.get sample external) 'port ($constant-slot-spec 5433))
                           (write-source path "{\"changed\":true}"))))
    (refuses (admit (.get sample contract) (.get sample candidate) context (lambda (_k _n) (void)))
             "configuration source changed")
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "real two-party service admission keeps child obligations, final plan and parent cache"
    (fixture ServicesFixture)
    (def publication (.get fixture publication))
    (def Contract (.get publication contract))
    (def Context (.get publication context))
    (def keys (map (lambda (entry) (.get entry origin key)) (.get Context contributions)))
    (check-equal? (length keys) 2)
    (check-equal? (and (memq 'postgresql-port keys) (memq 'gitea-port keys) #t) #t)
    (def Parent (.get publication value))
    (def cached (.get Parent plan))
    (.def (Release @ Parent)
      config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (def analyzed #f)
    (def analyze (.get Context .contract-obligations))
    (def Observed
      (.cc Context .contract-obligations:
        (lambda (actual candidate)
          (def issues (analyze actual candidate))
          (when (eq? actual Contract) (set! analyzed candidate))
          issues)))
    (for-each
      (lambda (_mode)
        (def evidence (admit Contract Release Observed))
        (check-equal? (.get evidence accepted?) #t)
        (check-equal? (.get analyzed config postgresql settings port) 5433)
        (check-equal? (.get analyzed plan postgresql port) 5433)
        (check-equal? (.get analyzed plan gitea database-port) 5433)
        (def children (car (.get evidence responsibility-evidence)))
        (check-equal? (eq? (.get children candidate) (.get analyzed config)) #t)
        (check-equal? (length (.get children responsibility-evidence)) 2))
      '(cold warm))
    (.def (Mismatch @ Release)
      config: =>.+ (.o gitea: =>.+ (.o database: =>.+ (.o port: 5440))))
    (check-equal? (.get (admit Contract Mismatch Context) accepted?) #f)
    (def fired 0)
    (refuses
      (admit Contract Release Observed
        (lambda (key _amount)
          (when (and (eq? (current-module-source-phase) 'return-currentness)
                     (pair? key) (eq? (car key) 'file-read))
            (set! fired (+ fired 1))
            (.putslot! (.get analyzed config postgresql settings) 'port ($constant-slot-spec 5440)))))
      "opaque source observer in return tail")
    (check-equal? fired 0)
    (check-equal? (.get analyzed config postgresql settings port) 5433)
    (check-equal? (.get analyzed plan postgresql port) 5433)
    (check-equal? (.get cached postgresql port) 5432)
    (check-equal? (eq? cached (.get Parent plan)) #t)
    (set! completed (+ completed 1)))))

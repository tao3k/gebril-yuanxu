(import :std/test (except-in :clan/poo/object .def .o)
        :yuanxu/object-syntax/path-slots
        (only-in :std/error Error? Error-message)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/observability/testing-case yuanxu-test-checkpoint)
        (only-in :yuanxu/t/qualification/module-demand/fixture ProjectionFixture scope-context project-metadata)
        (only-in :yuanxu/module-system/source/selection select-module-graph)
        (only-in :yuanxu/module-system/source/admission current-module-source-observer
                 admit-module-publication! module-source-admit-current!)
        (only-in :yuanxu/module-system/source/objects make-yuanxu-module-source-ref)
        (only-in :clan/poo/slot-observation
                 call-with-slot-read-observer slot-read-receiver slot-read-key))
(export module-demand-projection-test)
(def (observed action)
  (def records '())
  (call-with-slot-read-observer (lambda (read) (set! records (cons read records))) action)
  (reverse records))
(def (replace-source path forms)
  (call-with-output-file (list path: path truncate: #t)
    (lambda (port) (for-each (lambda (form) (write form port) (newline port)) forms))))
(def module-demand-projection-test
  (test-suite "Actual metadata and role binding through native source wrappers"
    (yuanxu-test-fixture "metadata selects without roles; access and child use final receivers"
      (fixture ProjectionFixture)
      (def count 0)
      (def (observe key amount)
        (when (eq? (if (pair? key) (car key) key) 'reader-body-expanded)
          (set! count (+ count amount))))
      (parameterize ((current-module-source-observer observe))
        (def parent (.get fixture module))
        (def initial count)
        (.def Database identity: 'database core: (.o requires: (.o)) features: (.o))
        (def context (.o selected: '(application database) denied-modules: '() generation: 0))
        (def graph
          (select-module-graph context '(application)
            (lambda (id) (if (eq? id 'application) parent Database)) void))
        (check-equal? (length (.get graph module-order)) 2)
        (check-equal? count initial)
        (check-equal? (.get parent identity) (.get fixture metadata identity))
        (check-equal? (.get parent core requires Database module-id)
                      (car (.get fixture metadata requires)))
        (check-equal? (.ref/cached parent 'scope) #f)
        (check-equal? (.ref/cached (.get parent core) 'roles) #f)
        (def denied (.cc context denied-modules: '(database)))
        (def (resolver id) (if (eq? id 'application) parent Database))
        (def disabled (with-catch values
                        (cut select-module-graph denied '(application) resolver void)))
        (check-equal? (Error? disabled) #t)
        (check-equal? (Error-message disabled) "required module disabled")
        (.def (cyclic-database @ Database)
          core: =>.+ (.o requires: (.o Application: (.o module-id: 'application))))
        (check-equal? (Error? (with-catch values
                       (lambda () (select-module-graph context '(application)
                         (lambda (id) (if (eq? id 'application) parent cyclic-database)) void)))) #t)
        (check-equal? count initial)
        (yuanxu-test-checkpoint 'metadata-only)
        ;; Actual publication admission demands Types, never a domain scope.
        (def source-ref (make-yuanxu-module-source-ref 'local
                           (path-expand "interface.ss" (.get fixture root))
                           '((module-id . application))))
        (def (publication module)
          (module-source-admit-current! (.get fixture sources))
          (def result (admit-module-publication! source-ref 'application module #f))
          (module-source-admit-current! (.get fixture sources))
          result)
        (def parent-publication (publication parent))
        (check-equal? (.get parent-publication accepted?) #t)
        (check-equal? (eq? (.get parent-publication candidate) parent) #t)
        (check-equal? (.get (publication parent) accepted?) #t)
        (check-equal? (- count initial) 1)
        (check-equal? (.ref/cached parent 'scope) #f)
        (for-each (lambda (role)
                    (check-equal? (.ref/cached (.get parent core roles) role) #f))
                  '(config objects func))
        (check-equal? (Error? (with-catch values
          (lambda () (admit-module-publication!
            (make-yuanxu-module-source-ref 'local "interface.ss" '((module-id . other)))
            'application parent #f)))) #t)
        (.def (invalid-contract @ parent) core.scope-contract: #f)
        (check-equal? (Error? (with-catch values (cut publication invalid-contract))) #t)
        ;; The derived invalid declaration has its own dependency Type getter;
        ;; validating it adds one Type expansion, never a domain scope.
        (check-equal? count (+ initial 2))
        (check-equal? (.ref/cached invalid-contract 'scope) #f)
        (for-each (lambda (role)
                    (check-equal? (.ref/cached (.get invalid-contract core roles) role) #f))
                  '(config objects func))
        (def cached (.get parent scope))
        (check-equal? (.get cached port) 5432)
        (check-equal? (> count initial) #t)
        (.def (child @ parent) core.config.port: 5433)
        (check-equal? (.get (publication child) accepted?) #t)
        (def contract (.get child core scope-contract))
        (def admitted (.call contract .admit (.get child scope) (scope-context child)))
        (check-equal? (.get admitted accepted?) #t)
        (check-equal? (.get contract source-inputs) (.get fixture sources))
        (check-equal? (.get admitted candidate port) 5433)
        (check-equal? (.get cached port) 5432)
        (check-equal? (eq? cached (.get parent scope)) #t)
        (check-equal? (.get (.call contract .admit (.get child scope)
                          (scope-context child '(5432 5433) '(5432))) accepted?) #f)
        (check-equal? (.ref/cached (.get child core roles) 'func) #f)
        (def first (observed (cut .get child scope)))
        (def second (observed (cut .get child scope)))
        (check-equal? (pair? first) #t)
        (check-equal? (ormap (lambda (read) (eq? (slot-read-receiver read) child)) first) #t)
        (check-equal? (andmap object-read-issued? first) #t)
        (check-equal? (length first) (length second))
        (check-equal? (andmap (lambda (pair) (eq? (car pair) (cdr pair)))
                             (map cons first second)) #t)
        (def (replay-order)
          (def visits '())
          (replay-slot-reads! first
            (lambda (receiver key) (set! visits (cons (cons receiver key) visits))))
          (reverse visits))
        (def order (replay-order))
        (check-equal? (> (length order) 1) #t)
        (check-equal? (equal? order (replay-order)) #t)
        ;; Source currentness remains an independent .admit check after hits.
        (def source (path-expand "config.ss" (.get fixture root)))
        (call-with-output-file (list path: source append: #t)
          (lambda (port) (display "\n; changed after parent and child caches\n" port)))
        (def failure (with-catch values
                      (lambda () (.call contract .admit (.get child scope) (scope-context child)))))
        (check-equal? (Error? failure) #t)
        (check-equal? (Error-message failure) "configuration source changed")
        (displayln "MODULE-DEMAND-PROJECTION metadata-role-expansions=0"
                   " activated-role-expansions=" (- count initial)
                   " issued-hot-observations=" (length first)
                   " replay-visits=" (length order)
                   " parent-port=" (.get cached port)
                   " child-port=" (.get admitted candidate port))))
    (yuanxu-test-fixture "open metadata is refused without executing its body"
      (fixture ProjectionFixture)
      (def interface (path-expand "interface.ss" (.get fixture root)))
      (def (refused body)
        (replace-source interface body)
        (check-equal? (Error? (with-catch values (cut project-metadata interface))) #t))
      (refused '((.def Module identity: 'a identity: 'b
                   core: (.o requires: (.o)) features: (.o))))
      (refused '((.def Module identity: 'a core: (.o requires:
                   (.o Database: (.o module-id: (error "must not execute")))) features: (.o))))
      (refused '((.def Module identity: 'a core: (.o requires: (.o)) features: (.o))
                 (error "extra top form must not execute")))
      (refused '((.def Module identity: 'a
                   core: (.o (:: self [UnknownParent]) requires: (.o)) features: (.o)))))))

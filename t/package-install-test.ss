(import :std/test :clan/poo/object
        (only-in "../init.ss" tao3k/yuanxu.init.exports)
        (only-in :std/io/tempfile call-with-temporary-directory)
        (only-in :std/misc/ports read-all-as-string read-all-as-u8vector)
        (only-in :std/crypto/digest sha256)
        (only-in :tao3k/yuanxu/module-system/building/products artifact-files)
        (only-in :tao3k/yuanxu/ops/interface Ops)
        (only-in :tao3k/yuanxu/ops/func run-script)
        (only-in :tao3k/yuanxu/ops/progress execution-progress!)
        (only-in :tao3k/yuanxu/observability/testing-script make-compiler-progress-reader TestingScript.))
(export package-install-test)
(def producer-id "qualification.invalid/haumea/producer")
(def consumer-id "qualification.invalid/haumea/consumer")
(def (write-source path text)
  (create-directory* (path-directory path))
  (call-with-output-file (list path: path truncate: #t) (cut display text <>)))
(def (compile-events output)
  (call-with-input-string output
    (lambda (port)
      (let loop ((result '()))
        (def line (read-line port))
        (cond ((eof-object? line) (list-sort string<? result))
              ((string-prefix? "... compile " line)
               (loop (cons (substring line 12 (string-length line)) result)))
              (else (loop result)))))))
(def (product-snapshot identities directory)
  (map (lambda (path) (cons path (sha256 (call-with-input-file path read-all-as-u8vector))))
       (list-sort string<? (artifact-files identities directory #f))))
(def (index-binding-count text name)
  (def marker (string-append (string (integer->char 127)) name (string (integer->char 1))))
  (length (filter (cut string-contains <> marker) (string-split text #\newline))))
(def package-install-test
  (test-suite "Gerbil dependency install and selected owner compilation"
    (test-case "pinned thousand-owner checkout has no default owner compilation"
      (def source (.get tao3k/yuanxu.init.exports tests source))
      (def command-root (.get source source-root))
      (def inherited (string-join (load-path) ":"))
      (def build-cores (getenv "GERBIL_BUILD_CORES"))
      ;; Propagate the existing Case heap policy before any child imports.
      (def runtime-option (car (.get TestingScript. runtime-options)))
      (def runtime-environment
        (string-append (let (inherited-options (getenv "GAMBOPT" #f))
                       (if inherited-options (string-append inherited-options ",") ""))
                       (substring runtime-option 2 (string-length runtime-option))
                       ;; Relay compiler output as it is written to the pipe.
                       ",1n,2n"))
      (call-with-temporary-directory "selected-package-"
        (lambda (temporary)
          (def fixture (path-expand "fixture" temporary))
          (def installed (path-expand "installed" temporary))
          (def a (path-expand "a" temporary))
          (def b (path-expand "b" temporary))
          (def git-config (path-expand "gitconfig" temporary))
          (def remotes (path-expand "remotes" temporary))
          (create-directory remotes)
          (for-each (lambda (state) (create-directory* (path-expand "lib" state))) (list installed a b))
          (write-source git-config
            (string-append "[url \"file://" remotes "/\"]\n  insteadOf = https://qualification.invalid/haumea/\n  insteadOf = git@qualification.invalid:haumea/\n"))
          (def actions 0)
          (def (invoke command directory state (stdout-only? #f) idle-timeout: (idle-timeout 60))
            (def result
              (run-script
                (.cc (.get Ops prototypes Script)
                  command: command directory: directory timeout: 180 idle-timeout: idle-timeout
                  progress: make-compiler-progress-reader
                  environment: (.o GERBIL_PATH: state GIT_CONFIG_GLOBAL: git-config
                    GAMBOPT: runtime-environment
                    GERBIL_LOADPATH: (string-append (path-expand "lib" state) ":" inherited)))
                '() stderr-redirection: (not stdout-only?)
                output-port: (current-error-port)))
            (def output (.get result output))
            (when (ormap (lambda (marker) (string-contains output marker))
                    '("*** ERROR" "ERROR CASE" "ERROR CHECK" "ERROR HARNESS" "Heap overflow" "Stack overflow"))
              (error "package action reported failure" command output))
            (set! actions (1+ actions))
            (execution-progress! 'package-actions actions)
            output)
          (def (pkg state directory idle-timeout: (idle-timeout 60) . arguments)
            ;; Use the standard concurrency setting at the command boundary.
            ;; No local tagger override or package-manager patch participates.
            (invoke (append (list "env" (string-append "GERBIL_BUILD_CORES=" build-cores)
                                  "gerbil" "pkg") arguments) directory state idle-timeout: idle-timeout))
          (def (ordinary state directory operation)
            (invoke (if (equal? operation "use") '("gxi" "use.ss")
                        (list "./build.ss" operation)) directory state))
          (def (git directory . args) (invoke (cons "git" args) directory installed))
          (invoke (list "python3" (path-expand "dev/thousand_package_fixture.py" command-root) fixture)
                  command-root installed)
          (def producer (path-expand "producer" fixture))
          (def consumer (path-expand "package-consumer" fixture))
          (copy-file (path-expand "dev/gerbil/clean-outputs.ss" command-root)
                     (path-expand "clean-outputs.ss" consumer))
          ;; Commit only generated fixtures. User checkouts/configuration are untouched.
          (for-each
            (lambda (repository)
              (git repository "init" "-q" "-b" "main")
              (git repository "config" "user.name" "Yuanxu fixture")
              (git repository "config" "user.email" "fixture@invalid.example")
              (git repository "add" ".")
              (git repository "commit" "-qm" "Package fixture")
              (git repository "tag" "v0.1.0"))
            (list producer consumer))
          (def revision (git producer "rev-parse" "HEAD"))
          (git temporary "clone" "--bare" "-q" producer (path-expand "producer.git" remotes))
          (check-equal?
            (substring (git temporary "ls-remote" "https://qualification.invalid/haumea/producer.git" "refs/tags/v0.1.0")
                       0 40)
            (substring revision 0 40))
          ;; This public probe returns a Scheme string on stdout. Diagnostics
          ;; must stay on stderr; their scheduling cannot change the payload.
          (def package-root (call-with-input-string (invoke '("gxi" "-e" "(import (only-in :gerbil/tools/gxpkg pkg-root-dir))" "-e" "(write (pkg-root-dir)) (newline)") temporary installed #t) read))
          (def managed-consumer (path-expand consumer-id package-root))
          (create-directory* (path-directory managed-consumer))
          (git temporary "clone" "-q" "--branch" "v0.1.0" consumer managed-consumer)
          ;; Exercise the user's standard command, including its real TAGS index.
          (def install-started (real-time))
          (displayln "INSTALL-CORES " build-cores) (force-output)
          ;; gerbil pkg captures the tagger's output until indexing finishes.
          ;; The existing 180-second action deadline still bounds the install.
          (def install-output (pkg installed managed-consumer idle-timeout: #f "deps" "--install"))
          (displayln "INSTALL-WITH-TAGS seconds=" (- (real-time) install-started))
          (check-equal? (compile-events install-output) '())
          (let (index (call-with-input-file (path-expand "TAGS" package-root) read-all-as-string))
            (check-equal? (and (string-contains install-output "... tagging packages") #t) #t)
            (check-equal? (index-binding-count index "ScopeContract") 1000)
            (check-equal? (index-binding-count index "Scope.") 1000))
          (def managed-producer (path-expand producer-id package-root))
          (check-equal?
            (length (filter (lambda (name)
                              (eq? (file-info-type
                                     (file-info (path-expand name (path-expand "modules" managed-producer))))
                                   'directory))
                            (directory-files (path-expand "modules" managed-producer)))) 1000)
          (check-equal? (git managed-producer "rev-parse" "HEAD") revision)
          (check-equal? (call-with-input-file (string-append managed-producer ".tag") read) "v0.1.0")
          (def manifest (call-with-input-file (string-append managed-producer ".manifest") read))
          (check-equal? (cdr (assoc producer-id manifest)) "v0.1.0")
          (check-equal? (file-exists? (path-expand "lib/yuanxu-thousand-library/modules" installed)) #f)
          (def original-status (git managed-producer "status" "--porcelain"))
          (check-equal? original-status "")
          ;; Standard link/build supplies each environment's dependency manifest.
          ;; The producer's own default remains empty; tests manufacture none.
          (for-each (lambda (state)
                      (pkg state temporary "link" producer-id managed-producer)
                      (check-equal? (compile-events (pkg state temporary "build" producer-id)) '()))
                    (list a b))
          (def spec (call-with-input-string (ordinary a managed-consumer "spec") read))
          ;; The source view uses full native identities as Make target names.
          (def targets
            (list-sort string<? (map (lambda (target) (if (string? target) target (cadr target))) spec)))
          (check-equal? (length targets) 11)
          (for-each
            (lambda (identity)
              (unless (or (string-prefix? "yuanxu-thousand-library/modules/module-0/" identity)
                          (string-prefix? "yuanxu-thousand-library/modules/module-1/" identity)
                          (member identity '("yuanxu-package-consumer/init" "yuanxu-package-consumer/main")))
                (error "standard package compiled an unselected owner" identity))) targets)
          (check-equal? (compile-events (pkg a managed-consumer "build")) targets)
          (check-equal? (compile-events (pkg a managed-consumer "build")) '())
          (check-equal? (and (string-contains (ordinary a managed-consumer "use") "PACKAGE-USE") #t) #t)
          (check-equal? (compile-events (pkg b managed-consumer "build")) targets)
          (def identities (map string->symbol targets))
          (def b-products (product-snapshot identities (path-expand "lib" b)))
          (pkg a managed-consumer "clean")
          (check-equal? (artifact-files identities (path-expand "lib" a) #f) '())
          (check-equal? (product-snapshot identities (path-expand "lib" b)) b-products)
          (check-equal? (artifact-files identities (path-expand "lib" installed) #f) '())
          (for-each (lambda (identity)
                      (for-each (lambda (suffix)
                                  (check-equal? (file-exists? (path-expand (string-append "lib/" identity suffix) a)) #f)
                                  (check-equal? (file-exists? (path-expand (string-append "lib/" identity suffix) b)) #t)
                                  (check-equal? (file-exists? (path-expand (string-append "lib/" identity suffix) installed)) #f))
                                '(".ssi" ".o1"))) targets)
          (check-equal? (and (string-contains (ordinary b managed-consumer "use") "PACKAGE-USE") #t) #t)
          (check-equal? (git managed-producer "status" "--porcelain") original-status)
          (check-equal? (git managed-producer "rev-parse" "HEAD") revision)
          (let ()
            ;; A separate tiny standard package proves default and explicit editor
            ;; indexing still work. Never index the thousand-owner catalog here.
            (def editor-state (path-expand "editor-control" temporary))
            (create-directory* (path-expand "lib" editor-state))
            (def editor-root (call-with-input-string (invoke '("gxi" "-e" "(import (only-in :gerbil/tools/gxpkg pkg-root-dir))" "-e" "(write (pkg-root-dir)) (newline)") temporary editor-state #t) read))
            (def editor-package (path-expand "editor-source" temporary))
            (write-source (path-expand "gerbil.pkg" editor-package) "(package: tiny)\n")
            (write-source (path-expand "tagged.ss" editor-package)
              "(import :gerbil/core)\n(export Tagged)\n(def Tagged 1)\n")
            (write-source (path-expand "build.ss" editor-package)
              "#!/usr/bin/env gxi\n(import :std/build-script)\n(defbuild-script '())\n")
            (invoke (list "chmod" "+x" (path-expand "build.ss" editor-package)) editor-package editor-state)
            (git editor-package "init" "-q" "-b" "main")
            (git editor-package "config" "user.name" "Yuanxu fixture")
            (git editor-package "config" "user.email" "fixture@invalid.example")
            (git editor-package "add" ".")
            (git editor-package "commit" "-qm" "Standard editor control")
            (git editor-package "tag" "v0.1.0")
            (git temporary "clone" "--bare" "-q" editor-package (path-expand "editor-control.git" remotes))
            (def editor-consumer (path-expand "editor-consumer" temporary))
            (write-source (path-expand "gerbil.pkg" editor-consumer)
              "(package: editor-consumer depend: (\"qualification.invalid/haumea/editor-control@v0.1.0\"))\n")
            (def default-output (pkg editor-state editor-consumer "deps" "--install"))
            (check-equal? (and (string-contains default-output "... tagging packages") #t) #t)
            (def tags (path-expand "TAGS" editor-root))
            (check-equal? (and (string-contains (call-with-input-file tags read-all-as-string) "tagged.ss") #t) #t)
            (delete-file tags)
            (pkg editor-state editor-consumer "retag")
            (check-equal? (file-exists? tags) #t)
            (def previous-index (call-with-input-file tags read-all-as-string))
            (def (invalid-format command directory)
              (run-script
                (.cc (.get Ops prototypes Script)
                  command: command directory: directory timeout: 180 idle-timeout: 60
                  check-status: #f progress: make-compiler-progress-reader
                  environment: (.o GERBIL_PATH: editor-state GAMBOPT: runtime-environment
                    GERBIL_LOADPATH: inherited GERBIL_TAGS_FORMAT: "invalid-format"))))
            ;; Some Gerbil releases report the child failure without relaying
            ;; gxtags stderr. Check the standard diagnostic at its own boundary.
            (def failed (invalid-format '("gerbil" "pkg" "retag") editor-consumer))
            (check-equal? (zero? (.get failed status)) #f)
            (check-equal? (call-with-input-file tags read-all-as-string) previous-index)
            (def diagnostic (invalid-format '("gxtags" "qualification.invalid") editor-root))
            (check-equal? (zero? (.get diagnostic status)) #f)
            (check-equal?
              (if (string-contains (.get diagnostic output) "unknown TAGS index format")
                #t (.get diagnostic output))
              #t)
            (check-equal? (call-with-input-file tags read-all-as-string) previous-index)
            (check-equal? (filter (cut string-prefix? ".TAGS-" <>) (directory-files editor-root)) '()))
          (displayln "PACKAGE catalog=1000 tag=v0.1.0 install-compile=0 selected=2 targets=11 hot=0 clean-isolation=ok source=unchanged tags=complete"))))))


;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Real native entrypoints; the guarded candidate is first built in isolation.
(import :std/test :clan/poo/object
        (only-in :clan/poo/slot-observation call-with-slot-read-observer slot-read-key)
        (prefix-in (only-in :gerbil/runtime/mop slot-ref slot-set!) runtime.)
        (only-in :std/error Error? Error-message)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case))
(export mop-replay-write-guard-test test-cleanup!)
(def completed 0)
(def (reads-of receiver key)
  (def reads '())
  (call-with-slot-read-observer (lambda (read) (set! reads (cons read reads)))
    (cut .ref receiver key))
  (reverse reads))
(def (refuses action)
  (def failure (with-catch values action))
  (check-equal? (Error? failure) #t)
  (check-equal? (Error-message failure) "object mutation during read replay"))
(def mop-replay-write-guard-test
 (test-suite "Receiver-owned replay write boundary"
  (yuanxu-test-case "selected receiver mutation is refused before a first write or restoration"
    (.def Root port: 5432 unused: (error "unselected branch forced"))
    (def roots (reads-of Root 'port))
    (def revision (object-revision Root))
    (def writes 0)
    (refuses (cut replay-slot-reads! roots
      (lambda (owner key)
        (when (and (eq? owner Root) (eq? key 'port))
          (.put! Root 'port 5440)
          (set! writes (+ writes 1))
          (.put! Root 'port 5432)))))
    (check-equal? writes 0)
    (check-equal? (object-revision Root) revision)
    (check-equal? (.get Root port) 5432)
    ;; Dynamic state unwinds after the refusal.
    (.put! Root 'port 5433)
    (check-equal? (.get Root port) 5433)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "ancestor edits preflight the full affected closure before clearing any cache"
    (.def Parent port: 5432 unused: (error "unselected branch forced"))
    (def cached (.get Parent port))
    (.def (Child @ Parent) port: 5433)
    (def roots (reads-of Child 'port))
    (def parent-revision (object-revision Parent))
    (def child-revision (object-revision Child))
    (refuses (cut replay-slot-reads! roots
      (lambda (_owner _key) (.putdefault! Parent 'extra 1))))
    (check-equal? (object-revision Parent) parent-revision)
    (check-equal? (object-revision Child) child-revision)
    (check-equal? (.get Parent port) cached)
    (check-equal? (.get Child port) 5433)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "nested replay preserves outer protection and releases inner ownership"
    (.def Outer port: 5432)
    (.def Inner port: 5433)
    (def outer (reads-of Outer 'port))
    (def inner (reads-of Inner 'port))
    (def nested 0)
    (replay-slot-reads! outer
      (lambda (owner key)
        (when (and (eq? owner Outer) (eq? key 'port))
          (refuses (cut replay-slot-reads! inner
            (lambda (_owner _key) (.put! Outer 'port 5440))))
          (.put! Inner 'port 5441)
          (set! nested (+ nested 1)))))
    (check-equal? nested 1)
    (check-equal? (.get Outer port) 5432)
    (check-equal? (.get Inner port) 5441)
    (.put! Outer 'port 5442)
    (check-equal? (.get Outer port) 5442)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "unselected independent receiver writes do not impose a global freeze"
    (.def Selected port: 5432 unused: (error "unselected branch forced"))
    (.def Independent port: 5433)
    (replay-slot-reads! (reads-of Selected 'port)
      (lambda (_owner _key) (.put! Independent 'port 5440)))
    (check-equal? (.get Selected port) 5432)
    (check-equal? (.get Independent port) 5440)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "callback exceptions retain identity and release the frame"
    (.def Root port: 5432)
    (def problem (with-catch values (lambda () (error "callback sentinel"))))
    (def failure (with-catch values
      (cut replay-slot-reads! (reads-of Root 'port)
        (lambda (_owner _key) (raise problem)))))
    (check-equal? (eq? failure problem) #t)
    (.put! Root 'port 5433)
    (check-equal? (.get Root port) 5433)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "a transient miss owns its receiver without entering the read cache"
    (.def Root port: 5432 unused: (error "unselected branch forced"))
    (.get Root port)
    (def roots '())
    (call-with-slot-read-observer (lambda (read) (set! roots (cons read roots)))
      (cut .ref/cached Root 'missing (lambda () #f)))
    (check-equal? (hash-key? (object-%reads Root) '(cache-miss missing)) #f)
    (def revision (object-revision Root))
    (refuses (cut replay-slot-reads! roots
      (lambda (_owner _key) (.put! Root 'port 5440))))
    (check-equal? (object-revision Root) revision)
    (check-equal? (hash-key? (object-%instance Root) 'missing) #f)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "raw runtime mutation and restoration remains an explicit negative control"
    (.def Root port: 5432)
    (def roots (reads-of Root 'port))
    (def table (object-%reads Root))
    (def original (runtime.slot-ref table 'ref))
    (def calls 0)
    (replay-slot-reads! roots
      (lambda (owner key)
        (when (and (eq? owner Root) (eq? key 'port))
          (dynamic-wind
            (lambda () (runtime.slot-set! table 'ref
              (lambda (self key default)
                (set! calls (+ calls 1)) (original self key default))))
            (lambda () (hash-get table 'port))
            (lambda () (runtime.slot-set! table 'ref original))))))
    (check-equal? calls 1)
    (check-equal? (.get Root port) 5432)
    (set! completed (+ completed 1)))))
(def (test-cleanup!)
  (check-equal? completed 7)
  (displayln "REPLAY-WRITE-GUARD: 7 cases; raw route bypass retained"))

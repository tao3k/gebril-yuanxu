(import :std/test :clan/poo/object
        (only-in :clan/poo/mop Type. NoApplicableMethod?)
        (only-in :clan/poo/object-contract ObjectContract. diagnose)
        (only-in :std/io/tempfile call-with-temporary-directory)
        (only-in :yuanxu/module-system/source/directory module-directory-context)
        (only-in :yuanxu/module-system/source/admission call-with-module-source-operation-measurement)
        (only-in :yuanxu/module-system/source/objects make-yuanxu-module-generated-source
                 yuanxu-module-source-ref-value)
        (only-in :yuanxu/module-system/interface yuanxu-load-modules module-namespace-project))
(export namespace-projection-test)
(def ObjectScope (.cc Type. identity: 'namespace/scope .element?: object?))
(def (write-source path text)
  (create-directory* (path-directory path))
  (call-with-output-file (list path: path truncate: #t) (lambda (out) (display text out))))
(def namespace-projection-test
  (test-suite "Native POO namespaces, visibility and identity"
    (test-case "ordinary slots narrow names and preserve admitted leaf identity"
      (def world-generation "g1")
      (def reads '())
      (def forced '())
      (def (session captured)
        (yuanxu-load-modules
          (.o generation: captured module-ids: '(fleet/public fleet/secret)
              selected: '(fleet/public fleet/secret) denied-modules: '()
              locate: make-yuanxu-module-generated-source
              current?: (lambda (requested) (equal? requested world-generation))
              read-publication:
              (lambda (source)
                (def id (yuanxu-module-source-ref-value source))
                (set! reads (cons id reads))
                (.o identity: id features: (.o)
                    core: (.o requires: (.o) scope-contract: ObjectScope
                              link: (lambda (_dependencies)
                                      (set! forced (cons id forced))
                                      (.o identity: id revision: captured))))))))
      (def owner (session "g1"))
      (def source (.get owner modules fleet))
      ;; Selected ordinary slots, without inheriting hidden source names.
      (def external
        (module-namespace-project source
          (.o shown: 'public alias: 'public exposed-secret: 'secret)
          '(public)))
      (def names-only
        (.cc Type. identity: 'namespace/names
             .element?: (lambda (value)
                          (and (object? value) (equal? (.all-slots/sort value) '(alias shown))))))
      (def shape (.cc ObjectContract. extra-fields: 'delegate constraints: (list names-only)))
      (check-equal? (diagnose shape external) '())
      ;; Inheriting the entire source namespace also inherits its secret slot.
      ;; The same names-only contract rejects that shape without forcing it.
      (def too-wide (.+ source external))
      (check-equal? (.slot? too-wide 'secret) #t)
      (check-equal? (pair? (diagnose shape too-wide)) #t)
      (check-equal? reads '())
      (check-equal? forced '())
      (check-equal? (.slot? external 'exposed-secret) #f)
      (check-exception (.get external exposed-secret) NoApplicableMethod?)
      (check-exception (module-namespace-project source (.o bad: 42) '(public)) error?)
      (check-exception (module-namespace-project source (.o bad: 'public) '(missing)) error?)
      (check-equal? reads '())
      (check-equal? forced '())
      (check-equal? (.slot? external 'secret) #f)
      (check-exception (.get external secret) NoApplicableMethod?)
      (def attempted-alias (.o exposed: (.get external secret)))
      (check-exception (.get attempted-alias exposed) NoApplicableMethod?)
      (check-equal? reads '())
      (check-equal? forced '())
      (def leaf (.get external shown))
      (check-equal? (eq? leaf (.get source public)) #t)
      (check-equal? (eq? leaf (.get external alias)) #t)
      (check-equal? (list-sort string<? (map symbol->string reads)) '("fleet/public" "fleet/secret"))
      (check-equal? forced '(fleet/public))
      ;; A cached slot is not live IO. Admission stays at the original owner.
      (set! world-generation "g2")
      (check-equal? (eq? leaf (.get external shown)) #t)
      (check-exception ((.get owner admit-current)) error?)
      (def fresh (session "g2"))
      (def fresh-view (.o shown: (.get fresh modules fleet public)))
      (check-equal? (eq? leaf (.get fresh-view shown)) #f)
      (check-equal? (.get fresh-view shown revision) "g2")
      ((.get fresh admit-current)))
    (test-case "nested projections compose native branches without leaf wrappers"
      (def demands 0)
      (def leaf (.o business: 42))
      (def source (.o public: (begin (set! demands (1+ demands)) leaf)
                         private: (error "private provider must remain cold")))
      (def branch (module-namespace-project source
                    (.o command: 'public hidden-alias: 'private) '(public)))
      (def namespace (.o Lab: branch))
      (def projected (module-namespace-project namespace (.o Product: 'Lab) '(Lab)))
      (check-equal? (.all-slots/sort projected) '(Product))
      (check-equal? (.all-slots/sort (.get projected Product)) '(command))
      (check-equal? demands 0)
      (check-exception (.get projected Product hidden-alias) NoApplicableMethod?)
      (check-equal? demands 0)
      (check-equal? (eq? (.get projected Product command) leaf) #t)
      (check-equal? (.get projected Product command business) 42)
      (check-equal? demands 1))
    (test-case "productive native slots need no fixed-point loader"
      (def value (.o a: 21 b: (* 2 a)))
      (check-equal? (.get value b) 42)
      (def cyclic (.o left: right right: left))
      (check-exception (.get cyclic left) CyclicSlot?))
    (test-case "ten-thousand sparse and dense native projections"
      (def names (map (lambda (n) (string->symbol (string-append "module-" (number->string n))))
                      (iota 10000)))
      (def (probe label permitted measured?)
        (def metadata-reads 0)
        (def provider-reads 0)
        (def leaf (.o value: 5432))
        (def source (object<-fun
                      (lambda (name)
                        (unless (eq? name 'module-1) (error "unselected provider" name))
                        (set! provider-reads (1+ provider-reads)) leaf)
                      keys: names))
        (def bindings (object<-fun
                        (lambda (name) (set! metadata-reads (1+ metadata-reads)) name)
                        keys: names))
        (def view #f)
        (def times #f)
        (def stats
          (##exec-stats
            (lambda ()
              (let-values (((value phases)
                            (if measured?
                              (call-with-module-source-operation-measurement
                                (lambda () (module-namespace-project source bindings permitted)) accounting?: #f)
                              (values (module-namespace-project source bindings permitted) #f))))
                (set! view value)
                (set! times phases)))))
        (def (metric key) (cdr (assq key stats)))
        (check-equal? (length (.all-slots view)) (length permitted))
        (check-equal? metadata-reads 10000)
        (check-equal? provider-reads 0)
        (when (eq? label 'sparse)
          (check-exception (.get view module-9999) NoApplicableMethod?)
          (check-equal? provider-reads 0))
        (def cold-start (real-time))
        (def value (.get view module-1))
        (def cold (- (real-time) cold-start))
        (check-equal? (eq? value leaf) #t)
        (def hot-start (real-time))
        (def hot-result
          (let loop ((left 10000) (result #f))
            (if (zero? left) result (loop (1- left) (.get view module-1)))))
        (def hot (- (real-time) hot-start))
        (check-equal? (eq? hot-result leaf) #t)
        (check-equal? provider-reads 1)
        (displayln "NAMESPACE-PROJECTION kind=" label " measured=" measured?
                   " names=10000 rows=" (length permitted) " metadata=" metadata-reads
                   " providers=" provider-reads " construct=" (metric 'real-time)
                   " cpu=" (+ (metric 'user-time) (metric 'sys-time))
                   " vm-bytes=" (metric 'bytes-allocated)
                   " cold=" cold " hot-10000=" hot)
        (when times (displayln "NAMESPACE-PHASES kind=" label " " (hash->list times))))
      (probe 'sparse '(module-1) #f)
      (probe 'dense names #f)
      (probe 'sparse '(module-1) #t)
      (probe 'dense names #t))
    (test-case "directory leaf and branch conflict refuses before resolver"
      (call-with-temporary-directory "namespace-conflict-"
        (lambda (root)
          (write-source (path-expand "init.ss" root)
            "(yuanxu! :load-modules \"./modules\" mode: explicit rename: Lab (fleet) :fleet (child))")
          (write-source (path-expand "modules/fleet/interface.ss" root) "((unforced publication")
          (write-source (path-expand "modules/fleet/child/interface.ss" root) "((unforced publication")
          (def calls 0)
          (def context (module-directory-context (path-expand "init.ss" root) (lambda (_) (error "reader must remain cold"))))
          (def namespace ((.get context namespace) (lambda (_) (set! calls (+ calls 1)) (error "resolver must remain cold"))))
          (check-equal? (.all-slots/sort (.get namespace Lab)) '(fleet))
          (check-exception (.get namespace Lab fleet) error?)
          (check-equal? calls 0)
          (check-equal? ((.get context current?) (.get context generation)) #t))))))

(import :std/test :clan/poo/object
        (only-in :clan/poo/mop call-with-slot-read-observer slot-read-key make-slot-read replay-slot-reads!)
        (only-in :clan/poo/meta-prototype bootstrap-protocol)
        (only-in :std/error Error? Error-message)
        (only-in :yuanxu/module-system/source/admission current-module-source-observer module-source-read)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/t/qualification/service-publication/fixtures ServicesFixture write-source)
        "qualification/mop-state/snapshot.ss")
(export mop-state-snapshot-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (unless (= completed 7) (error "incomplete MOP state extraction controls" completed))
  (displayln "MOP-STATE-EXTRACTION: 7 cases completed"))
(def (recorded action)
  (def roots '())
  (call-with-slot-read-observer (lambda (read) (set! roots (cons read roots))) action)
  (reverse roots))
(def (fails-with message action)
  (def failure (with-catch values action))
  (check-equal? (Error? failure) #t)
  (check-equal? (Error-message failure) message))
(def mop-state-snapshot-test
 (test-suite "Actual MOP state extraction without producer changes"
  (yuanxu-test-case "native field reflection, shared ancestor and unselected getter"
    (def calls 0)
    (.def Shared port: (begin (set! calls (+ calls 1)) 5432)
      unused: (error "unselected branch forced"))
    (.def (Left @ Shared))
    (.def (Right @ Shared))
    (.def (Root @ [Left Right]))
    (check-equal? (.get Root port) 5432)
    (def roots (recorded (cut .get Root port)))
    (def before calls)
    (def snapshot (capture-state roots))
    (check-equal? (andmap (lambda (row) (eq? (read-view-checker row) object-read-current?))
                         (state-reads snapshot)) #t)
    (check-equal? (length (filter (lambda (row) (eq? (object-view-value row) Shared))
                                (state-objects snapshot))) 1)
    (check-equal? (and (state-closed? snapshot) #t) #t)
    (check-equal? (state-current! snapshot) #t)
    (check-equal? calls before)
    (.putslot! Shared 'port ($constant-slot-spec 5433))
    (fails-with "MOP snapshot changed" (cut state-current! snapshot))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "equal numeric values do not hide changed cached reference identity"
    (def first (string->number "100000000000000000000000000000001"))
    (def second (string->number "100000000000000000000000000000001"))
    (check-equal? (= first second) #t)
    (check-equal? (eq? first second) #f)
    (.def Root payload: first)
    (def roots (recorded (cut .get Root payload)))
    (def snapshot (capture-state roots))
    ;; Deliberate raw-cache fault injection, not a supported user assignment.
    (hash-put! (object-%instance Root) 'payload second)
    (fails-with "MOP snapshot changed" (cut state-current! snapshot))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "bootstrap remains current after clear but cold hook is exposed"
    (def hooks 0)
    (def source (.o
      (compute-precedence-list (lambda (_self next) (set! hooks (+ hooks 1)) (next)))
      (compute-slot (lambda (_self next _name) (next)))))
    (def root (bootstrap-protocol source))
    (def roots (recorded (cut .ref root 'compute-slot)))
    (def anchor (car (filter (lambda (read) (equal? (slot-read-key read) '(bootstrap compute-slot))) roots)))
    (def snapshot (capture-state (list anchor)))
    (def before hooks)
    (check-equal? (and (state-closed? snapshot) #t) #t)
    (check-equal? hooks before)
    (clear-object-cache! root)
    (check-equal? (object-read-current? anchor) #t)
    (check-equal? (object-%precedence-list root) #f)
    (fails-with "MOP snapshot changed" (cut state-current! snapshot))
    (def cold (capture-state (list anchor)))
    (check-equal? (and (state-closed? cold) #t) #f)
    (check-equal? hooks before)
    (compute-precedence-list! root)
    (check-equal? (> hooks before) #t)
    (fails-with "MOP snapshot changed" (cut state-current! cold))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "stale token rejects without rebuilding cold default metadata"
    (def calls 0)
    (.def Root port: (begin (set! calls (+ calls 1)) 5432))
    (check-equal? (.get Root port) 5432)
    (def roots (recorded (cut .get Root port)))
    (clear-object-cache! Root)
    (def before calls)
    (def snapshot (capture-state roots))
    (check-equal? (and (state-closed? snapshot) #t) #t)
    (fails-with "stale slot dependency"
      (lambda () (replay-slot-reads! roots (lambda (_receiver _key) (error "must not observe")))))
    (check-equal? calls before)
    (check-equal? (object-%precedence-list Root) #f)
    (check-equal? (state-current! snapshot) #t)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "observer rebind is an exposure and invalidates the snapshot"
    (.def Root port: 5432)
    (def roots (recorded (cut .get Root port)))
    (def snapshot (capture-state roots))
    (def calls 0)
    (parameterize ((current-module-source-observer
                    (lambda (_key _amount) (set! calls (+ calls 1)))))
      (fails-with "MOP snapshot changed" (cut state-current! snapshot))
      (check-equal? (and (state-closed? (capture-state roots)) #t) #f))
    (check-equal? calls 0)
    (check-equal? (state-current! snapshot) #t)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "unknown checker identity is observed but never executed"
    (.def Root port: 5432)
    (check-equal? (.get Root port) 5432)
    (def calls 0)
    (def foreign (make-slot-read Root 'port (object-revision Root) (object-%instance Root)
      5432 '() (lambda (_read) (set! calls (+ calls 1)) #t)))
    (def snapshot (capture-state (list foreign)))
    (check-equal? (eq? (read-view-checker (car (state-reads snapshot))) object-read-current?) #f)
    (check-equal? (and (state-closed? snapshot) #t) #f)
    (check-equal? calls 0)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "final admission retains requirements, identity and independent source checks"
    (fixture ServicesFixture)
    (def publication (.get fixture publication))
    (def Parent (.get publication value))
    (def cached (.get Parent plan))
    (def Contract (.get publication contract))
    (def Context (.get publication context))
    (check-equal? (length (.get Context contributions)) 2)
    (.def (Release @ Parent)
      config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (def receipt (.call Contract .admit Release Context))
    (check-equal? (.get receipt accepted?) #t)
    (def final (.get receipt candidate))
    (check-equal? (.get final plan postgresql port) 5433)
    (check-equal? (.get final plan gitea database-port) 5433)
    (check-equal? (eq? (.get final config) (.get final plan configuration)) #t)
    (check-equal? (.get cached postgresql port) 5432)
    (def roots (recorded (cut .get final plan gitea database-port)))
    (def snapshot (capture-state roots))
    (check-equal? (and (state-closed? snapshot) #t) #t)
    (.def (Frozen @ Release) plan: cached)
    (check-equal? (.get (.call Contract .admit Frozen Context) accepted?) #f)
    (.def (Explicit @ Release)
      config: =>.+ (.o gitea: =>.+ (.o database: =>.+ (.o port: 5432))))
    (check-equal? (.get (.call Contract .admit Explicit Context) accepted?) #f)
    (def path (path-expand "modules/services/postgresql/postgresql.json" (.get fixture root)))
    (write-source path (string-append (module-source-read path) "\n"))
    ;; Unchanged MOP metadata is NOT source currentness authority.
    (check-equal? (state-current! snapshot) #t)
    (fails-with "configuration source changed" (cut .call Contract .admit Release Context))
    (set! completed (+ completed 1)))))

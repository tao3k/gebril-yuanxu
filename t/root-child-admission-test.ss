;;; Real reader/link consumer: root-owned analysis versus guarded independent admission.
(import :std/test :std/iter :clan/poo/object
        (only-in :yuanxu/module-system/source/admission current-module-source-observer)
        (only-in :yuanxu/object-types/contracts YuanxuContract.)
        (only-in :std/error Error? Error-message)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :yuanxu/observability/testing-fixture with-yuanxu-fixture)
        (only-in :yuanxu/t/qualification/service-publication/fixtures ServicesFixture write-source))
(export root-child-admission-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (unless (= completed 1) (error "attribution incomplete"))
  (displayln "ROOT-CHILD-COMPLETE"))
(def active-boundary (make-parameter 'outside))
(def (row value) (write value) (newline))
(def (graph-current-reads phases)
  ;; Attribution refines the phase with its call site; count the whole family
  ;; while retaining the exact physical-read and matched-control assertions.
  (foldl (lambda (phase total)
           (if (or (eq? phase 'graph-current)
                   (string-prefix? "graph-current/" (symbol->string phase)))
             (+ total (hash-ref phases phase)) total))
         0 (hash-keys phases)))
(def root-child-admission-test
 (test-suite "Real admission call attribution"
  (yuanxu-test-case "three internal analyses retain observations without whole-closure certification"
   (with-yuanxu-fixture (fixture ServicesFixture)
    (def publication (.get fixture publication))
    (def Contract (.get publication contract))
    (def Context (.get publication context))
    (def selected-rows (.get Context contributions))
    (def selected-keys (map (lambda (entry) (.get entry origin key)) selected-rows))
    (check-equal? (length selected-rows) 2)
    (check-equal? (and (memq 'postgresql-port selected-keys)
                       (memq 'gitea-port selected-keys) #t) #t)
    (row (list 'SELECTED-REQUIREMENTS selected-keys))
    (def Parent (.get publication value))
    (def cached (.get Parent plan))
    (check-equal? (.get cached postgresql port) 5432)
    (def platform (.get Context .contract-obligations))
    (def current (.get Context admit-current))
    (def analyze (.get Context .responsibility-obligations))
    (def Observed
      (.cc Context
        .responsibility-obligations:
        (lambda (actual candidate)
          (parameterize ((active-boundary (.get actual identity)))
            (analyze actual candidate)))
        .contract-obligations:
        (lambda (actual candidate)
          (parameterize ((active-boundary (.get actual identity)))
            (row (list 'ENTER (active-boundary)))
            (def result (platform actual candidate))
            (row (list 'LEAVE (active-boundary)))
            result))
        admit-current:
        (lambda ()
          (parameterize ((active-boundary 'source-contract-return))
            (row '(ENTER source-contract-return))
            (def result (current))
            (row '(LEAVE source-contract-return))
            result))))
    (def (child)
      (.o (:: @ Parent)
        config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433)))))
    (def expected-callers
      '(gitea/application gitea/application source-contract-return))
    (def Warm (child))
    (def (verify evidence)
      (check-equal? (.get evidence accepted?) #t)
      (def final (.get evidence candidate))
      (check-equal? (.get final plan postgresql port) 5433)
      (check-equal? (.get final plan gitea database-port) 5433)
      (check-equal? (eq? (.get final config) (.get final plan configuration)) #t)
      (check-equal? (.get cached postgresql port) 5432)
      (def configuration (car (.get evidence responsibility-evidence)))
      (check-equal? (eq? (.get configuration candidate) (.get final config)) #t)
      (def children (.get configuration responsibility-evidence))
      (check-equal? (length children) 2)
      (for-each
        (lambda (receipt)
          (check-equal? (eq? (.get receipt candidate)
                            (.ref (.get final config) (.get receipt responsibility))) #t))
        children))
    (verify (.call Contract .admit Warm Context))
    (def measured-total #f)
    (def closure-size #f)
    (def measured-paths #f)
    (def measured-return-reads #f)
    (def measured-phases #f)
    (for (mode '(cold warm))
      (def first-path #f)
      (def groups '())
      (def total 0)
      (def guard-runs 0)
      (def guard-requests 0)
      (def all-paths (make-hash-table))
      (def phases (make-hash-table))
      (def (observe key amount)
        (when (equal? key '(publication-guard-run))
          (set! guard-runs (+ guard-runs amount)))
        (when (and (pair? key) (eq? (car key) 'publication-guard-start))
          (set! guard-requests (+ guard-requests amount)))
        (when (and (pair? key) (eq? (car key) 'file-read))
          (set! total (+ total amount))
          (hash-put! all-paths (caddr key) #t)
          (hash-put! phases (cadr key) (+ amount (hash-ref phases (cadr key) 0)))
          (when (eq? (cadr key) 'publication-current)
           (let (path (caddr key))
            (unless first-path (set! first-path path))
            (when (equal? path first-path)
              (set! groups (cons (cons (active-boundary) (box '())) groups)))
            (unless (eq? (caar groups) (active-boundary))
              (error "boundary changed within source closure"))
            (set-box! (cdar groups) (cons path (unbox (cdar groups))))))))
      (row (list 'MODE mode))
      (def evidence
        (parameterize ((current-module-source-observer observe))
          (.call Contract .admit (if (eq? mode 'cold) (child) Warm) Observed)))
      (verify evidence)
      (def ordered (reverse groups))
      (check-equal? (length ordered) 3)
      (check-equal? (map car ordered) expected-callers)
      (for-each
        (lambda (group)
          (def paths (reverse (unbox (cdr group))))
          (check-equal? (> (length paths) 0) #t)
          (def unique (make-hash-table))
          (for-each (lambda (path) (hash-put! unique path #t)) paths)
          (check-equal? (hash-length unique) (length paths))
          (check-equal? paths (reverse (unbox (cdar ordered))))
          (if closure-size (check-equal? (length paths) closure-size)
            (set! closure-size (length paths)))
          (row (list 'CLOSURE mode (car group) (length paths)))) ordered)
      (check-equal? guard-runs 3)
      (check-equal? (>= guard-requests guard-runs) #t)
      (row (list 'CURRENT-READER mode guard-runs guard-requests))
      (if measured-total (check-equal? total measured-total) (set! measured-total total))
      (if measured-paths
        (begin
          (check-equal? (hash-length all-paths) (length measured-paths))
          (check-equal? (andmap (cut hash-key? all-paths <>) measured-paths) #t))
        (set! measured-paths (hash-keys all-paths)))
      (if measured-return-reads
        (check-equal? (hash-ref phases 'return-currentness) measured-return-reads)
        (set! measured-return-reads (hash-ref phases 'return-currentness)))
      (unless measured-phases (set! measured-phases phases))
      (row (list 'TOTAL mode total))
      (for-each (lambda (phase) (row (list 'PHASE mode phase (hash-ref phases phase))))
                (hash-keys phases)))
    (def unwrapped-total 0)
    (def plain
      (parameterize ((current-module-source-observer
                       (lambda (key amount)
                         (when (and (pair? key) (eq? (car key) 'file-read))
                           (set! unwrapped-total (+ unwrapped-total amount))))))
        (.call Contract .admit (child) Context)))
    (verify plain)
    (check-equal? unwrapped-total measured-total)
    (row (list 'UNWRAPPED-TOTAL unwrapped-total))
    ;; Same source cut, same final child; explicitly opt out of internal analysis
    ;; to measure the original six guards without another runtime or snapshot.
    (def baseline-total 0)
    (def baseline-paths (make-hash-table))
    (def baseline-return-reads 0)
    (def baseline-phases (make-hash-table))
    (def Guarded (.cc Context .responsibility-obligations: platform))
    (def baseline
      (parameterize ((current-module-source-observer
                       (lambda (key amount)
                         (when (and (pair? key) (eq? (car key) 'file-read))
                           (set! baseline-total (+ baseline-total amount))
                           (hash-put! baseline-paths (caddr key) #t)
                           (hash-put! baseline-phases (cadr key)
                             (+ amount (hash-ref baseline-phases (cadr key) 0)))
                           (when (eq? (cadr key) 'return-currentness)
                             (set! baseline-return-reads (+ baseline-return-reads amount)))))))
        (.call Contract .admit (child) Guarded)))
    (verify baseline)
    ;; Each eliminated certification also avoids its one graph-current read.
    ;; Return certification and actual source reads must stay unchanged.
    (check-equal? (- (hash-ref baseline-phases 'publication-current)
                     (hash-ref measured-phases 'publication-current)) (* 3 closure-size))
    (check-equal? (- (graph-current-reads baseline-phases)
                     (graph-current-reads measured-phases)) 3)
    (check-equal? (hash-ref baseline-phases 'source) (hash-ref measured-phases 'source))
    (check-equal? (- baseline-total measured-total) (+ (* 3 closure-size) 3))
    (check-equal? (hash-length baseline-paths) (length measured-paths))
    (check-equal? (andmap (cut hash-key? baseline-paths <>) measured-paths) #t)
    (check-equal? baseline-return-reads measured-return-reads)
    (row (list 'MATCHED-CONTROL baseline-total measured-total closure-size))
    (row (list 'COMPLETE-OBSERVATIONS (length measured-paths) measured-return-reads))
    ;; A direct contextual child admission is still independently guarded.
    (def Final (.get plain candidate))
    (def ChildContract (.get Contract responsibilities config responsibilities postgresql))
    (def independent-guards 0)
    (parameterize ((current-module-source-observer
                     (lambda (key amount)
                       (when (equal? key '(publication-guard-run))
                         (set! independent-guards (+ independent-guards amount))))))
      (check-equal? (.get (.call ChildContract .admit (.get Final config postgresql) Context)
                          accepted?) #t))
    (check-equal? independent-guards 1)
    ;; Replacing the Context's platform callback cannot silently bypass it for
    ;; internal children. Explicit delegation retains the original guards.
    (def callback-contracts '())
    (def ReplacedContext
      (.cc Context .contract-obligations:
        (lambda (actual candidate)
          (set! callback-contracts (cons actual callback-contracts))
          (platform actual candidate))))
    (verify (.call Contract .admit (child) ReplacedContext))
    (check-equal? (length callback-contracts) 4)
    (write-source (path-expand "modules/services/postgresql/postgresql.json" (.get fixture root)) "{}")
    (def changed
      (with-catch values
        (lambda () (.call ChildContract .admit (.get Final config postgresql) Context))))
    (check-equal? (Error? changed) #t)
    (check-equal? (Error-message changed) "selected configuration asset changed")
    (row (list 'INDEPENDENT-SOURCE-REJECT (Error-message changed)))
    (set! completed (+ completed 1))))))

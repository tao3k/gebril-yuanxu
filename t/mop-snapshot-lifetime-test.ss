;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Real supported mutations and dynamic scopes; no production purity flags.
(import :std/test :clan/poo/object
        (only-in :clan/poo/mop call-with-slot-read-observer replay-slot-reads! slot-read-receiver)
        (only-in :std/error Error? Error-message)
        (only-in :yuanxu/module-system/source/admission current-module-source-observer module-source-read)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/t/qualification/service-publication/fixtures
                 ServicesFixture DirectoryFixture write-source)
        "qualification/mop-state/snapshot.ss")
(export mop-snapshot-lifetime-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (unless (= completed 7) (error "incomplete snapshot lifetime controls" completed))
  (displayln "MOP-SNAPSHOT-LIFETIME: 7 cases completed"))
(def (recorded action)
  (def roots '())
  (call-with-slot-read-observer (lambda (read) (set! roots (cons read roots))) action)
  (reverse roots))
(def (refuses message action)
  (def failure (with-catch values action))
  (check-equal? (Error? failure) #t)
  (check-equal? (Error-message failure) message))
(def mop-snapshot-lifetime-test
 (test-suite "Revision ABA and dynamic snapshot lifetime"
  (yuanxu-test-case "supported value ABA invalidates a shared diamond twice, not four times"
    (.def Shared port: 5432 unused: (error "unselected branch forced"))
    (.def (Left @ Shared))
    (.def (Right @ Shared))
    (.def (Root @ [Left Right]))
    (def roots (recorded (cut .get Root port)))
    (def snapshot (capture-state roots))
    (def objects (list Shared Left Right Root))
    (def before (map object-revision objects))
    (.putslot! Shared 'port ($constant-slot-spec 5433))
    (.putslot! Shared 'port ($constant-slot-spec 5432))
    (check-equal? (map object-revision objects) (map (cut + <> 2) before))
    (check-equal? (.get Root port) 5432)
    (refuses "MOP snapshot changed" (cut state-current! snapshot))
    (refuses "stale slot dependency"
      (cut replay-slot-reads! roots (lambda (_receiver _key) (error "must not observe"))))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "a receiver revision alone does not cover its observed external slot dependency"
    (.def Database port: 5432)
    (.def Application route: (.get Database port))
    (check-equal? (.get Application route) 5432)
    (def roots (recorded (cut .get Application route)))
    (def snapshot (capture-state roots))
    (def before (object-revision Application))
    (.putslot! Database 'port ($constant-slot-spec 5433))
    (check-equal? (object-revision Application) before)
    (check-equal? (andmap object-read-current? roots) #t)
    (check-equal? (.get Application route) 5432)
    (refuses "MOP snapshot changed" (cut state-current! snapshot))
    (refuses "stale slot dependency"
      (cut replay-slot-reads! roots (lambda (_receiver _key) (void))))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "supported protocol ABA also leaves a revision trace"
    (.def Root port: 5432)
    (def roots (recorded (cut .get Root port)))
    (def snapshot (capture-state roots))
    (def before (object-revision Root))
    (def protocol (.o))
    (check-equal? (object-%protocol Root) #f)
    (object-protocol-set! Root protocol)
    (object-protocol-set! Root #f)
    (check-equal? (object-%protocol Root) #f)
    (check-equal? (object-revision Root) (+ before 2))
    (refuses "MOP snapshot changed" (cut state-current! snapshot))
    (check-equal? (.get Root port) 5432)
    (def restored (object-revision Root))
    ;; Removed protocol edges remain conservative invalidation dependencies.
    (.putslot! protocol 'marker ($constant-slot-spec 'changed))
    (check-equal? (object-revision Root) (+ restored 1))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "active dependent computation vetoes the entire mutation before revision changes"
    (.def Shared port: 5432)
    (def observed '())
    (def previous (active-slot-computations))
    (.def (Child @ Shared)
      attempted: (begin
                   (set! observed (map car (active-slot-computations)))
                   (.putslot! Shared 'port ($constant-slot-spec 5433)) 'unreachable))
    (check-equal? (.get Shared port) 5432)
    (def before (map object-revision (list Shared Child)))
    (refuses "object mutation during computation" (cut .get Child attempted))
    (check-equal? (and (memq Child observed) #t) #t)
    (check-equal? (eq? (active-slot-computations) previous) #t)
    (check-equal? (map object-revision (list Shared Child)) before)
    (check-equal? (.get Shared port) 5432)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "an entry guard does not fence a later supported mutation or undo use"
    (.def Root port: 5432)
    (def roots (recorded (cut .get Root port)))
    (def captured (.get Root port))
    (def snapshot (capture-state roots))
    (check-equal? (state-current! snapshot) #t)
    ;; Deterministic callback-sized gap; no scheduler timing assumption.
    (.putslot! Root 'port ($constant-slot-spec 5433))
    (def delivered 0)
    (set! delivered (+ delivered captured))
    (check-equal? delivered 5432)
    (refuses "MOP snapshot changed" (cut state-current! snapshot))
    (refuses "stale slot dependency"
      (cut replay-slot-reads! roots (lambda (_receiver _key) (error "must not observe"))))
    (check-equal? delivered 5432)
    (check-equal? (.get Root port) 5433)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "observer ABA preserves MOP endpoints but independent admission rejects changed JSON first"
    (fixture ServicesFixture)
    (def publication (.get fixture publication))
    (def Parent (.get publication value))
    (def cached (.get Parent plan))
    (def Contract (.get publication contract))
    (def Context (.get publication context))
    (check-equal? (length (.get Context contributions)) 2)
    (.def (Release @ Parent)
      config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (def evidence (.call Contract .admit Release Context))
    (check-equal? (.get evidence accepted?) #t)
    (def final (.get evidence candidate))
    (check-equal? (.get final plan gitea database-port) 5433)
    (check-equal? (.get cached postgresql port) 5432)
    (def roots (recorded (cut .get final plan gitea database-port)))
    (def snapshot (capture-state roots))
    (def path (path-expand "modules/services/postgresql/postgresql.json" (.get fixture root)))
    (def original (module-source-read path))
    (def previous (current-module-source-observer))
    (def calls 0)
    (parameterize ((current-module-source-observer
                    (lambda (_key _amount)
                      (when (= calls 0) (write-source path (string-append original "\n")))
                      (set! calls (+ 1 calls)))))
      (refuses "MOP snapshot changed" (cut state-current! snapshot))
      (module-source-read path))
    (check-equal? (> calls 0) #t)
    (check-equal? (eq? (current-module-source-observer) previous) #t)
    (check-equal? (state-current! snapshot) #t)
    (refuses "configuration source changed" (cut .call Contract .admit final Context))
    ;; Both source and read-record state are now stale: preserve the earlier source diagnostic.
    (.putslot! (.get final config postgresql settings) 'port ($constant-slot-spec 5432))
    (refuses "MOP snapshot changed" (cut state-current! snapshot))
    (refuses "configuration source changed" (cut .call Contract .admit final Context))
    (check-equal? (.get cached postgresql port) 5432)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "exception unwinds the dynamic binding but does not roll back its file effect"
    (fixture DirectoryFixture)
    (.def Root port: 5432)
    (def snapshot (capture-state (recorded (cut .get Root port))))
    (def path (path-expand "scope.ss" (.get fixture root)))
    (write-source path "before")
    (def previous (current-module-source-observer))
    (def primary (list 'observer-interrupted))
    (def actual
      (with-catch values
        (lambda ()
          (parameterize ((current-module-source-observer
                          (lambda (_key _amount)
                            (write-source path "after") (raise primary))))
            (module-source-read path)))))
    (check-equal? (eq? actual primary) #t)
    (check-equal? (eq? (current-module-source-observer) previous) #t)
    (check-equal? (state-current! snapshot) #t)
    (check-equal? (module-source-read path) "after")
    (set! completed (+ completed 1)))))

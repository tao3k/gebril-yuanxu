(import :std/test :clan/poo/object
        (prefix-in (only-in :gerbil/runtime/mop slot-ref slot-set!) runtime.)
        (only-in :gerbil/runtime/table &raw-table-hash-set! &raw-table-test-set!)
        (only-in :std/error Error? Error-message)
        (only-in :clan/poo/mop make-slot-read slot-read-key)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case)
        (only-in "qualification/mop-state/checker-origin" recorded)
        "qualification/mop-state/metadata-route.ss")
(export mop-metadata-route-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (check-equal? completed 7)
  (displayln "METADATA-ROUTE: 7 cases completed"))
(def (refuses message action)
  (def failure (with-catch values action))
  (check-equal? (Error? failure) #t)
  (check-equal? (Error-message failure) message))
(def (port-read Root)
  (car (filter (lambda (read) (eq? (slot-read-key read) 'port))
    (recorded (cut .get Root port)))))
(def mop-metadata-route-test
 (test-suite "Selected metadata lookup route, not a production read-only seal"
  (yuanxu-test-case "cold and warm native reads pass without forcing an unselected getter"
    (def calls 0)
    (.def Root port: (begin (set! calls (+ calls 1)) 5432)
      unused: (error "unselected branch forced"))
    (def read (port-read Root))
    (check-equal? (guarded-current? read) #t)
    (check-equal? (guarded-current? (port-read Root)) #t)
    (check-equal? calls 1)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "modified wrapper ref is refused without invoking it"
    (.def Root port: 5432)
    (def read (port-read Root))
    (def calls 0)
    (runtime.slot-set! (object-%reads Root) 'ref
      (lambda (_self _key _default) (set! calls (+ calls 1)) read))
    (refuses "changed metadata ref" (cut guarded-current? read))
    (check-equal? calls 0)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "fixed ref does not hide a custom backend hash or equality function"
    (.def Root port: 5432)
    (def read (port-read Root))
    (def backend (runtime.slot-ref (object-%reads Root) 'object))
    (def original-hash (runtime.slot-ref backend 'hash))
    (def calls 0)
    (&raw-table-hash-set! backend (lambda (_key) (set! calls (+ calls 1)) 0))
    (refuses "changed metadata hash/test" (cut guarded-current? read))
    (check-equal? calls 0)
    (&raw-table-hash-set! backend original-hash)
    (&raw-table-test-set! backend (lambda (_a _b) (set! calls (+ calls 1)) #t))
    (refuses "changed metadata hash/test" (cut guarded-current? read))
    (check-equal? calls 0)
    (runtime.slot-set! (object-%reads Root) 'object (.o invalid-backend: #t))
    (refuses "foreign metadata backend" (cut guarded-current? read))
    (check-equal? calls 0)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "instance table lookup is protected independently of the reads table"
    (.def Root port: 5432)
    (def read (port-read Root))
    (def calls 0)
    (runtime.slot-set! (object-%instance Root) 'ref
      (lambda (_self _key _default) (set! calls (+ calls 1)) 5432))
    (refuses "changed metadata ref" (cut guarded-current? read))
    (check-equal? calls 0)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "an entry-only check does not protect a later call, but a fresh direct guard refuses"
    (.def Root port: 5432)
    (def read (port-read Root))
    (def calls 0)
    (check-equal? (require-read-route! read) #t)
    (runtime.slot-set! (object-%reads Root) 'ref
      (lambda (_self _key _default) (set! calls (+ calls 1)) read))
    (refuses "changed metadata ref" (cut object-read-current? read))
    (check-equal? calls 0)
    (refuses "changed metadata ref" (cut guarded-current? read))
    (check-equal? calls 0)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "restoring a method does not erase the side effect between endpoint checks"
    (.def Root port: 5432)
    (.def Victim port: 5432)
    (def read (port-read Root))
    (def table (object-%reads Root))
    (def original (runtime.slot-ref table 'ref))
    (check-equal? (require-read-route! read) #t)
    (runtime.slot-set! table 'ref
      (lambda (self key default)
        (.putslot! Victim 'port ($constant-slot-spec 5440))
        (runtime.slot-set! table 'ref original)
        (original self key default)))
    (refuses "changed metadata ref" (cut object-read-current? read))
    (refuses "changed metadata ref" (cut require-read-route! read))
    (check-equal? (.get Victim port) 5432)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "route checks preserve real transient misses but do not authenticate forged misses"
    (.def Root port: 5432)
    (.get Root port)
    (def roots (recorded (cut .ref/cached Root 'missing (lambda () #f))))
    (def read (car (filter (lambda (r) (equal? (slot-read-key r) '(cache-miss missing))) roots)))
    (check-equal? (guarded-current? read) #t)
    (def forged (make-slot-read Root '(cache-miss missing) (object-revision Root)
      (object-%instance Root) #f '() object-read-current?))
    (check-equal? (guarded-current? forged) #f)
    (set! completed (+ completed 1)))))

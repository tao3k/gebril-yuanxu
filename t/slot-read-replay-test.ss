;;; Consumer regression tests for the gerbil-poo MOP read protocol.
(import :std/test :clan/poo/object
        (only-in :std/error Error? Error-message)
        (only-in "../scenarios/gitea-postgresql/gitea/objects.ss" gitea-application)
        (only-in "../scenarios/gitea-postgresql/gitea/types.ss" ApplicationContract)
        (only-in "../scenarios/gitea-postgresql/postgresql/types.ss" Port PostgreSQLConfigContract)
        (only-in :yuanxu/configuration/json config-json-file)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/t/qualification/service-publication/fixtures
                 DirectoryFixture write-source read-overrides)
        (only-in :yuanxu/admission/source call-with-source-slot-reads)
        (only-in :clan/poo/slot-layout make-slot-cache))
(export slot-read-replay-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (unless (= completed 16) (error "incomplete slot replay qualification" completed))
  (displayln "SLOT-READ-REPLAY: 16 cases completed"))
(def (prepare workspace)
  (def root (.get workspace root))
  (def db (path-expand "postgresql.json" root))
  (def client (path-expand "gitea.json" root))
  (write-source db "{\"settings\":{\"port\":5432},\"allowed-ports\":[5432,5433]}")
  (write-source client "{\"database\":{},\"allowed-ports\":[5432,5433]}")
  (def documents-value (.o postgresql: (config-json-file db) gitea: (config-json-file client)))
  (def child-calls (box 0))
  (.def (DatabaseContract @ PostgreSQLConfigContract)
    .obligations: (lambda (_value _context)
                    (set-box! child-calls (+ 1 (unbox child-calls))) '()))
  (.def (Contract @ ApplicationContract)
    database-contract: DatabaseContract port-type: Port documents: documents-value)
  (.cc workspace documents: documents-value contract: Contract child-calls: child-calls
    parent: (gitea-application (.get documents-value postgresql value) (.get documents-value gitea value))))
(.def (ReplayFixture @ DirectoryFixture) .prepare: prepare)
(def (admit contract value) (.call contract .admit value #f))
;; Each accessor below is the public native operation, not a hand-built trace.
(def accessors
  (list (let (site (make-slot-cache 'port)) (cut .ref/inline <> site)) (cut .ref <> 'port)
        (lambda (object) (.get object port))
        (lambda (object) (with-slots (port) object port))
        (lambda (object) (match object ((.o port: value) value)))
        (lambda (object) (car ((.refs/slots '(port)) object)))
        (lambda (object) (cdr (assq 'port (.alist object))))
        (lambda (object) (cdr (assq 'port (.alist/sort object))))
        (lambda (object) (hash-ref (hash<-object object) 'port))
        (lambda (object) (.get (force-object object) port))))
(def (failure-message action)
  (def cause (with-catch values action))
  (unless (Error? cause) (error "expected refusal" cause))
  (Error-message cause))
(def slot-read-replay-test
  (test-suite "MOP cold records and warm replay"
    (yuanxu-test-fixture "parent warm, child final receiver and child obligations"
      (fixture ReplayFixture)
      (def Parent (.get fixture parent))
      (def cached (.get Parent plan))
      (check-equal? (.get cached postgresql port) 5432)
      (check-equal? (.get cached gitea database-port) 5432)
      (.def (Release @ Parent)
        config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
      (def result (admit (.get fixture contract) Release))
      (check-equal? (.get result accepted?) #t)
      (def final (.get result candidate))
      (check-equal? (.get final plan postgresql port) 5433)
      (check-equal? (.get final plan gitea database-port) 5433)
      (check-equal? (eq? (.get final config) (.get final plan configuration)) #t)
      (check-equal? (unbox (.get fixture child-calls)) 1)
      (def config-evidence (car (.get result responsibility-evidence)))
      (def database-evidence (car (.get config-evidence responsibility-evidence)))
      (check-equal? (.get database-evidence accepted?) #t)
      (check-equal? (eq? (.get database-evidence candidate)
                        (.get final config postgresql)) #t)
      (check-equal? (.get cached postgresql port) 5432)
      (.def (Frozen @ Release) plan: cached)
      (def rejected (admit (.get fixture contract) Frozen))
      (check-equal? (.get rejected accepted?) #f)
      (check-equal? (.get (car (.get rejected diagnostics)) kind) 'stale-parent-plan)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "warm hit replays a Scheme dependency without running getter"
      (fixture DirectoryFixture)
      (def path (path-expand "port.ss" (.get fixture root)))
      (write-source path "(.def Observed port: 5432)\n")
      (def origin (read-overrides path '(Observed)))
      (def calls 0)
      (def value (.o port: (begin (set! calls (+ 1 calls)) (.get origin port))))
      (check-equal? (.get value port) 5432)
      (check-equal? (call-with-source-slot-reads (cut .get value port)) 5432)
      (check-equal? calls 1)
      (write-source path "(.def Observed port: 5433)\n")
      (def failure (with-catch values (lambda () (call-with-source-slot-reads (cut .get value port)))))
      (check-equal? (Error? failure) #t)
      (check-equal? (Error-message failure) "Scheme configuration source changed")
      (check-equal? calls 1)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "changed source during child obligations refuses before return"
      (fixture ReplayFixture)
      (def path (path-expand "postgresql.json" (.get fixture root)))
      (.def (Changing @ (.get fixture contract))
        .obligations: (lambda (_candidate _context)
                        (write-source path "{}") '()))
      (def failure (with-catch values (cut admit Changing (.get fixture parent))))
      (check-equal? (Error? failure) #t)
      (check-equal? (Error-message failure) "configuration source changed")
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "full admit refuses a cached dependency on changed Scheme source"
      (fixture ReplayFixture)
      (def path (path-expand "port.ss" (.get fixture root)))
      (write-source path "(.def Observed port: 5432)\n")
      (def origin (read-overrides path '(Observed)))
      (.def (Parent @ (.get fixture parent))
        config: =>.+ (.o postgresql: =>.+
                   (.o settings: =>.+ (.o port: (.get origin port)))))
      (check-equal? (.get Parent plan postgresql port) 5432)
      (check-equal? (.get Parent plan gitea database-port) 5432)
      (check-equal? (.get (admit (.get fixture contract) Parent) accepted?) #t)
      (write-source path "(.def Observed port: 5433)\n")
      (def failure (with-catch values (cut admit (.get fixture contract) Parent)))
      (check-equal? (Error? failure) #t)
      (check-equal? (Error-message failure) "Scheme configuration source changed")
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "unselected computed sibling stays cold"
      (fixture ReplayFixture)
      (def calls 0)
      (def branches (.o selected: (.get fixture parent)
        unselected: (begin (set! calls (+ 1 calls)) (error "unselected"))))
      (check-equal? (.get (admit (.get fixture contract) (.get branches selected)) accepted?) #t)
      (check-equal? calls 0)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "explicit mismatch preserves its diagnostic path"
      (fixture ReplayFixture)
      (def path (path-expand "client-port.ss" (.get fixture root)))
      (write-source path "(.def Override database: (.o port: 5440))\n")
      (def override (read-overrides path '(Override)))
      (.def (Mismatch @ (.get fixture parent))
        config: =>.+ (.o gitea: =>.+ override))
      (def result (admit (.get fixture contract) Mismatch))
      (check-equal? (.get result accepted?) #f)
      (def issue (car (.get result diagnostics)))
      (check-equal? (.get issue kind) 'connection-mismatch)
      (check-equal? (.get issue path) '(config gitea database port))
      (check-equal? (.get issue expected-path) '(config postgresql settings port))
      (check-equal? (.get issue origin kind) 'scheme-slot)
      (check-equal? (path-strip-directory (.get issue origin source)) "client-port.ss")
      (check-equal? (.get issue origin baseline kind) 'default)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "all derived value accessors retain warm source dependencies"
      (fixture DirectoryFixture)
      (for-each
        (lambda (access)
          (def path (path-expand "accessor.ss" (.get fixture root)))
          (write-source path "(.def Observed port: 5432)\n")
          (def origin (read-overrides path '(Observed)))
          (def calls 0)
          (def value (.o port: (begin (set! calls (+ 1 calls)) (.get origin port))))
          (check-equal? (access value) 5432)
          (check-equal? (call-with-source-slot-reads (cut access value)) 5432)
          (write-source path "(.def Observed port: 5433)\n")
          (check-equal? (failure-message (cut call-with-source-slot-reads (cut access value)))
                        "Scheme configuration source changed")
          (check-equal? calls 1)) accessors)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "cached-only hit replays source without getter execution"
      (fixture DirectoryFixture)
      (def path (path-expand "cached.ss" (.get fixture root)))
      (write-source path "(.def Observed port: 5432)\n")
      (def origin (read-overrides path '(Observed)))
      (def calls 0)
      (def value (.o port: (begin (set! calls (+ 1 calls)) (.get origin port))))
      (check-equal? (.ref/cached value 'port (lambda () 'missing)) 'missing)
      (check-equal? calls 0)
      (check-equal? (.get value port) 5432)
      (check-equal? (call-with-source-slot-reads (cut .ref/cached value 'port)) 5432)
      (write-source path "(.def Observed port: 5433)\n")
      (check-equal? (failure-message
                     (cut call-with-source-slot-reads (cut .ref/cached value 'port)))
                    "Scheme configuration source changed")
      (check-equal? calls 1)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "cache absence cannot survive later cache population"
      (fixture DirectoryFixture)
      (def calls 0)
      (def target (.o port: (begin (set! calls (+ 1 calls)) 5432)))
      (def consumer (.o value: (.ref/cached target 'port (lambda () 'missing))))
      (check-equal? (.get consumer value) 'missing)
      (check-equal? calls 0)
      (check-equal? (call-with-source-slot-reads (cut .get consumer value)) 'missing)
      (check-equal? (.get target port) 5432)
      (check-equal? (failure-message (cut call-with-source-slot-reads (cut .get consumer value)))
                    "stale slot dependency")
      (check-equal? calls 1)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "presence and names observe structure without forcing fields"
      (fixture DirectoryFixture)
      (def calls 0)
      (def target (.o port: (begin (set! calls (+ 1 calls)) (error "not selected"))))
      (def consumer (.o present: (.slot? target 'port) names: (.all-slots target)))
      (check-equal? (.get consumer present) #t)
      (check-equal? (.get consumer names) '(port))
      (check-equal? (call-with-source-slot-reads (cut .get consumer names)) '(port))
      (check-equal? calls 0)
      (.putdefault! target 'extra 1)
      (check-equal? (failure-message (cut call-with-source-slot-reads (cut .get consumer present)))
                    "stale slot dependency")
      (check-equal? (failure-message (cut call-with-source-slot-reads (cut .get consumer names)))
                    "stale slot dependency")
      (check-equal? calls 0)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "native fallback retains delegate source on warm reads"
      (fixture DirectoryFixture)
      (def path (path-expand "delegate.ss" (.get fixture root)))
      (write-source path "(.def Observed port: 5432)\n")
      (def origin (read-overrides path '(Observed)))
      (def value (fallback-to (lambda () origin)))
      (check-equal? (.get value port) 5432)
      (check-equal? (call-with-source-slot-reads (cut .get value port)) 5432)
      (write-source path "(.def Observed port: 5433)\n")
      (check-equal? (failure-message (cut call-with-source-slot-reads (cut .get value port)))
                    "Scheme configuration source changed")
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "failed cold computation installs no dependency receipt"
      (fixture DirectoryFixture)
      (def calls 0)
      (def target (.o port: (begin (set! calls (+ 1 calls)) (error "cold failure"))))
      (check-equal? (failure-message (cut .get target port)) "cold failure")
      (check-equal? (.ref/cached target 'port (lambda () 'missing)) 'missing)
      (check-equal? (failure-message (cut .get target port)) "cold failure")
      (check-equal? calls 2)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "cached read keeps explicit false distinct from absence"
      (fixture DirectoryFixture)
      (def target (.o value: #f))
      (check-equal? (.ref/cached target 'value (lambda () 'missing)) 'missing)
      (check-equal? (.get target value) #f)
      (check-equal? (call-with-source-slot-reads (cut .ref/cached target 'value (lambda () 'missing))) #f)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "structural query retains MOP preparation dependencies"
      (fixture DirectoryFixture)
      (def path (path-expand "protocol.ss" (.get fixture root)))
      (write-source path "(.def Observed port: 5432)\n")
      (def origin (read-overrides path '(Observed)))
      (def calls 0)
      (def target (.o port: (begin (set! calls (+ 1 calls)) 5432)))
      (object-protocol-set! target
        (.o compute-slot:
            (lambda (_receiver next _slot) (.get origin port) (next))))
      (check-equal? (.slot? target 'port) #t)
      (check-equal? calls 0)
      (check-equal? (call-with-source-slot-reads (cut .slot? target 'port)) #t)
      (write-source path "(.def Observed port: 5433)\n")
      (check-equal? (failure-message (cut call-with-source-slot-reads (cut .slot? target 'port)))
                    "Scheme configuration source changed")
      (check-equal? calls 0)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "staged null refusal precedes derived port and child obligations"
      (fixture ReplayFixture)
      (def Parent (.get fixture parent))
      (def cached (.get Parent plan))
      (check-equal? (.get cached gitea database-port) 5432)
      (.def (Broken @ Parent)
        config: =>.+ (.o postgresql: =>.+ (.o settings: 'json-null)))
      (def result (admit (.get fixture contract) Broken))
      (check-equal? (.get result accepted?) #f)
      (check-equal? (.get (car (.get result diagnostics)) path)
                    '(config postgresql settings))
      (check-equal? (unbox (.get fixture child-calls)) 0)
      (set! completed (+ completed 1)))
    (yuanxu-test-fixture "unknown field diagnosis does not evaluate the unknown getter"
      (fixture ReplayFixture)
      (def calls 0)
      (.def (Typo @ (.get fixture parent))
        config: =>.+
        (.o postgresql: =>.+
          (.o settings: =>.+
            (.o poort: (begin (set! calls (+ 1 calls)) (error "unknown getter"))))))
      (def result (admit (.get fixture contract) Typo))
      (check-equal? (.get result accepted?) #f)
      (check-equal? (.get (car (.get result diagnostics)) kind) 'unknown-field)
      (check-equal? (.get (car (.get result diagnostics)) path)
                    '(config postgresql settings poort))
      (check-equal? calls 0)
      (check-equal? (unbox (.get fixture child-calls)) 0)
      (set! completed (+ completed 1)))))

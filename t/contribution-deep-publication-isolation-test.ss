;;; Production contribution collection, source linking and checked publication.
;;; Only source modules and fault injection are test fixtures.
(import :std/test :std/list/list :clan/poo/object
        (only-in :std/error Error? Error-message)
        (only-in :std/io/tempfile make-temporary-file-name)
        (prefix-in :clan/poo/declarative-metadata metadata.)
        (only-in :yuanxu/admission/publication AdmissionPublication.)
        (only-in :yuanxu/module-system/source/link yuanxu-load-modules)
        (only-in :yuanxu/module-system/source/admission module-source-read module-source-type)
        (only-in :yuanxu/module-system/source/objects
          make-yuanxu-module-source-ref yuanxu-module-source-ref-value))
(export contribution-deep-publication-isolation-test test-cleanup!)
(def completed 0)
(def (done!) (set! completed (+ completed 1)))
(def (test-cleanup!)
  (unless (= completed 10) (error "incomplete deep controls" completed))
  (displayln "DEEP-CONTRIBUTION-PUBLICATION: 10 cases completed"))
(def (write-source path text)
  (create-directory* (path-directory path))
  (call-with-output-file (list path: path truncate: #t) (lambda (out) (display text out))))
(def (remove-tree path)
  (if (eq? (module-source-type path) 'directory)
    (begin (for-each (lambda (name) (remove-tree (path-expand name path))) (directory-files path))
           (delete-directory path)) (delete-file path)))
(def TypesSource
  "(import :clan/poo/object (only-in :yuanxu/object-types/contracts yuanxu-predicate-contract yuanxu-predicate-type YuanxuContract. yuanxu-classification-evidence))
(def ScopeContract (yuanxu-predicate-contract 'fixture/scope object? (lambda (_v _c) '())))
(def ObjectValue (yuanxu-predicate-type 'fixture/object object?))
(def ApplicationContract
 (.cc YuanxuContract. identity: 'fixture/application value-contract: ObjectValue
  .contribution-obligations:
  (lambda (candidate rows _context)
   (def actual (.get candidate config postgresql settings port))
   (def constraints
    (map (lambda (row) (.cc (.o) value: (.get row payload value) origin: (.get row origin))) rows))
   (if (every (lambda (row) (= actual (.get row value))) constraints) '()
    (list (.cc (.o) kind: 'unsatisfied-joint-port-requirements constraints: constraints))))
  .classify: (lambda (candidate context)
   (def server (.get candidate config postgresql settings port))
   (def client (.get candidate config gitea port))
   (def issues (cond ((not (= server client)) (list (.o kind: 'connection-mismatch)))
                    ((not (and (= server (.get candidate plan server)) (= client (.get candidate plan client))))
                     (list (.o kind: 'stale-parent-plan))) (else '())))
   (yuanxu-classification-evidence 'fixture/application candidate (null? issues) issues context))))
(export ScopeContract ApplicationContract)")
(def ApplicationObjects
  "(import :clan/poo/object \"./types.ss\")
(.def (Parent @ [] config)
 config: (.o (:: @ [] postgresql) postgresql: (.o settings: (.o port: 5432))
             gitea: (.o port: (.get postgresql settings port)))
 plan: (.o server: (.get config postgresql settings port) client: (.get config gitea port)))
(def Scope (.o Scenario: Parent types: (.o Admission: ApplicationContract)))
(export Scope)")
(def PolicyObjects
  "(import :clan/poo/object \"./config.ss\")
(def Probe (vector 0))
(def Policy (.o value: (.get Config port)))
(def Scope (.o exports: (.o policy: (.o requirements:
 (.o port: Policy cold: (begin (vector-set! Probe 0 (+ 1 (vector-ref Probe 0))) (error \"cold export forced\"))))) probe: Probe))
(export Scope)")
(def (interface-source id app? (target-admission 'Scenario))
  (string-append "(.def Fixture identity: '" (symbol->string id)
   " core: (.o requires: (.o) scope-contract: ScopeContract "
   (if app? "admissions: (.o Scenario: (.o export-path: '(Scenario) contract-path: '(types Admission))) "
     (string-append "contributions: (.o database-port: (.o target-owner: 'fixture/application target-admission: '"
       (symbol->string target-admission) " export-path: '(exports policy requirements port))) "))
   "exports: (.o (:: @ Scope))) features: (.o))"))
(def (with-module-tree consume (ports '(5432 5433 5433)) (target-admission 'Scenario))
  (def root (make-temporary-file-name "deep-contribution-"))
  (dynamic-wind
   (lambda ()
    (write-source (path-expand "gerbil.pkg" root)
      (string-append "(package: " (symbol->string (gensym 'deep-fixture-)) ")"))
    (for-each
     (lambda (name port)
      (def dir (path-expand (string-append "modules/fixture/" name) root))
      (write-source (path-expand "types.ss" dir) TypesSource)
      (write-source (path-expand "config.ss" dir) (string-append "(import :clan/poo/object) (def Config (.o port: " (number->string port) ")) (export Config)"))
      (write-source (path-expand "objects.ss" dir) (if (string=? name "application") ApplicationObjects PolicyObjects))
      (write-source (path-expand "interface.ss" dir)
        (interface-source (string->symbol (string-append "fixture/" name)) (string=? name "application") target-admission)))
     '("application" "operations" "security") ports)
    (write-source (path-expand "modules/fixture/unused/interface.ss" root) "(((not readable")
    (write-source (path-expand "init.ss" root)
      "(yuanxu! mode: explicit :fixture (application) (operations) (security) (unused disable: #t))"))
   (lambda () (consume root)) (lambda () (remove-tree root))))
(def (error-message=? expected)
  (lambda (failure) (and (Error? failure) (equal? (Error-message failure) expected))))
(def (platform root)
  (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
  (def publication
    (.call AdmissionPublication. .for-export selection 'fixture/application 'Scenario))
  (.cc (.o) selection: selection publication: publication
      rows: (.get publication context contributions) parent: (.get publication value)))
(def (underlying-cause value)
 (if (metadata.failure? value) (underlying-cause (metadata.failure-cause value)) value))
(def (refused view candidate (message #f))
 (def parent (.get view parent))
 (defvalues (receipt next failure) (.call (.get view publication) .publish parent candidate))
 (check-equal? receipt #f) (check-equal? (eq? parent next) #t)
 (check-equal? (metadata.failure? failure) #t)
 (when message
   (unless ((error-message=? message) (underlying-cause failure))
     (display-exception (underlying-cause failure) (current-error-port)))
   (check-equal? ((error-message=? message) (underlying-cause failure)) #t)))
(def (check-cold view)
 (for-each (lambda (row) (check-equal? (vector-ref (.get row origin record scope probe) 0) 0)) (.get view rows))
 (check-equal? (memq 'fixture/unused (.get view selection selected-graph module-order)) #f))
(def contribution-deep-publication-isolation-test
 (test-suite "Deep exports through admitted selected records"
  (test-case "real deep record identities and lazy siblings"
   (with-module-tree (lambda (root)
    (def view (platform root)) (check-equal? (length (.get view rows)) 2)
    (check-equal?
      (eq? (.get view publication contract)
           (.get (.call (.get view selection) .selected-record 'fixture/application) scope types Admission))
      #t)
    (for-each (lambda (row)
     (check-equal? (eq? (.get row origin record)
       (.call (.get view selection) .selected-record (.get row origin owner))) #t)
     (check-equal? (.get row origin export-path) '(exports policy requirements port))
     (check-equal? (.get row payload value) 5433)
     (check-equal? (.get row origin record scope-evidence accepted?) #t)) (.get view rows))
    (check-cold view) (done!))))
  (test-case "middle revision changes with unchanged leaf must refuse"
   (with-module-tree (lambda (root)
    (def view (platform root)) (def row (car (.get view rows)))
    (def middle (.get row origin record scope exports policy requirements))
    (def leaf (.get row payload)) (.put! middle 'port leaf)
    (check-equal? (eq? (.get middle port) leaf) #t)
    (refused view (.get view parent) "contribution object changed")
    (check-cold view) (done!))))
  (test-case "omitted source and same-path replacement refuse"
   (with-module-tree (lambda (root)
    (def view (platform root)) (def selection (.get view selection)) (def rows (map values (.get view rows)))
    (def publication (.get view publication))
    (def context (.get publication context))
    ;; Fault injection is confined to tests; callers never supply these rows.
    (.put! context 'contributions (cdr rows))
    (refused view (.get view parent) "incomplete contribution collection")
    (.put! context 'contributions (list (car rows) (car rows)))
    (refused view (.get view parent) "substituted contribution origin")
    (.put! context 'contributions (map values rows))
    (def original (.get (car rows) origin))
    (def forged (.cc original source: (make-yuanxu-module-source-ref 'local
      (yuanxu-module-source-ref-value (.get original source)) '())))
    (.put! context 'contributions (cons (.cc (car rows) origin: forged) (cdr rows)))
    (refused view (.get view parent) "substituted contribution origin")
    (.put! context 'contributions (map values rows))
    ;; Context list cells must not alias the platform's private expected list.
    (set-car! (.get context contributions) (.cc (car rows) origin: forged))
    (refused view (.get view parent) "substituted contribution origin")
    (.put! context 'contributions (map values rows))
    ;; Erasing a declaration after indexing must not erase its obligation.
    (.put! (.get original publication core) 'contributions (.o))
    (refused view (.get view parent) "stale slot dependency")
    (check-cold view) (done!))))
  (test-case "real source role edit refuses selected publication"
   (with-module-tree (lambda (root)
    (def view (platform root)) (def path (path-expand "modules/fixture/operations/config.ss" root))
    (def parent (.get view parent))
    (.def (Release @ parent) config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (write-source path (string-append (module-source-read path) "\n; changed\n"))
    (refused view Release "stale prepared build source") (done!))))
  (test-case "production admission retains both incompatible port sources"
   (with-module-tree
    (lambda (root)
     (def view (platform root))
     (def parent (.get view parent))
     (.def (Release @ parent) config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
     (def publication (.get view publication))
     (def evidence (.call (.get publication contract) .admit Release (.get publication context)))
     (check-equal? (.get evidence accepted?) #f)
     (def constraints (.get (car (.get evidence obligation-evidence)) constraints))
     (check-equal? (map (lambda (row) (.get row value)) constraints) '(5433 5440))
     (check-equal? (map (lambda (row) (.get row origin owner)) constraints)
                   '(fixture/operations fixture/security))
     (refused view Release)
     (check-cold view) (done!))
    '(5432 5433 5440)))
  (test-case "incoming requirements without a domain protocol refuse at for-export"
   (with-module-tree (lambda (root)
    (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
    (def record (.call selection .selected-record 'fixture/application))
    (.put! (.get record scope types Admission) '.contribution-obligations #f)
    (check-exception
      (.call AdmissionPublication. .for-export selection 'fixture/application 'Scenario)
      (error-message=? "selected admission has contributions but no contribution protocol"))
    (done!))))
  (test-case "unknown selected admission is not silently dropped"
   (with-module-tree (lambda (root)
    (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
    (def record (.call selection .selected-record 'fixture/operations))
    (check-exception
      (.call AdmissionPublication. .for-export selection 'fixture/application 'Scenario)
      (error-message=? "contribution targets unknown selected admission"))
    (check-equal? (vector-ref (.get record scope probe) 0) 0)
    (done!)) '(5432 5433 5433) 'Missing))
  (test-case "inherited domain obligations are retained beside contributions"
   (with-module-tree (lambda (root)
    (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
    (def record (.call selection .selected-record 'fixture/application))
    (.put! (.get record scope types Admission) '.obligations
      (lambda (_candidate _context) (list (.o kind: 'domain-obligation-refused))))
    (def publication (.call AdmissionPublication. .for-export selection 'fixture/application 'Scenario))
    (def parent (.get publication value))
    (.def (Release @ parent) config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (def evidence (.call (.get publication contract) .admit Release (.get publication context)))
    (check-equal? (.get evidence accepted?) #f)
    (check-equal? (map (lambda (issue) (.get issue kind)) (.get evidence obligation-evidence))
                  '(domain-obligation-refused))
    (refused (.cc (.o) publication: publication parent: parent) Release)
    (done!))))
  (test-case "empty contributions preserve the published Contract and still fence later routes"
   (with-module-tree (lambda (root)
    (write-source (path-expand "init.ss" root) "(yuanxu! mode: explicit :fixture (application))")
    (def selection (yuanxu-load-modules (path-expand "init.ss" root)))
    (def record (.call selection .selected-record 'fixture/application))
    (def original (.get record scope types Admission))
    (.put! original '.contribution-obligations #f)
    (def publication (.call AdmissionPublication. .for-export selection 'fixture/application 'Scenario))
    (check-equal? (eq? (.get publication contract) original) #t)
    (check-equal? (.get publication context contributions) '())
    (def parent (.get publication value))
    (.def (Release @ parent) config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (defvalues (receipt next failure) (.call publication .publish parent Release))
    (check-equal? failure #f)
    (check-equal? (eq? (.get receipt admission-contract) original) #t)
    (.put! (.get record publication core) 'contributions
      (.o late: (.o target-owner: 'fixture/application target-admission: 'Scenario
                    export-path: '(Scenario))))
    (def view (.cc (.o) publication: publication parent: parent))
    (refused view Release "stale slot dependency")
    (done!))))
  (test-case "cached parent then fresh child final preview and frozen refusal"
   (with-module-tree (lambda (root)
    (def view (platform root)) (def parent (.get view parent)) (def cached (.get parent plan))
    (check-equal? (.get cached server) 5432) (check-equal? (.get cached client) 5432)
    (.def (Release @ parent) config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (defvalues (receipt next failure) (.call (.get view publication) .publish parent Release))
    (check-equal? failure #f) (check-equal? (.get receipt accepted?) #t)
    (check-equal? (eq? (.get receipt candidate) next) #t)
    (check-equal? (.get next plan server) 5433) (check-equal? (.get next plan client) 5433)
    (check-equal? (.get cached server) 5432)
    (.def (Frozen @ Release) plan: cached) (refused view Frozen)
    (check-cold view) (done!))))))

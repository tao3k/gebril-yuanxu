;;; Isolated negative controls; never import this from production.
(import :std/test :clan/poo/object
        (only-in :std/error Error? Error-message)
        (prefix-in (only-in :gerbil/runtime/mop slot-ref slot-set!) runtime.)
        (only-in :clan/poo/meta-prototype bootstrap-protocol)
        (only-in :clan/poo/slot-layout make-slot-cache)
        (only-in :clan/poo/mop make-slot-read slot-read-receiver slot-read-key
                 slot-read-revision slot-read-instance slot-read-value
                 slot-read-dependencies replay-slot-reads! %deliver-slot-read)
        (only-in :yuanxu/observability/testing-case yuanxu-test-case)
        (only-in :yuanxu/observability/testing-fixture yuanxu-test-fixture)
        (only-in :yuanxu/configuration/diagnostics config-diagnostic-locator)
        (only-in :yuanxu/module-system/source/admission module-source-read)
        (only-in :yuanxu/t/qualification/service-publication/fixtures ServicesFixture write-source)
        (only-in "qualification/mop-state/closed-tail" probe)
        (only-in "qualification/mop-state/snapshot" capture-state state-current! state-closed?)
        "qualification/mop-state/checker-origin.ss")
(export mop-checker-origin-test test-cleanup!)
(def completed 0)
(def (test-cleanup!)
  (check-equal? completed 10)
  (displayln "CHECKER-ORIGIN: 10 cases completed"))
(def (refuses message action)
  (def failure (with-catch values action))
  (check-equal? (Error? failure) #t)
  (check-equal? (Error-message failure) message))
(def (port-read roots)
  (car (filter (lambda (read) (eq? (slot-read-key read) 'port)) roots)))
(def (copy-read read checker)
  (make-slot-read (slot-read-receiver read) (slot-read-key read)
    (slot-read-revision read) (slot-read-instance read) (slot-read-value read)
    (slot-read-dependencies read) checker))
(def mop-checker-origin-test
 (test-suite "MOP checker identity and receiver ownership boundaries"
  (yuanxu-test-case "native cold and hot records remain owned without recomputation"
    (def calls 0)
    (.def Root port: (begin (set! calls (+ calls 1)) 5432)
      unused: (error "unselected branch forced"))
    (def cold (recorded (cut .get Root port)))
    (def warm (recorded (cut .ref/cached Root 'port)))
    (check-equal? (require-owned-reads! cold) #t)
    (check-equal? (require-owned-reads! warm) #t)
    (def access (make-slot-cache 'port))
    (.ref/inline Root access)
    (check-equal? (require-owned-reads! (recorded (cut .ref/inline Root access))) #t)
    (replay-slot-reads! warm (lambda (_receiver _key) (void)))
    (check-equal? calls 1)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "copying a native symbolic record does not copy its ownership"
    (.def Root port: 5432)
    (def genuine (port-read (recorded (cut .get Root port))))
    (def forged (copy-read genuine object-read-current?))
    (check-equal? (object-read-current? forged) #f)
    (refuses "unowned slot-read record" (cut require-owned-reads! (list forged)))
    (refuses "unissued slot dependency"
      (cut replay-slot-reads! (list forged) (lambda (_r _k) (void))))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "bootstrap checker success alone does not authenticate issuance"
    (def hooks 0)
    (def protocol (bootstrap-protocol
      (.o (compute-precedence-list (lambda (_self next) (next)))
          (compute-slot (lambda (_self next _name) (set! hooks (+ hooks 1)) (next))))))
    (def roots (recorded (cut .ref protocol 'compute-slot)))
    (def genuine (car (filter (lambda (read)
      (equal? (slot-read-key read) '(bootstrap compute-slot))) roots)))
    (def forged (copy-read genuine object-read-current?))
    (check-equal? (object-read-current? forged) #f)
    (refuses "unowned slot-read record" (cut require-owned-reads! (list forged)))
    (check-equal? (require-owned-reads! roots) #t)
    (check-equal? hooks 0)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "transient native misses are valid while synthetic misses lack issuance"
    (.def Root port: 5432)
    (.get Root port)
    (def genuine (recorded (cut .ref/cached Root 'missing (lambda () #f))))
    (def genuine-miss (car (filter (lambda (read)
      (equal? (slot-read-key read) '(cache-miss missing))) genuine)))
    (check-equal? (object-read-current? genuine-miss) #t)
    ;; Genuine cache-miss tokens are intentionally transient (cache?: #f).
    ;; A blanket table-membership requirement is therefore over-restrictive.
    (refuses "unowned slot-read record" (cut require-owned-reads! (list genuine-miss)))
    (def forged (make-slot-read Root '(cache-miss missing) (object-revision Root)
      (object-%instance Root) #f '() object-read-current?))
    (check-equal? (object-read-current? forged) #f)
    (refuses "unowned slot-read record" (cut require-owned-reads! (list forged)))
    (set! completed (+ completed 1)))
  (yuanxu-test-case "native replay refuses a foreign checker before calling it"
    (.def Root port: 5432)
    (.def Victim port: 5432)
    (.get Root port)
    (def calls 0)
    (def forged (make-slot-read Root 'port (object-revision Root) (object-%instance Root)
      5432 '() (lambda (_read)
        (set! calls (+ calls 1))
        (.putslot! Victim 'port ($constant-slot-spec 5440)) #t)))
    (refuses "foreign slot-read checker" (cut require-owned-reads! (list forged)))
    (check-equal? calls 0)
    (refuses "unissued slot dependency"
      (cut replay-slot-reads! (list forged) (lambda (_r _k) (void))))
    (check-equal? calls 0)
    (check-equal? (.get Victim port) 5432)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "owned root does not hide a foreign checker in its dependency graph"
    (.def External port: 5432)
    (.get External port)
    (def calls 0)
    (def forged (make-slot-read External 'port (object-revision External)
      (object-%instance External) 5432 '()
      (lambda (_read) (set! calls (+ calls 1)) #t)))
    (.def Root port: (begin (%deliver-slot-read forged #t) 5432))
    (def roots (recorded (cut .get Root port)))
    (def root-read (car (filter (lambda (read)
      (and (eq? (slot-read-receiver read) Root) (eq? (slot-read-key read) 'port))) roots)))
    (check-equal? (object-read-current? root-read) #t)
    (refuses "foreign slot-read checker" (cut require-owned-reads! roots))
    (check-equal? calls 0)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "raw record or ownership-table mutation is outside producer authenticity"
    (.def Root port: 5432)
    (def genuine (port-read (recorded (cut .get Root port))))
    (def parents (slot-read-dependencies genuine))
    ;; Topology identity means the signed sequence, not its mutable list spine.
    (runtime.slot-set! genuine 'dependencies (map values parents))
    (check-equal? (object-read-current? genuine) #t)
    (def visits 0)
    (replay-slot-reads! (list genuine genuine)
      (lambda (_receiver _key) (set! visits (+ visits 1))))
    (check-equal? visits (+ 1 (length parents)))
    ;; The same root identity with an added dependency is not a topology hit.
    ;; No callback may run before the whole graph's issuance preflight passes.
    (set! visits 0)
    (dynamic-wind
      (lambda () (runtime.slot-set! genuine 'dependencies (cons genuine parents)))
      (lambda ()
        (check-equal? (object-read-current? genuine) #f)
        (refuses "unissued slot dependency"
          (cut replay-slot-reads! (list genuine)
            (lambda (_receiver _key) (set! visits (+ visits 1)))))
        (check-equal? visits 0))
      (lambda () (runtime.slot-set! genuine 'dependencies parents)))
    ;; Each invocation needs fresh seen state; neither invocation loses delivery.
    (for-each (lambda (_round)
      (set! visits 0)
      (replay-slot-reads! (list genuine genuine)
        (lambda (_receiver _key) (set! visits (+ visits 1))))
      (check-equal? visits (+ 1 (length parents)))) '(first second))
    (def calls 0)
    (runtime.slot-set! genuine 'current? (lambda (_read) (set! calls (+ calls 1)) #t))
    (refuses "foreign slot-read checker" (cut require-owned-reads! (list genuine)))
    (check-equal? calls 0)
    ;; This deliberately corrupts internal metadata. Identity+membership is not
    ;; an unforgeable capability when its ownership table is freely writable.
    (def forged (copy-read genuine object-read-current?))
    (hash-put! (object-%reads Root) 'port forged)
    (check-equal? (require-owned-reads! (list forged)) #t)
    (check-equal? (object-read-current? forged) #f)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "actual SourceAdmissionContract rejects an injected checker before effects"
    (def sample (probe '()))
    (def candidate (.get sample candidate))
    (def dependency (.get sample external))
    (.get dependency port)
    (def calls 0)
    (def forged (make-slot-read dependency 'port (object-revision dependency)
      (object-%instance dependency) 5432 '()
      (lambda (_read)
        (set! calls (+ calls 1))
        (.putslot! dependency 'port ($constant-slot-spec 5440)) #t)))
    (def Contract (.cc (.get sample contract)
      .obligations: (lambda (_candidate _context) (%deliver-slot-read forged #t) '())))
    (refuses "unissued slot dependency" (cut .call Contract .admit candidate #f))
    (check-equal? calls 0)
    (check-equal? (.get dependency port) 5432)
    (set! completed (+ completed 1)))
  (yuanxu-test-case "fixed checker identity still depends on trusted metadata table methods"
    (.def Root port: 5432)
    (.def Victim port: 5432)
    (def genuine (port-read (recorded (cut .get Root port))))
    (def table (object-%reads Root))
    (def ref (runtime.slot-ref table 'ref))
    (def snapshot (capture-state (list genuine)))
    (def calls 0)
    ;; Raw runtime reflection fault injection, not a supported POO slot edit.
    (runtime.slot-set! table 'ref
      (lambda (self key default)
        (set! calls (+ calls 1))
        (.putslot! Victim 'port ($constant-slot-spec 5440))
        (ref self key default)))
    ;; The earlier snapshot stores this table's identity, not its method body.
    (check-equal? (state-current! snapshot) #t)
    (def snapshot-calls calls)
    (check-equal? (> snapshot-calls 0) #t)
    (refuses "changed metadata ref" (cut state-closed? snapshot))
    (refuses "changed metadata ref" (cut object-read-current? genuine))
    (check-equal? calls snapshot-calls)
    ;; The native guard cannot undo an effect already performed by the weak
    ;; experimental snapshot helper; it must not invoke that route again.
    (check-equal? (.get Victim port) 5440)
    (set! completed (+ completed 1)))
  (yuanxu-test-fixture "real services retain two requirements, child evidence, ordering and parent cache"
    (fixture ServicesFixture)
    (def publication (.get fixture publication))
    (def Parent (.get publication value))
    (def Contract (.get publication contract))
    (def Context (.get publication context))
    (def keys (map (lambda (entry) (.get entry origin key)) (.get Context contributions)))
    (check-equal? (length keys) 2)
    (check-equal? (and (memq 'postgresql-port keys) (memq 'gitea-port keys) #t) #t)
    (def cached (.get Parent plan))
    (.def (Release @ Parent)
      config: =>.+ (.o postgresql: =>.+ (.o settings: =>.+ (.o port: 5433))))
    (def analyzed #f)
    (def analyze (.get Context .contract-obligations))
    (def Observed (.cc Context .contract-obligations:
      (lambda (actual candidate)
        (def issues (analyze actual candidate))
        (when (eq? actual Contract) (set! analyzed candidate))
        issues)))
    (for-each
      (lambda (_mode)
        (def evidence (.call Contract .admit Release Observed))
        (check-equal? (.get evidence accepted?) #t)
        (check-equal? (.get analyzed plan postgresql port) 5433)
        (check-equal? (.get analyzed plan gitea database-port) 5433)
        (def children (car (.get evidence responsibility-evidence)))
        (check-equal? (eq? (.get children candidate) (.get analyzed config)) #t)
        (check-equal? (length (.get children responsibility-evidence)) 2)
        (check-equal? (require-owned-reads!
          (recorded (cut .get analyzed plan gitea database-port))) #t))
      '(cold warm))
    (.def (Mismatch @ Release)
      config: =>.+ (.o gitea: =>.+ (.o database: =>.+ (.o port: 5440))))
    (check-equal? (.get (.call Contract .admit Mismatch Context) accepted?) #f)
    (.def (Stale @ Release) plan: cached)
    (check-equal? (.get (.call Contract .admit Stale Context) accepted?) #f)
    (check-equal? (.get cached postgresql port) 5432)
    (check-equal? (eq? cached (.get Parent plan)) #t)
    (def path (path-expand "modules/services/postgresql/postgresql.json" (.get fixture root)))
    (write-source path (string-append (module-source-read path) "\n"))
    ;; Source failure is retained before a simultaneous stale-plan problem.
    (refuses "configuration source changed" (cut .call Contract .admit Stale Context))
    (set! completed (+ completed 1)))))

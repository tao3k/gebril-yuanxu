;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Native association snapshots, independently checked by the Lean decoder.
(import :std/test :clan/poo/object
        (only-in :clan/poo/mop make-slot-read slot-read-receiver slot-read-key
                 slot-read-revision slot-read-instance slot-read-value slot-read-dependencies
                 call-with-slot-read-observer replay-slot-reads! object-read-issuance)
        (prefix-in (only-in :gerbil/runtime/mop slot-ref slot-set!) runtime.)
        (only-in :std/encoding/json write-json)
        (only-in :std/error Error? Error-message))
(export issuer-projection-test test-cleanup!)
(def completed 0)
(def identities (make-hash-table-eq))
(def rows '())
(def (identity value)
  (or (hash-get identities value)
      (let (next (+ 1 (hash-length identities)))
        (hash-put! identities value next) next)))
(def (optional-identity value) (if value (identity value) 0))
(def (shape key) (list->vector (if (pair? key) (map identity key) '())))
(def (read-fields read)
  (vector (slot-read-receiver read) (slot-read-key read) (slot-read-revision read)
          (slot-read-instance read) (slot-read-value read) (slot-read-dependencies read)
          (runtime.slot-ref read 'current?)))
(def (payload fields)
  (vector (identity (vector-ref fields 0)) (identity (vector-ref fields 1))
          (vector-ref fields 2) (identity (vector-ref fields 3))
          (identity (vector-ref fields 4))
          (list->vector (map identity (vector-ref fields 5)))
          (identity (vector-ref fields 6))))
(def (recorded action)
  (def records '())
  (call-with-slot-read-observer (lambda (read) (set! records (cons read records))) action)
  (reverse records))
(def (selected records key)
  (car (filter (lambda (read) (equal? (slot-read-key read) key)) records)))
(def (copy-read read)
  (make-slot-read (slot-read-receiver read) (slot-read-key read)
    (slot-read-revision read) (slot-read-instance read) (slot-read-value read)
    (slot-read-dependencies read) object-read-current?))
(def (observe-state name read effects)
  (defvalues (presented original signed snapshot frozen-shape) (object-read-issuance read))
  (def receiver (slot-read-receiver read))
  (def key (slot-read-key read))
  (def miss? (and (pair? key) (eq? (car key) 'cache-miss)))
  (def cache-key (if miss? (cadr key) key))
  (def row
    (list->hash-table
      (list (cons 'name name) (cons 'token (identity read))
        (cons 'presented (optional-identity presented))
        (cons 'registered (optional-identity original))
        (cons 'signed-token (optional-identity signed))
        (cons 'payload (payload (read-fields read)))
        (cons 'signed-payload (if snapshot (payload snapshot) #f))
        (cons 'key-shape (shape key))
        (cons 'signed-key-shape (if frozen-shape (shape frozen-shape) '#()))
        (cons 'observed-issued (object-read-issued? read))
        (cons 'observed-current (object-read-current? read))
        (cons 'revision (object-revision receiver))
        (cons 'instance (identity (object-%instance receiver)))
        (cons 'in-read-cache (eq? read (hash-get (object-%reads receiver) key)))
        (cons 'value-cached (hash-key? (object-%instance receiver) cache-key))
        (cons 'cached-value (identity (hash-ref (object-%instance receiver) cache-key #f)))
        (cons 'miss miss?) (cons 'effects effects))))
  (set! rows (cons row rows))
  row)
(def (refuses message action)
  (def failure (with-catch values action))
  (check-equal? (Error? failure) #t)
  (check-equal? (Error-message failure) message))
(def (test-cleanup!)
  (check-equal? completed 4)
  (check-equal? (length rows) 12)
  (let (path (getenv "CORE_ISSUER_TRACE" #f))
    (when path
      (call-with-output-file (list path: path truncate: #t)
        (lambda (port) (write-json port (list->vector (reverse rows)))))))
  (displayln "ISSUER-PROJECTION: 4 cases; 12 native observations"))
(def issuer-projection-test
 (test-suite "Actual issuer association and endpoint boundaries"
  (test-case "persistent and transient native issuance expose unsigned detached copies"
    (.def Root port: 5432 unused: (error "unselected branch forced"))
    (def persistent (selected (recorded (cut .get Root port)) 'port))
    (def miss (selected (recorded (cut .ref/cached Root 'missing (lambda () #f)))
                       '(cache-miss missing)))
    (for-each (lambda (read)
      (defvalues (presented original signed snapshot _shape) (object-read-issuance read))
      (check-equal? (eq? presented original) #t)
      (check-equal? (eq? signed read) #t)
      (def unsigned (apply make-slot-read (vector->list snapshot)))
      (check-equal? (object-read-issued? unsigned) #f)
      (vector-set! snapshot 4 'changed-copy)
      (check-equal? (object-read-issued? read) #t)) (list persistent miss))
    (observe-state "persistent" persistent 0)
    (def state (observe-state "miss" miss 0))
    (check-equal? (hash-ref state 'in-read-cache) #f)
    (check-equal? (hash-ref state 'value-cached) #f)
    (replay-slot-reads! (list miss) (lambda (_r _k) (void)))
    (observe-state "unsigned-copy" (copy-read persistent) 0)
    (set! completed (+ completed 1)))
  (test-case "inspection never calls a replacement or borrowed closure"
    (.def Root port: 5432)
    (def read (selected (recorded (cut .get Root port)) 'port))
    (def birth (runtime.slot-ref read 'birth))
    (def calls 0)
    (runtime.slot-set! read 'birth (lambda args (set! calls (+ calls 1)) #t))
    (observe-state "replaced" read calls)
    (check-equal? calls 0)
    (runtime.slot-set! read 'birth birth)
    (observe-state "restored" read calls)
    (replay-slot-reads! (list read)
      (lambda (_r key)
        (when (eq? key 'port)
          (dynamic-wind
            (lambda () (runtime.slot-set! read 'birth (lambda args #t)))
            void
            (lambda () (runtime.slot-set! read 'birth birth))))))
    (observe-state "closure-callback-restored" read calls)
    (def forged (copy-read read))
    (runtime.slot-set! forged 'birth birth)
    (observe-state "borrowed" forged calls)
    (refuses "unissued slot dependency"
      (cut replay-slot-reads! (list forged) (lambda (_r _k) (error "must not observe"))))
    (runtime.slot-set! read 'value 5440)
    (observe-state "payload-edited" read calls)
    (set! completed (+ completed 1)))
  (test-case "a callback can restore metadata and retain an external effect"
    (.def Root port: 5432)
    (def read (selected (recorded (cut .get Root port)) 'port))
    (def table (object-%reads Root))
    (def original (runtime.slot-ref table 'ref))
    (def effects 0)
    (observe-state "callback-before" read effects)
    (replay-slot-reads! (list read)
      (lambda (_r key)
        (when (eq? key 'port)
          (dynamic-wind
            (lambda () (runtime.slot-set! table 'ref
              (lambda (self key default)
                (set! effects (+ 1 effects)) (original self key default))))
            (lambda () (hash-get table 'port))
            (lambda () (runtime.slot-set! table 'ref original))))))
    (check-equal? effects 1)
    (observe-state "callback-restored" read effects)
    (set! completed (+ completed 1)))
  (test-case "native receiver edits advance revision even when the value is restored"
    (.def Root port: 5432)
    (def read (selected (recorded (cut .get Root port)) 'port))
    (observe-state "revision-before" read 0)
    ;; Supported edits during replay are now refused before their first write.
    ;; Keep this independent ABA control outside the protected replay window.
    (.put! Root 'port 5433)
    (.put! Root 'port 5432)
    (refuses "stale slot dependency"
      (cut replay-slot-reads! (list read)
        (lambda (_r _key) (void))))
    (check-equal? (.get Root port) 5432)
    (observe-state "revision-restored" read 0)
    (check-equal? (object-read-issued? read) #t)
    (check-equal? (object-read-current? read) #f)
    (set! completed (+ completed 1)))))

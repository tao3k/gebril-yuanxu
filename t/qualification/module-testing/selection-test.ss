;;; Native harness cases run in a source-only copy with one real init selection.
(import (only-in "../../../init.ss" init.modules init.tests init.test-spec init.test-current! init.build-spec)
        :std/test :clan/poo/object
        (only-in :std/source this-source-file)
        (only-in :std/misc/ports read-all-as-string)
        (only-in :core/module-system/interface poo-flow-load-modules))
(export module-testing-selection-test)
(def root (path-expand "../../.." (path-directory (this-source-file))))
(def owner (string->symbol (getenv "CORE_TEST_SELECTION_OWNER" "missing")))
(def (marker module suffix)
  (path-expand (string-append (symbol->string module) suffix) root))
(def (write-text path text)
  (call-with-output-file (list path: path truncate: #t)
    (lambda (port) (display text port))))
(def module-testing-selection-test
  (test-suite "Real module init selection in a fresh process"
    (test-case "selected test list and scope use real publications; siblings stay cold"
      (unless (memq owner '(json-schema funflow))
        (error "this gate requires the isolated module-selection fixture"))
      (def other (if (eq? owner 'json-schema) 'funflow 'json-schema))
      (check-equal? (file-exists? (path-expand "testing-execution.loaded" root)) #f)
      (def modules init.modules)
      (check-equal? (eq? modules init.modules) #t)
      (check-equal? (.all-slots/sort modules)
                    (if (eq? owner 'json-schema) '(json-schema) '(funflow ops)))
      (check-equal? (.slot? modules owner) #t)
      (check-equal? (.slot? modules other) #f)
      (check-equal? (.slot? modules 'missing) #f)
      (check-equal? (.ref/cached modules owner) #f)
      (check-equal? (.ref/cached init.tests 'spec) #f)
      (check-equal? (.ref/cached init.tests 'selected-graph) #f)
      (def module (.ref init.modules owner))
      (check-equal? (.all-slots/sort module) '(identity scope tests))
      (check-equal? (.slot? module 'tests) #t)
      (check-equal? (.get module identity) owner)
      (check-equal? (.ref/cached module 'scope) #f)
      (check-equal? (.ref/cached module 'tests) #f)
      (check-equal? (file-exists? (path-expand "testing-execution.loaded" root)) #f)
      (check-equal? (file-exists? (marker owner ".scope")) #f)
      ;; Preparing a real build spec is separate from test execution import.
      (check-equal? (pair? (init.build-spec '())) #t)
      (check-equal? (file-exists? (path-expand "testing-execution.loaded" root)) #f)
      (def files (init.test-spec))
      (check-equal? (pair? files) #t)
      (check-equal? (eq? files (init.test-spec)) #t)
      (check-equal? (eq? files (.get init.tests spec)) #t)
      (check-exception (init.test-spec (list other)) error?)
      (def view (poo-flow-load-modules (path-expand "init.ss" root)))
      (check-equal? (.get view selected-graph module-order)
                    (if (eq? owner 'json-schema) '(json-schema) '(ops funflow)))
      (def scopes (.get view modules))
      (check-equal? (.slot? scopes other) #f)
      (check-equal? (.ref/cached scopes owner) #f)
      (check-equal? (file-exists? (marker owner ".scope")) #f)
      (check-equal? (file-exists? (marker other ".scope")) #f)
      (check-equal? (file-exists? (marker other ".scope")) #f)
      (check-equal? (file-exists? (marker other ".test")) #f)
      (init.test-current!))
    (test-case "Ops consumes this init test spec without a module path list"
      (def module (.ref init.modules owner))
      (def selected (.get module tests))
      (check-equal? (.get selected source-root) (.get init.tests source-root))
      (check-equal? (eq? selected (.call init.tests .select (list owner))) #t)
      (check-equal? (.ref/cached selected 'execution) #f)
      (check-equal? (file-exists? (marker owner ".scope")) #f)
      (.call (.get module tests) .run)
      (check-equal? (file-exists? (path-expand "testing-execution.loaded" root)) #t)
      (check-equal? (.ref/cached module 'scope) #f)
      (check-equal? (file-exists? (marker owner ".scope")) #f)
      (def other (if (eq? owner 'json-schema) 'funflow 'json-schema))
      (check-equal? (file-exists? (marker other ".scope")) #f)
      (check-equal? (file-exists? (marker other ".test")) #f)
      ;; Only an explicit scope demand may now link the selected business scope.
      (def scope (.get module scope))
      (check-equal? (.slot? scope (if (eq? owner 'json-schema) 'compile 'prototypes)) #t)
      (check-equal? (file-exists? (marker owner ".scope")) #t))
    (test-case "module-path execution retains native failure cleanup"
      (def tests (.get (.ref init.modules owner) tests))
      (def failed
        (.cc tests 'execution
          (.cc (.get tests execution) 'environment
            (.o CORE_MODULE_TEST_FAILURE_PROBE: "yes"))))
      (check-exception (.call failed .run) error?)
      (check-equal? (file-exists? (path-expand "failure-resource" root)) #f)
      (check-equal? (file-exists? (path-expand "failure-resource.released" root)) #t))
    (test-case "real selected test changes refuse old qualification"
      (def selected (.get (.ref init.modules owner) tests))
      (def file (car (.get selected spec)))
      (def original (call-with-input-file file read-all-as-string))
      (dynamic-wind
        (lambda () (write-text file (string-append original "\n;; selected test changed\n")))
        (lambda () (check-exception (.call selected .run) error?))
        (lambda () (write-text file original)))
      (init.test-current!))
    (test-case "reflecting the exported namespace rejects a stale init epoch"
      (def captured init.modules)
      (def path (path-expand "init.ss" root))
      (def original (call-with-input-file path read-all-as-string))
      (dynamic-wind
        (lambda () (write-text path (string-append original "\n;; changed init epoch\n")))
        (lambda ()
          (check-exception (.all-slots init.modules) error?)
          (check-exception (.slot? init.modules owner) error?)
          ;; A captured ordinary object remains a snapshot, not a live observer.
          (check-equal? (.slot? captured owner) #t))
        (lambda () (write-text path original))))))

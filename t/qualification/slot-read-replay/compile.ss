;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Compile the experiment against source, never mutate installed dependencies.
(import :gerbil/expander :gerbil/compiler (only-in :std/misc/ports read-all-as-string))
(def root (path-expand (getenv "CORE_REPLAY_ROOT")))
(def native (path-expand "source/clan/poo/" root))
(def core (path-expand (getenv "CORE_REPLAY_CORE")))
(def output (path-expand "lib" root))
(def visited (make-hash-table-eq))
(def compiled (make-hash-table))
(def changed? #f)
(def (source-text source)
  (call-with-input-file source read-all-as-string))
(def original-import (current-expander-module-import))
(def (source-for-name name)
  (cond
    ((string-prefix? "clan/poo/" name)
     (path-expand (string-append (substring name 9 (string-length name)) ".ss") native))
    ((string-prefix? "yuanxu/" name)
     (path-expand (string-append (substring name (string-length "yuanxu/") (string-length name)) ".ss") core))
    (else #f)))
(def (source-import path (reload? #f))
  (def datum (syntax-e path))
  (def name (and (symbol? datum) (symbol->string datum)))
  (def source (and name (string-prefix? ":" name)
                  (source-for-name (substring name 1 (string-length name)))))
  (original-import (if (and source (file-exists? source)) source path) reload?))
(def (visit value)
  (cond
    ((module-import? value) (visit (module-import-source value)))
    ((module-export? value) (visit (module-export-context value)))
    ((import-set? value) (visit (import-set-source value)))
    ((and (module-context? value) (not (hash-key? visited value)))
     (hash-put! visited value #t)
     (for-each visit (module-context-import value))
     (def id (expander-context-id value))
     (def source (and (symbol? id) (source-for-name (symbol->string id))))
     (when (and source (file-exists? source) (not (hash-key? compiled source)))
       (hash-put! compiled source #t)
       (let* ((checkpoint (path-expand (string-append (symbol->string id) ".qualification-source") output))
              (binary (path-expand (string-append (symbol->string id) ".o1") output))
              (text (string-append (source-text source)
                      (if (eq? id 'clan/poo/object)
                        (source-text (path-expand "dependency-source.sha256" root)) "")))
              (unchanged? (and (not changed?) (file-exists? binary)
                               (file-exists? checkpoint)
                               (equal? text (call-with-input-file checkpoint read)))))
         (unless unchanged?
           (set! changed? #t)
           (displayln "COMPILE " id) (force-output)
           (compile-module source [output-dir: output invoke-gsc: #t keep-scm: #t])
           (execute-pending-compile-jobs!)
           ;; Only successful native modules receive a resumable checkpoint.
           (call-with-output-file (list path: checkpoint truncate: #t)
             (cut write text <>))))))))
(parameterize ((current-expander-context (make-top-context))
               (current-expander-module-import source-import))
  (cond
    ((getenv "CORE_REPLAY_COMPILE_FILE" #f)
     => (lambda (source) (visit (core-import-module source))))
    ((string=? (getenv "CORE_REPLAY_OBJECT_ONLY" "") "yes")
     (visit (core-import-module (path-expand "object.ss" native))))
    (else (for-each (lambda (name) (visit (core-import-module (path-expand name core))))
      '("module-system/source/module-prelude.ss"
        "t/slot-read-replay-test.ss"
        "t/source-admission-test.ss"
        "t/source-observation-test.ss"
        "scenarios/gitea-postgresql/tests/config-test.ss")))))

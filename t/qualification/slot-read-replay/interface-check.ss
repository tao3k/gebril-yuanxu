;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Only disjoint aliases WITHIN one unchanged imported module may permute.
;;; Export, layout, macro, module order and every other form must remain exact.
(import :gerbil/core)
(def root (getenv "CORE_REPLAY_ROOT"))
(def (read-forms path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((rows '()))
        (let (row (read port))
          (if (eof-object? row) (reverse rows) (loop (cons row rows))))))))
(def (distinct? rows)
  (or (null? rows)
      (and (not (member (car rows) (cdr rows))) (distinct? (cdr rows)))))
(def (aliases=? left right)
  (and (= (length left) (length right))
       (andmap (lambda (row) (and (list? row) (= (length row) 4))) left)
       (andmap (lambda (row) (and (list? row) (= (length row) 4))) right)
       (distinct? (map (lambda (row) (list (car row) (cadr row))) left))
       (distinct? (map (lambda (row) (list (car row) (cadr row))) right))
       (distinct? left) (distinct? right)
       (andmap (cut member <> right) left)))
(def (import-row=? left right)
  (if (and (pair? left) (pair? right)
           (eq? (car left) 'spec:) (eq? (car right) 'spec:))
    (and (equal? (cadr left) (cadr right))
         (aliases=? (cddr left) (cddr right)))
    (equal? left right)))
(def (body-row=? left right)
  (if (and (pair? left) (pair? right)
           (eq? (car left) '%#import) (eq? (car right) '%#import))
    (and (= (length left) (length right))
         (andmap values (map import-row=? (cdr left) (cdr right))))
    (equal? left right)))
(def (top-row=? left right)
  (if (and (pair? left) (pair? right)
           (eq? (car left) '%#begin) (eq? (car right) '%#begin))
    (and (= (length left) (length right))
         (andmap values (map body-row=? (cdr left) (cdr right))))
    (equal? left right)))
(def before (read-forms (path-expand "object-before.ssi" root)))
(def after (read-forms (path-expand "lib/clan/poo/object.ssi" root)))
(unless (and (= (length before) (length after))
             (andmap values (map top-row=? before after)))
  (error "native interface changed beyond disjoint import-alias order"))
;; Negative controls: changed binding and module order cannot be normalized away.
(when (or (body-row=? '(%#import (spec: (:a) (0 x 0 x)))
                     '(%#import (spec: (:a) (0 x 0 y))))
          (body-row=? '(%#import :a :b) '(%#import :b :a))
          (aliases=? '((0 x 0 x) (0 x 0 x)) '((0 x 0 x) (0 y 0 y)))
          (aliases=? '((0 x 0 a) (0 x 0 b)) '((0 x 0 b) (0 x 0 a))))
  (error "interface comparison control failed"))
(displayln "NATIVE-BINDINGS-UNCHANGED")

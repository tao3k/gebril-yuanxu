(import :yuanxu-thousand-consumer/main :yuanxu-thousand-consumer/init
        (only-in :clan/poo/object .get .all-slots/sort .ref/cached .call .put!)
        (only-in :tao3k/yuanxu/module-system/source/admission current-module-source-observer))
(def selected-owners
  '(yuanxu-thousand-library/modules/module-0/interface
    yuanxu-thousand-library/modules/module-1/interface))
(def factories (make-hash-table-eq))
(def declarations 0)
(def (observe key amount)
  (when (eq? (if (pair? key) (car key) key) 'publication-start)
    (set! declarations (+ declarations amount)))
  (when (and (pair? key) (eq? (car key) 'link-stage-start)
             (pair? (cadr key)) (eq? (caadr key) 'scope-factory))
    (hash-update! factories (cadadr key) (cut + <> amount) 0)))
(def window
  (parameterize ((current-module-source-observer observe))
    (def namespace (.get yuanxu-thousand-consumer.init.exports Corpus))
    (unless (equal? (.all-slots/sort namespace) '(module-0 module-1)) (error "wrong namespace"))
    namespace))
(unless (and (zero? declarations) (zero? (hash-length factories))
             (not (.ref/cached window 'module-0)) (not (.ref/cached window 'module-1)))
  (error "namespace enumeration forced a declaration or scope"))
(def initial (parameterize ((current-module-source-observer observe)) (selected-plan)))
(unless (equal? initial '(5432)) (error "wrong selected value"))
(unless (and (zero? declarations) (= (hash-length factories) 2)
             (andmap (lambda (owner) (eqv? (hash-get factories owner) 1)) selected-owners))
  (error "first business demand differs from the selected closure" declarations (hash->list factories)))
(def graph
  (parameterize ((current-module-source-observer observe))
    (.get yuanxu-thousand-consumer.init.exports tests selected-graph)))
(unless (equal? (.get graph module-order) selected-owners)
  (error "test projection differs from the business closure"))
(def leaf (.get window module-1))
(unless (and (eq? leaf (.get window module-1)) (eq? initial (selected-plan)))
  (error "standard memoized identity lost"))
(unless (eq? (.get (.get yuanxu-thousand-consumer.init.exports Corpus module-1) config)
             (.get yuanxu-thousand-consumer.init.exports Corpus module-1 config))
  (error "nested standard .get changed config identity"))
(.put! (.get leaf config) 'port 5440)
(def revised (selected-plan))
(def computations (.call leaf computations))
(unless (and (equal? revised '(5440)) (= computations 2))
  (error "standard functional value did not recompute" revised computations
         (.get leaf config port)))
(unless (not (.ref/cached leaf 'unselected)) (error "unselected business value forced"))
((.get graph admit-current))
(displayln "THOUSAND-USE scopes=2 declarations=0 cold-enumeration=0 first-get=ok factories-once=ok hot-identity=ok incremental=ok currentness=ok")

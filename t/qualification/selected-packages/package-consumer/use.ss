(import :yuanxu-package-consumer/main :yuanxu-package-consumer/init
        (only-in "../producer/init.ss" yuanxu-thousand-library.init.exports)
        (only-in :clan/poo/object .get .all-slots/sort .ref/cached)
        (only-in :tao3k/yuanxu/module-system/source/admission current-module-source-observer))
;; The producer's actual yuanxu! window owns the logical catalog. No nested
;; gerbil.pkg or editor-TAGS export invents membership or forces leaf scopes.
(def producer-window (.get yuanxu-thousand-library.init.exports modules))
(unless (and (= (length (.all-slots/sort producer-window)) 1000)
             (andmap (lambda (name) (not (.ref/cached producer-window name)))
                     (.all-slots/sort producer-window)))
  (error "producer's declared window index forced a business scope"))
(def window (.get yuanxu-package-consumer.init.exports modules))
(unless (and (equal? (.all-slots/sort window) '(module-0 module-1))
             (not (.ref/cached window 'module-0)) (not (.ref/cached window 'module-1)))
  (error "namespace import/enumeration forced scopes"))
(def factories (make-hash-table-eq))
(def declarations 0)
(def (observe key count)
  (when (eq? (if (pair? key) (car key) key) 'publication-start)
    (set! declarations (+ declarations count)))
  (when (and (pair? key) (eq? (car key) 'link-stage-start)
             (pair? (cadr key)) (eq? (caadr key) 'scope-factory))
    (hash-update! factories (cadadr key) (cut + <> count) 0)))
(def result (parameterize ((current-module-source-observer observe)) (selected-plan)))
(unless (and (equal? result '(5432)) (zero? declarations)
             (= (hash-length factories) 2)
             (= (hash-ref factories 'module-0) 1) (= (hash-ref factories 'module-1) 1)
             (eq? result (selected-plan)))
  (error "standard package selection differs from its owner closure"))
((.get yuanxu-package-consumer.init.exports tests selected-graph admit-current))
(displayln "PACKAGE-USE catalog-index=1000 declarations=0 scopes=2 identity=ok currentness=ok")

;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Metadata-only paired measurement; never reads or materializes publications.
(import :clan/poo/object :std/encoding/json
        (only-in :gerbil/expander current-expander-context make-top-context eval-syntax)
        (only-in :tao3k/yuanxu/module-system/source/directory module-directory-context)
        (only-in :tao3k/yuanxu/module-system/source/admission current-module-source-observer)
        (only-in :tao3k/yuanxu/observability/memory yuanxu-debug-cpu-microseconds))
(def (record fields) (list->hash-table fields))
(def (main root implementation repetitions)
  (def constructor
    (if (equal? implementation "candidate") module-directory-context
      (parameterize ((current-expander-context (make-top-context)))
        (eval-syntax '(import :gerbil/core))
        (unless (and (> (string-length implementation) 0) (char=? (string-ref implementation 0) #\:))
          (error "compiled library reference required for matched standard benchmark"))
        (eval-syntax `(import (only-in ,(string->symbol implementation) module-directory-context)))
        (eval-syntax 'module-directory-context))))
  (def n (string->number repetitions))
  (unless (and (exact-integer? n) (> n 0) (<= n 10)) (error "bounded sample count required"))
  (def (trial observed?)
    (def rows 0)
    (def resolutions 0)
    (def declarations 0)
    (parameterize ((current-module-source-observer
                    (and observed? (lambda (key count)
                      (when (eq? key 'namespace-declaration-rows) (set! rows (+ rows count)))))))
      (def cpu (yuanxu-debug-cpu-microseconds))
      (def started (real-time))
      (def context (constructor (path-expand "init.ss" root)
                      (lambda (_) (set! declarations (+ declarations 1)) (error "publication must remain cold"))))
      (def constructed (real-time))
      (def expected (make-hash-table-eq))
      (for-each (lambda (id)
                  (def parts (string-split (symbol->string id) #\/))
                  (unless (= (length parts) 2) (error "two-level benchmark corpus required"))
                  (hash-put! expected (string->symbol (car parts))
                    (cons (cadr parts) (hash-ref expected (string->symbol (car parts)) '()))))
                (.get context selected))
      (def namespace ((.get context namespace)
                       (lambda (_) (set! resolutions (+ resolutions 1)) (error "provider must remain cold"))))
      (def mounted (.get namespace Lab))
      (def keys (.all-slots/sort mounted))
      (def leaves 0)
      (for-each (lambda (key)
                  (def leaf-names (map symbol->string (.all-slots (.ref mounted key))))
                  (unless (equal? (list-sort string<? leaf-names) (list-sort string<? (hash-ref expected key)))
                    (error "branch suffixes differ from declared paths" key))
                  (set! leaves (+ leaves (length leaf-names)))) keys)
      (def indexed (real-time))
      (def branch (.ref mounted (car keys)))
      (let loop ((remaining 10000))
        (unless (zero? remaining)
          (unless (eq? branch (.ref mounted (car keys))) (error "warm branch identity changed"))
          (loop (- remaining 1))))
      (def warmed (real-time))
      (def used-cpu (- (yuanxu-debug-cpu-microseconds) cpu))
      (unless (and (= leaves (length (.get context selected)))
                   (zero? declarations) (zero? resolutions)
                   ((.get context current?) (.get context generation)))
        (error "metadata benchmark semantic/currentness control failed"))
      (record (list (cons "selected" leaves) (cons "groups" (length keys))
                    (cons "declaration_rows" rows) (cons "provider_calls" resolutions)
                    (cons "publication_reads" declarations)
                    (cons "construct_ms" (* 1000 (- constructed started)))
                    (cons "branches_ms" (* 1000 (- indexed constructed)))
                    (cons "warm_10000_ms" (* 1000 (- warmed indexed)))
                    (cons "cpu_us" used-cpu)))))
  ;; Counters have their own run. Timed samples disable the diagnostic observer.
  (def counted (trial #t))
  (def samples
    (let loop ((remaining n) (results '()))
      (if (zero? remaining) (reverse results)
        (begin (##gc) (loop (- remaining 1) (cons (trial #f) results))))))
  (write-json (current-output-port) (record (list (cons "implementation" implementation)
                           (cons "counted" counted) (cons "samples" (list->vector samples)))))
  (newline))

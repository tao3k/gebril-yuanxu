;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Read-only census of already surviving records. Never demand a runtime slot.
(import :clan/poo/object
        (only-in :std/list/list take)
        (only-in :std/string/symbol symbol<?)
        (only-in :clan/poo/slot-observation slot-read-key slot-read-receiver slot-read-value)
        (only-in :clan/poo/mop Class. Slot. Type.)
        (only-in :clan/poo/method-combination Contribution.)
        (only-in :tao3k/yuanxu/object-types/contracts YuanxuClassificationEvidence YuanxuValidationEvidence)
        (only-in :tao3k/yuanxu/observability/output yuanxu-write-observation-line!)
        (only-in :gerbil/expander expander-context? expander-context-id expander-context-table)
        (only-in :gerbil/runtime/mop type-field-list)
        (only-in :gerbil/runtime/table raw-table? &raw-table-table &raw-table-count)
        (only-in :gerbil/runtime/interface interface-instance? interface-instance-object)
        (rename-in (only-in :gerbil/runtime/gambit table?) (table? gambit-table?)))
(export report-retained-reads)
(extern namespace: clan/poo/method-combination registered-contribution)

;; Installed runtime metadata, not a guessed positional table layout. Unknown
;; fields remain unknown. These reads invoke no table hashing or iteration.
(def (record-field value name)
  (and (##structure? value)
    (let loop ((names (type-field-list (##structure-type value))) (offset 1))
      (cond ((null? names) #f)
            ((eq? name (car names)) (##structure-ref value offset (##structure-type value) #f))
            (else (loop (cdr names) (1+ offset)))))))

;; The qualified installed arm64 VM uses 8-byte words and 4-byte characters.
;; Count actual runtime body fields; exclude headers/padding and opaque leaves.
;; This is ABI-specific payload accounting, not portable allocator statistics.
(def (object-body-bytes value)
  (cond ((pair? value) 16)
        ((vector? value) (* 8 (vector-length value)))
        ((string? value) (* 4 (string-length value)))
        ((##closure? value) (* 8 (##closure-length value)))
        ((##structure? value) (* 8 (##structure-length value)))
        (else 0)))

;; Identity union of actual read bodies and already allocated receiver-local
;; metadata/specification payload. POO referents, Gerbil expander contexts,
;; type descriptors and GC tables are frontiers. Do not scan compiler globals.
;; This is a bounded BODY-byte census, not dominator/exclusive heap attribution.
(def (payload-bytes reads owners (environments? #f))
  (def seen (make-hash-table-eq))
  (def frontiers (make-hash-table-eq))
  (def bytes 0)
  (def shells 0)
  (def body-kinds (make-hash-table-eq))
  (def structure-kinds (make-hash-table-eq))
  (def specification-roots (make-hash-table-eq))
  (def specification-references 0)
  (def self-specifications (make-hash-table-eq))
  (def self-fields (make-hash-table-eq))
  (def string-groups (make-hash-table))
  (def duplicate-string-bytes 0)
  (def source-strings (make-hash-table-eq))
  (def string-origins (make-hash-table-eq))
  (def source-bodies (make-hash-table))
  (def large-captures '())
  (def route '())
  ;; Use ORIGINAL read values to identify source bytes, never reread a file or
  ;; demand a prepared object's source-inputs slot for the diagnostic.
  (for-each
    (lambda (read)
      (when (eq? (slot-read-key read) 'source-inputs)
        (for-each (lambda (entry)
                    (when (and (pair? entry) (string? (car entry)) (string? (cdr entry)))
                      (hash-put! source-strings (cdr entry) (car entry))))
                  (slot-read-value read)))) reads)
  (def receiver-frontiers (make-hash-table-eq))
  (def frontier-kinds (make-hash-table-eq))
  (def table-identities (make-hash-table-eq))
  (def table-policies (make-hash-table-eq))
  (def table-entries (make-hash-table-eq))
  (def table-layouts (make-hash-table-eq))
  (def table-backing-slots 0)
  (def unknown-table-sizes 0)
  (def contexts (make-hash-table-eq))
  (def context-bindings 0)
  (def code-families (make-hash-table-eq))
  (def code-references 0)
  ;; Fingerprint the actual runtime binder's entry code, not its shared module
  ;; parent. These private samples capture constants only and call no getter.
  (def binder-code (make-hash-table-eq))
  (for-each
    (lambda (entry)
      (let (sample (apply-slot-spec #f (cdr entry) #f))
        (when (##closure? sample)
          (hash-put! binder-code (##closure-ref sample 0) (car entry)))))
    (list (cons 'bound-constant ($constant-slot-spec #f))
          (cons 'bound-self ($self-slot-spec values))
          (cons 'bound-computed ($computed-slot-spec values))))
  (def binder-counts (make-hash-table-eq))
  (def binder-paths (make-hash-table-eq))
  (def binder-demand (make-hash-table-eq))
  ;; Closure bodies and captured referents are different retention owners.
  ;; Count each direct referent once PER family; do not add these overlapping
  ;; family unions to the whole payload union or call them exclusive bytes.
  (def binder-bodies (make-hash-table-eq))
  (def binder-captures (make-hash-table-eq))
  (def (capture-kind value)
    (cond ((object? value) 'receiver)
          ((expander-context? value) 'language-context)
          ((procedure? value) 'procedure)
          ((pair? value) 'pair) ((vector? value) 'vector)
          ((string? value) 'string)
          ((##structure? value) (##type-id (##structure-type value)))
          (else 'immediate)))
  (def (binder! value kind)
    (hash-update! binder-bodies kind (cut + <> (object-body-bytes value)) 0)
    (def captured (or (hash-get binder-captures kind)
      (let (table (make-hash-table-eq)) (hash-put! binder-captures kind table) table)))
    (let loop ((index 1))
      (when (< index (##closure-length value))
        (hash-update! captured (##closure-ref value index) 1+ 0)
        (loop (1+ index)))))
  (def (binder-summary)
    (map (lambda (entry)
      (def rows (make-hash-table-eq))
      (hash-for-each (lambda (value occurrences)
        (def kind (capture-kind value))
        ;; identity count / capture edges / direct body bytes. A body referenced
        ;; 1000 times is charged once here, with all 1000 edges still reported.
        (def row (or (hash-get rows kind) (vector 0 0 0)))
        (vector-set! row 0 (1+ (vector-ref row 0)))
        (vector-set! row 1 (+ occurrences (vector-ref row 1)))
        (vector-set! row 2 (+ (object-body-bytes value) (vector-ref row 2)))
        (hash-put! rows kind row)) (cdr entry))
      (list (car entry) (hash-get binder-bodies (car entry)) (hash->list rows)))
      (hash->list binder-captures)))
  (def stage 'start)
  (def issuer-code (make-hash-table-eq))
  (for-each
    (lambda (read)
      (defvalues (_shown original _signed _snapshot _shape) (object-read-issuance read))
      (when (and original (##closure? original))
        ;; Origin grouping only: identical entry code never grants issuance to
        ;; another record/factory. Authentication still uses the real registry.
        (hash-put! binder-code (##closure-ref original 0) 'issued-read-birth)
        (hash-put! issuer-code (##subprocedure-parent (##closure-ref original 0)) #t))) reads)
  (def (gc-wrapper? value)
    (and (##structure? value) (##structure-instance-of? value 'gerbil#__gc-table::t)))
  (def (table! value)
    (unless (hash-key? table-identities value)
      (hash-put! table-identities value #t)
      (when (##structure? value)
        (hash-put! table-layouts (##type-id (##structure-type value))
          (type-field-list (##structure-type value))))
      (let* ((raw? (raw-table? value))
             (backing (cond (raw? (&raw-table-table value))
                            ((gc-wrapper? value)
                             (##structure-ref value 1 (##structure-type value) #f))
                            (else (record-field value 'gcht))))
             (flags (cond (raw? 0)
                          ((gc-wrapper? value)
                           ;; _gambit#.scm documents object-vector flags at 1.
                           (##unchecked-structure-ref backing 1 #f #f))
                          (else (record-field value 'flags))))
             (policy (if (fixnum? flags)
                       (case (bitwise-and flags 3)
                         ((0) 'strong) ((1) 'weak-keys)
                         ((2) 'weak-values) ((3) 'weak-both)) 'unknown)))
        (hash-update! table-policies policy 1+ 0)
        ;; Gerbil owns its raw count accessor. Installed _gambit#.scm:671
        ;; defines count at slot 2 for the other two representations' gcht.
        ;; Hash iteration could rehash and cross the read-only boundary.
        (when backing
          (let (count (if raw? (&raw-table-count value)
                         (##unchecked-structure-ref backing 2 #f #f)))
            (unless (and (fixnum? count) (>= count 0))
              (error "unqualified GC table count layout" count))
            (hash-update! table-entries policy (cut + <> count) 0)))
        (cond ((vector? backing) (set! table-backing-slots (+ table-backing-slots (vector-length backing))))
              ((and backing (##structure? backing))
               (set! table-backing-slots (+ table-backing-slots (##structure-length backing))))
              (else (set! unknown-table-sizes (1+ unknown-table-sizes)))))))
  (def (walk value)
    (cond
      ((or (begin (set! stage 'object) (object? value))
           (begin (set! stage 'expander) (expander-context? value))
           (begin (set! stage 'class) (class-type? value))
           (raw-table? value)
           (begin (set! stage 'table) (gambit-table? value))
           (##continuation? value) (gc-wrapper? value))
       (unless (hash-key? frontiers value)
         ;; Standard Gerbil tables are not Gambit tables. Their backing vector
         ;; contains VM sentinel cells, not ordinary Scheme payload arguments.
         ;; Account through the runtime's read-only accessors without walking
         ;; storage cells, hashing, rehashing or invoking interface methods.
         (when (or (raw-table? value) (gambit-table? value) (gc-wrapper? value)) (table! value))
         (when (expander-context? value)
           (hash-put! contexts value (expander-context-id value))
           (set! context-bindings (+ context-bindings (hash-length (expander-context-table value)))))
         (when (object? value)
           (hash-put! receiver-frontiers value #t)
           (let* ((fields (object-%instance value))
                  (kind (and fields (hash-get fields 'kind)))
                  (identity (and fields (hash-get fields 'identity))))
             (hash-update! frontier-kinds
               (cond ((symbol? kind) kind) ((symbol? identity) identity) (else 'anonymous)) 1+ 0))))
       (hash-put! frontiers value #t))
      ((and (or (pair? value) (vector? value) (string? value)
                (##closure? value) (##structure? value))
            (not (hash-key? seen value)))
       (set! stage 'account)
       (hash-put! seen value #t)
       (let ((size (object-body-bytes value))
             (kind (cond ((pair? value) 'pairs) ((vector? value) 'vectors)
                         ((string? value) 'strings) ((##closure? value) 'closures)
                         (else 'structures))))
         (set! bytes (+ bytes size))
         (hash-update! body-kinds kind (cut + <> size) 0)
         (when (string? value)
           (let (source (hash-get source-strings value))
             (hash-update! string-origins (if source 'observed-source 'other-capture)
               (cut + <> size) 0)
             (when source (hash-update! source-bodies source (cut + <> size) 0))
             ;; Actual first strong path, with contents omitted. This is a
             ;; bounded witness, not an exclusive/dominator attribution.
             (when (and (not source) (> (string-length value) 2048))
               (set! large-captures
                 (take (list-sort (lambda (a b) (> (car a) (car b)))
                         (cons (cons (string-length value) (reverse route)) large-captures))
                       (min 8 (1+ (length large-captures)))))))
           (let (copies (hash-get string-groups value))
             (when copies (set! duplicate-string-bytes (+ duplicate-string-bytes size)))
             (hash-put! string-groups value (1+ (or copies 0)))))
         (when (##structure? value)
           (let* ((identity (##type-id (##structure-type value)))
                  (previous (or (hash-get structure-kinds identity) (cons 0 0))))
             (hash-put! structure-kinds identity (cons (1+ (car previous)) (+ size (cdr previous)))))))
       (cond
         ((pair? value) (descend (car value) 'car) (descend (cdr value) 'cdr))
         ((vector? value)
          (let loop ((index 0))
            (when (< index (vector-length value))
              (descend (vector-ref value index) (list 'vector index)) (loop (1+ index)))))
         ((##closure? value)
          ;; Count the real code owner by identity. Its allocator size is opaque;
          ;; neither a closure count nor the whole VM is exclusive code memory.
          (let (code (##subprocedure-parent (##closure-ref value 0)))
            (set! code-references (1+ code-references))
            (hash-update! code-families code 1+ 0))
          (let (kind (or (hash-get binder-code (##closure-ref value 0)) 'other))
            (hash-update! binder-counts kind 1+ 0)
            (binder! value kind)
            (unless (hash-key? binder-paths kind)
              (hash-put! binder-paths kind (reverse route))))
          ;; Only the actual runtime issuer's code family owns this private
          ;; capture projection. An arbitrary callback may capture a whole VM
          ;; environment, including the running probe; keep that frontier opaque.
          (if (or environments? (hash-key? issuer-code (##subprocedure-parent (##closure-ref value 0))))
            (let loop ((index 1))
              (when (< index (##closure-length value))
                (descend (##closure-ref value index) (list 'capture index)) (loop (1+ index))))
            (hash-put! frontiers value #t)))
         ;; Interface method tables are shared runtime implementation, not this
         ;; receiver's payload. Follow its actual backing object only.
         ((interface-instance? value) (descend (interface-instance-object value) 'backing))
         ((##structure? value)
          (let ((type (##structure-type value)))
            (let loop ((index 1))
              (when (< index (##structure-length value))
                (descend (##structure-ref value index type #f)
                  (list (##type-id type) index)) (loop (1+ index))))))))))
  (def (descend value edge)
    (let (before route)
      (set! route (cons edge (take before (min 11 (length before)))))
      (walk value)
      (set! route before)))
  (with-catch
    (lambda (cause) (displayln "RETAINED-PROBE-FAILURE " stage) (raise cause))
    (lambda () (for-each (lambda (read)
                          (set! route (list (list 'read (slot-read-key read))))
                          (walk read)) reads)))
  (hash-for-each
    (lambda (owner _)
      (set! shells (+ shells (object-body-bytes owner)))
      ;; Inspect already prepared method/value tables, never instantiate or
      ;; reflect a cold owner. Missing value and a successful cached #f differ.
      ;; Each binding edge stays visible even when its function is shared.
      (let ((methods (object-%slot-funs owner)) (values (object-%instance owner)))
        (when (and methods values)
          (hash-for-each (lambda (name fun)
            (when (##closure? fun)
              (let* ((kind (or (hash-get binder-code (##closure-ref fun 0)) 'other))
                     (row (or (hash-get binder-demand kind) (vector 0 0))))
                (def index (if (hash-key? values name) 0 1))
                (vector-set! row index (1+ (vector-ref row index)))
                (hash-put! binder-demand kind row)))) methods)))
      (for-each
        (lambda (snapshot)
          (when snapshot
            (set! specification-references (1+ specification-references))
            (hash-put! specification-roots snapshot #t)))
        (list (object-%slots owner) (object-%defaults owner)))
      ;; Public snapshot reflection copies its pairs but preserves ORIGINAL
      ;; SlotSpec identities. It neither forces a slot nor executes a closure.
      (for-each
        (lambda (entry)
          (let (spec (cdr entry))
            (when (and ($self-slot-spec? spec) (not (hash-key? self-specifications spec)))
              (hash-put! self-specifications spec #t)
              (hash-update! self-fields (car entry) 1+ 0))))
        (object-slots owner))
      (with-catch
        (lambda (cause) (displayln "RETAINED-PROBE-FAILURE " stage) (raise cause))
        (lambda ()
          (for-each
            (lambda (field value)
              ;; Owner roots are independent of the last read root. Never
              ;; attribute this metadata path to that unrelated read.
              (set! route (list (list 'receiver field)))
              (walk value))
            '(reads instance layout slot-funs slots defaults declarations declaration-index state)
            (list (object-%reads owner) (object-%instance owner) (object-%layout owner)
                  (object-%slot-funs owner) (object-%slots owner) (object-%defaults owner)
                  (object-%declarations owner) (object-%declaration-index owner)
                  (object-%state owner)))))) owners)
  ;; Follow only already allocated context-to-context fields. Do not force a
  ;; phi frame, initializer promise, binding or runtime import. Contexts reached
  ;; from several role closures are counted once, including their table bodies.
  (def context-graph (make-hash-table-eq))
  (def context-tables (make-hash-table-eq))
  (def context-kinds (make-hash-table-eq))
  (def (context! context)
    (when (and (expander-context? context) (not (hash-key? context-graph context)))
      (hash-put! context-graph context #t)
      (let* ((kind (##type-id (##structure-type context)))
             (table (expander-context-table context))
             (fresh? (not (hash-key? context-tables table)))
             (previous (or (hash-get context-kinds kind) '(0 . 0))))
        (hash-put! context-tables table #t)
        (hash-put! context-kinds kind
          (cons (1+ (car previous))
                (+ (cdr previous) (if fresh? (hash-length table) 0))))
        (for-each (lambda (name) (context! (record-field context name)))
          '(super prelude up down)))))
  (when environments? (for-each context! (hash-keys contexts)))
  (list (cons 'body-bytes (+ bytes shells)) (cons 'receiver-shell-bytes shells)
        (cons 'closure-code-references code-references)
        (cons 'closure-code-identities (hash-length code-families))
        (cons 'runtime-binder-closures (hash->list binder-counts))
        (cons 'runtime-binder-demand (hash->list binder-demand))
        (cons 'runtime-binder-direct-captures (binder-summary))
        (cons 'runtime-binder-first-paths (hash->list binder-paths))
        (cons 'context-graph-identities (hash-length context-graph))
        (cons 'context-table-identities (hash-length context-tables))
        (cons 'context-graph-kinds (hash->list context-kinds))
        (cons 'payload-identities (hash-length seen))
        (cons 'opaque-frontiers (hash-length frontiers))
        (cons 'expander-contexts (hash-length contexts))
        (cons 'expander-context-bindings context-bindings)
        (cons 'table-policies (hash->list table-policies))
        (cons 'table-entries (hash->list table-entries))
        (cons 'table-layouts (hash->list table-layouts))
        (cons 'table-backing-slots table-backing-slots)
        (cons 'unknown-table-sizes unknown-table-sizes)
        (cons 'receiver-frontiers (hash-length receiver-frontiers))
        (cons 'receiver-frontiers-without-read
          (foldl (lambda (receiver total) (if (hash-key? owners receiver) total (1+ total)))
                 0 (hash-keys receiver-frontiers)))
        (cons 'receiver-frontier-kinds
          (take (list-sort (lambda (a b) (> (cdr a) (cdr b))) (hash->list frontier-kinds))
                (min 8 (hash-length frontier-kinds))))
        (cons 'duplicate-string-body-bytes duplicate-string-bytes)
        (cons 'string-origin-bytes (hash->list string-origins))
        (cons 'large-capture-paths large-captures)
        (cons 'source-body-paths
          (take (list-sort (lambda (a b) (> (cdr a) (cdr b))) (hash->list source-bodies))
                (min 6 (hash-length source-bodies))))
        (cons 'specification-references specification-references)
        (cons 'specification-identities (hash-length specification-roots))
        (cons 'attributed-self-specifications (hash-length self-specifications))
        (cons 'self-fields
          (take (list-sort (lambda (a b) (> (cdr a) (cdr b))) (hash->list self-fields))
                (min 12 (hash-length self-fields))))
        (cons 'structure-kinds
          (take (list-sort (lambda (a b) (> (cddr a) (cddr b))) (hash->list structure-kinds))
                (min 8 (hash-length structure-kinds))))
        (cons 'abi '(word64 char32))
        (cons 'body-kinds (hash->list body-kinds))))

(def (report-retained-reads label weak)
  (def rows (make-hash-table))
  (def owners (make-hash-table-eq))
  (def evidence (make-hash-table-eq))
  (def anonymous-shapes (make-hash-table-eq))
  (def (anonymous-shape receiver)
    (or (hash-get anonymous-shapes receiver)
        (let (names (list-sort symbol<? (map car (object-slots receiver))))
          (def shape (list 'anonymous (length names) (take names (min 10 (length names)))))
          (hash-put! anonymous-shapes receiver shape)
          shape)))
  (def field-maps (make-hash-table-eq))
  ;; These two declarations are module-global Types. Follow only their
  ;; already computed runtime metadata, never a candidate or a cold getter.
  (def schema-owners (make-hash-table-eq))
  (def (schema! descriptor)
    (when (and (object? descriptor) (not (hash-key? schema-owners descriptor)))
      (hash-put! schema-owners descriptor #t)
      (let (fields (object-%instance descriptor))
        (when fields
          (for-each (lambda (key)
                      (let (mapping (hash-get fields key))
                        (when (object? mapping)
                          (hash-put! schema-owners mapping #t)
                          (let (entries (object-%instance mapping))
                            (when entries
                              (hash-for-each (lambda (_value slot) (schema! slot)) entries))))))
            '(slots effective-slots))
          (schema! (hash-get fields 'type))))))
  (schema! YuanxuClassificationEvidence)
  (schema! YuanxuValidationEvidence)
  (def schema-reads 0)
  (hash-for-each
    (lambda (read _)
      (def receiver (slot-read-receiver read))
      (when (hash-key? schema-owners receiver) (set! schema-reads (1+ schema-reads)))
      (when (memq Class. (or (object-%precedence-list receiver) '()))
        (let (fields (object-%instance receiver))
          (when fields
            (for-each (lambda (key)
                        (let (value (hash-get fields key))
                          (when (object? value) (hash-put! field-maps value #t))))
              '(slots effective-slots)))))) weak)
  (hash-for-each
    (lambda (read _)
      (def receiver (slot-read-receiver read))
      (def fields (and (object? receiver) (object-%instance receiver)))
      (def kind (and fields (hash-get fields 'kind)))
      (def identity (and fields (hash-get fields 'identity)))
      (def precedence (or (object-%precedence-list receiver) '()))
      (def family
        (cond ((symbol? kind) kind) ((symbol? identity) identity)
              ((hash-key? field-maps receiver) 'runtime-record-field-map)
              ((or (registered-contribution receiver) (memq Contribution. precedence))
               'runtime-method-contribution)
              ((memq Slot. precedence) 'runtime-record-slot)
              ((memq Class. precedence) 'runtime-record-descriptor)
              ((memq Type. precedence) 'poo-type)
              (else (anonymous-shape receiver))))
      (def key (slot-read-key read))
      (def key-label (if (pair? key) (list (car key) (length key)) key))
      (hash-put! owners receiver #t)
      (when (memq kind '(yuanxu.contract.validation-evidence yuanxu.type.classification-evidence))
        (let (counts (or (hash-get evidence kind)
                         (let (counts (cons (make-hash-table-eq) (box 0)))
                           (hash-put! evidence kind counts)
                           counts)))
          (hash-put! (car counts) receiver #t)
          (set-box! (cdr counts) (1+ (unbox (cdr counts))))))
      (hash-update! rows (list family key-label) 1+ 0)) weak)
  (for-each
    (lambda (row) (yuanxu-write-observation-line! "%s"
                    (list 'RETAINED-READ label (car row) (cdr row))))
    (list-sort (lambda (a b) (string<? (object->string (car a)) (object->string (car b))))
      (hash->list rows)))
  (yuanxu-write-observation-line! "%s" (list 'RETAINED-OWNERS label (hash-length owners)))
  (yuanxu-write-observation-line! "%s"
    (list 'RETAINED-EVIDENCE label
      (map (lambda (entry)
             (let (counts (cdr entry))
               (list (car entry) (hash-length (car counts)) (unbox (cdr counts)))))
           (hash->list evidence))))
  (yuanxu-write-observation-line! "%s" (list 'RETAINED-SHARED-SCHEMA label schema-reads))
  (yuanxu-write-observation-line! "%s" (cons 'RETAINED-PAYLOAD
    (cons label (payload-bytes (hash-keys weak) owners))))
  ;; A second identity union opens closure ENVIRONMENTS, not code or receiver,
  ;; Expander-context or weak-table frontiers. This is not exclusive retention.
  ;; This runs after admission and never authenticates or invokes a callback.
  (yuanxu-write-observation-line! "%s" (cons 'RETAINED-ENVIRONMENTS
    (cons label (payload-bytes (hash-keys weak) owners #t)))))

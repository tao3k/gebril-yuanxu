;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Bounded lowering experiment over actual SDK-emitted Scheme. No source patch.
(import :gerbil/compiler :gerbil/compiler/compile
        (only-in :gerbil/expander import-module module-context-export module-export-name module-export-phi)
        (only-in :gerbil/runtime/system gerbil-runtime-smp?)
        (only-in "./artifact-closure" file-digest compiler-code-facts read-forms))
(def root (path-expand (getenv "CORE_STORE_ROOT")))
(def sdk (path-expand (getenv "GERBIL_HOME")))
(def core (current-directory))
(def output (path-expand "lib" root))
(def primitive-stores '(##structure-set! ##direct-structure-set! ##unchecked-structure-set!))
(def store-check-id 'yuanxu/t/qualification/mop-state/store-policy#before-store!)
(def initializer-id 'clan/poo/object#object:::init!__%)
(def allocation-id 'yuanxu/t/qualification/mop-state/store-policy#register-allocation!)
(def definitions (make-hash-table-eq))
(def order '())
(def lowered (make-hash-table-eq))
(def counts (make-hash-table-eq))
(def source-inputs '())
(def (observe-input! path)
  (unless (assoc path source-inputs)
    (set! source-inputs (cons (cons path (file-digest path)) source-inputs))))
(observe-input! (path-expand "t/qualification/mop-state/compile-store-boundary.ss" core))
(observe-input! (path-expand "t/qualification/mop-state/artifact-closure.ss" core))
(observe-input! (path-expand "t/qualification/mop-state/seal-artifact-closure.ss" core))
(observe-input! (path-expand "t/qualification/mop-state/artifact-authority.ss" core))
(def (compile-owned relative)
  (def path (path-expand relative core))
  (observe-input! path)
  (when (string=? relative "t/mop-store-boundary-test.ss")
    (let (context (import-module ':yuanxu/observability/testing-case))
      (displayln "COMPILER-TEST-MACRO: "
        (map (lambda (entry) (list (module-export-name entry) (module-export-phi entry)))
          (filter (lambda (entry) (eq? (module-export-name entry) 'yuanxu-test-case))
            (module-context-export context))))))
  (compile-module path
    [output-dir: output optimize: #t generate-ssxi: #t invoke-gsc: #t keep-scm: #t])
  (execute-pending-compile-jobs!)
  (unless (equal? (cdr (assoc path source-inputs)) (file-digest path))
    (error "compiler source changed during compilation" path)))
(def (quoted? form) (and (pair? form) (memq (car form) '(quote quasiquote declare))))
(def (read-definitions path accept?)
  (observe-input! path)
  (def (visit form)
    (when (pair? form)
      (case (car form)
        ((begin) (for-each visit (cdr form)))
        ((define)
         (when (and (pair? (cdr form)) (symbol? (cadr form)) (accept? form))
           (hash-put! definitions (cadr form) form)
           (set! order (cons (cadr form) order)))))))
  (call-with-input-file path
    (lambda (port)
      (let loop ((form (read port)))
        (unless (eof-object? form) (visit form) (loop (read port)))))))
(def (references? form names)
  (cond ((symbol? form) (memq form names))
        ((or (not (pair? form)) (quoted? form)) #f)
        (else (or (references? (car form) names) (references? (cdr form) names)))))
(read-definitions (path-expand "lib/gerbil/runtime/mop~0.scm" sdk)
  (lambda (form) (and (pair? (caddr form)) (eq? (car (caddr form)) 'lambda))))
;; Follow native constructor callers too: optimized .def can bypass dynamic
;; :init! dispatch, while .cc/.+ can reach it through ordinary runtime calls.
(read-definitions
  (path-expand "lib/clan/poo/object~0.scm" (gerbil-path))
  (lambda (form)
    (or (and (pair? (caddr form)) (eq? (car (caddr form)) 'lambda))
        (string-suffix? "-set!" (symbol->string (cadr form))))))
(set! order (reverse order))
(def selected
  (let close ((selected '()))
    (def next (filter (lambda (name)
      (references? (caddr (hash-ref definitions name)) (append primitive-stores selected))) order))
    (if (equal? next selected) selected (close next))))
(def (renamed name) (string->symbol (string-append "store-cut#" (symbol->string name))))
(def (rewrite-list form)
  (if (pair? form)
    (cons (rewrite (car form)) (rewrite-list (cdr form)))
    (rewrite form)))
(def (rewrite form)
  (cond
    ((symbol? form) (if (memq form selected) (renamed form) form))
    ((not (pair? form)) form)
    ((or (quoted? form) (hash-key? lowered form)) form)
    ((memq (car form) primitive-stores)
     (hash-put! counts (car form) (+ 1 (or (hash-get counts (car form)) 0)))
     (def operands (map rewrite (cdr form)))
     ;; Emitted Scheme is read again by GSC; an uninterned printed identifier
     ;; would be a NEW identity at every occurrence, not a lexical binding.
     (def temporaries (map (lambda (_)
       (string->symbol (symbol->string (gensym 'store-argument)))) operands))
     (def result `(let ,(map list temporaries operands)
                    (,store-check-id ,(car temporaries))
                    (,(car form) ,@temporaries)))
     (hash-put! lowered result #t)
     result)
    (else (rewrite-list form))))
(create-directory* output)
;; Build the native SOURCE in an isolated namespace, including its own cache,
;; recursive edges and reload entry. No live SDK binding is replaced here.
(def native-loader-source (path-expand "src/gerbil/runtime/loader.ss" sdk))
(observe-input! native-loader-source)
(def source-loader-path (path-expand "source-loader.ss" root))
(def (emit-source-line text port) (display text port) (newline port))
(def source-load-sites 0)
(def source-cache-entries 0)
(call-with-input-file native-loader-source
  (lambda (input)
    (call-with-output-file (list path: source-loader-path truncate: #t)
      (lambda (port)
        (let loop ((line (read-line input)))
          (unless (eof-object? line)
            (cond
              ((string-prefix? "prelude:" line) (emit-source-line "prelude: :gerbil/core" port))
              ((string-prefix? "package:" line) (emit-source-line "package: yuanxu/t/qualification/mop-state" port))
              ((string-prefix? "namespace:" line) (void))
              ((equal? line "(import \"gambit\" \"util\" \"hash\" \"thread\")")
               (emit-source-line "(import :gerbil/runtime/gambit :gerbil/runtime/util :gerbil/runtime/hash :gerbil/runtime/thread)" port)
               (emit-source-line "(extern namespace: #f yuanxu/t/qualification/mop-state/artifact-authority#authorize-request! yuanxu/t/qualification/mop-state/artifact-authority#load-owned!)" port))
              ((or (equal? line "(def (load-module (modpath : :string))")
                   (equal? line "(def (reload-module! (modpath : :string))"))
               (set! source-cache-entries (+ source-cache-entries 1))
               (emit-source-line line port)
               (emit-source-line "  (yuanxu/t/qualification/mop-state/artifact-authority#authorize-request! modpath)" port))
              ((equal? line "             (let (loaded-path (load path))")
               (set! source-load-sites (+ source-load-sites 1))
               (emit-source-line "             (let (loaded-path (yuanxu/t/qualification/mop-state/artifact-authority#load-owned! modpath path))" port))
              (else (emit-source-line line port)))
            (loop (read-line input))))))))
(unless (and (= source-cache-entries 2) (= source-load-sites 1))
  (error "native source loader shape changed" source-cache-entries source-load-sites))
(observe-input! source-loader-path)
(compile-module source-loader-path
  [output-dir: output optimize: #t generate-ssxi: #t invoke-gsc: #t keep-scm: #t])
(execute-pending-compile-jobs!)
;; Isolated derivation of the ACTUAL native loader bodies. No public wrapper.
(def loader-source (path-expand "lib/gerbil/runtime/loader~0.scm" sdk))
(observe-input! loader-source)
(def loader-definitions '())
(def (collect-loader form)
  (when (pair? form)
    (case (car form)
      ((begin) (for-each collect-loader (cdr form)))
      ((define)
       (when (memq (cadr form) '(__load-module load-module))
         (set! loader-definitions (cons form loader-definitions)))))))
(for-each collect-loader (read-forms loader-source))
(unless (= (length loader-definitions) 2) (error "native loader definitions changed"))
(def loader-cuts 0)
(def (rewrite-loader form receiver)
  (cond
    ((memq form '(__load-module load-module))
     (string->symbol (string-append "authority-cut#" (symbol->string form))))
    ((or (not (pair? form)) (quoted? form)) form)
    ((and (eq? (car form) 'load) (= (length form) 2))
     (set! loader-cuts (+ loader-cuts 1))
     `(yuanxu/t/qualification/mop-state/artifact-authority#load-owned! ,receiver ,(cadr form)))
    (else (cons (rewrite-loader (car form) receiver) (rewrite-loader (cdr form) receiver)))))
(call-with-output-file (list path: (path-expand "loader-runtime.scm" root) truncate: #t)
  (lambda (port)
    (pretty-print '(##include "~~lib/_gambit#.scm") port)
    (pretty-print '(declare (block) (standard-bindings) (extended-bindings)) port)
    (for-each (lambda (definition)
      (def name (cadr definition))
      (def function (caddr definition))
      (unless (and (eq? (car function) 'lambda) (= (length (cadr function)) 1))
        (error "native loader signature changed" name))
      (def receiver (caadr function))
      (def body (map (cut rewrite-loader <> receiver) (cddr function)))
      (pretty-print `(define ,(rewrite-loader name receiver)
        (lambda ,(cadr function)
          ,@(if (eq? name '__load-module)
              `((yuanxu/t/qualification/mop-state/artifact-authority#authorize-request! ,receiver)) '())
          ,@body)) port)) (reverse loader-definitions))
    (pretty-print '(set! __load-module authority-cut#__load-module) port)
    (pretty-print '(set! load-module authority-cut#load-module) port)))
(unless (= loader-cuts 1) (error "native loader load site changed" loader-cuts))
(call-with-output-file (list path: (path-expand "sdk-home" root) truncate: #t)
  (lambda (port) (display sdk port)))
(call-with-output-file (list path: (path-expand "sdk-smp" root) truncate: #t)
  (lambda (port) (display (if (gerbil-runtime-smp?) "true" "false") port)))
(call-with-output-file (list path: (path-expand "store-runtime.scm" root) truncate: #t)
  (lambda (port)
    (pretty-print '(##include "~~lib/_gambit#.scm") port)
    (pretty-print '(declare (block) (standard-bindings) (extended-bindings)) port)
    (for-each (lambda (name)
      (def form (rewrite (hash-ref definitions name)))
      (when (eq? name initializer-id)
        (let* ((function (caddr form)) (formals (cadr function)))
          ;; Verified native lowering: six keywords, dispatch vector, SELF.
          (unless (and (list? formals) (= (length formals) 8))
            (error "native initializer lowering changed" formals))
          (let (receiver (car (reverse formals)))
            (set! form `(define ,(cadr form)
              (lambda ,formals
                (let ((allocation-result (begin ,@(cddr function))))
                  (,allocation-id ,receiver)
                  allocation-result)))))))
      (pretty-print form port)) selected)))
;; Policy is trusted experiment code and is deliberately outside its own pass.
(compile-owned "t/qualification/mop-state/store-policy.ss")
(compile-owned "t/qualification/mop-state/unlowered-store.ss")
(def original-generator apply-generate-runtime)
(set! apply-generate-runtime (lambda (stx) (rewrite (original-generator stx))))
;; Materialize the newly introduced guard dependency in native loader code.
;; This is an ordinary load-module edge, not an application invocation wrapper.
(def original-loader apply-generate-loader)
(set! apply-generate-loader
  (lambda (stx)
    `(begin ,(original-loader stx)
       (load-module "yuanxu/t/qualification/mop-state/store-policy"))))
(compile-owned "t/qualification/mop-state/precompiled-stores.ss")
(compile-owned "t/mop-store-boundary-test.ss")
(call-with-output-file (list path: (path-expand "compiler-closure.ss" root) truncate: #t)
  (lambda (port)
    (write (compiler-code-facts "yuanxu/t/qualification/mop-state/precompiled-stores" selected) port)))
(call-with-output-file (list path: (path-expand "compiler-inputs.ss" root) truncate: #t)
  (lambda (port) (write source-inputs port)))
(call-with-output-file (list path: (path-expand "forbidden-bindings.ss" root) truncate: #t)
  (lambda (port) (write selected port)))
(for-each (lambda (name)
  (unless (hash-get counts name) (error "missing native store family" name))) primitive-stores)
(call-with-output-file (list path: (path-expand "lowering-counts.ss" root) truncate: #t)
  (lambda (port) (write (hash->list counts) port)))
;; The supervising trusted process retains this job result from its own OS
;; pipe. Files alongside artifacts are never its authority for reissuance.
(display "COMPILER-ISSUANCE ")
(write (list source-inputs
  (compiler-code-facts "yuanxu/t/qualification/mop-state/precompiled-stores" selected)
  selected
  (map (lambda (name)
    (let (path (path-expand name root)) (cons path (file-digest path))))
    '("compiler-inputs.ss" "compiler-closure.ss" "forbidden-bindings.ss"))))
(newline)
(displayln "STORE-LOWERING-COMPILED: " (length selected) " SDK/setter bindings; three primitive families")

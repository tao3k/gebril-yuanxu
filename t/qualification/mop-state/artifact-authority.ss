;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Isolated native-loader experiment. Expected issuance comes from a child
;;; compiler pipe retained in parent memory, never from writable sidecars.
(import :clan/poo/object
        (only-in :std/misc/process run-process)
        (only-in :std/misc/ports read-all-as-string read-all-as-u8vector)
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode)
        (only-in :yuanxu/ops/progress execution-progress!)
        (only-in :gerbil/runtime/loader load-module load-path set-load-path! __find-library-module list-modules)
        "./artifact-closure")
(export compile-authority install-authority! prepare-source-authority! deactivate-authority!
        authorize-request! load-owned! current-transfer-probe
        authority-status authority-artifacts authority-private-pool reset-native-errors!)
(extern namespace: #f __modules)
(defstruct authority (artifacts pool issued inputs index loaded events) transparent: #f)
(def active #f)
(def current-transfer-probe (make-parameter (lambda (_phase _name _path) (void))))
(def (bytes path) (call-with-input-file path read-all-as-u8vector))
(def (write-bytes path data)
  (create-directory* (path-directory path))
  (call-with-output-file (list path: path truncate: #t permissions: #o400)
    (lambda (port) (write-subu8vector data 0 (u8vector-length data) port))))
(def (digest data) (hex-encode (sha256 data)))
(def (one-record transcript prefix)
  (def found '())
  (call-with-input-string transcript
    (lambda (port)
      (let loop ((line (read-line port)))
        (unless (eof-object? line)
          (when (string-prefix? prefix line)
            (set! found (cons (call-with-input-string
              (substring line (string-length prefix) (string-length line))
              (lambda (record-port)
                (def datum (read record-port))
                (unless (eof-object? (read record-port))
                  (error "trailing compiler pipe record data" prefix))
                datum)) found)))
          (loop (read-line port))))))
  (unless (= (length found) 1) (error "compiler pipe issuance count mismatch" prefix))
  (car found))
(def (compile-authority owned-root)
  (displayln "AUTHORITY-PHASE compile-start") (force-output)
  (def artifact-root (path-expand "artifacts" owned-root))
  (def private-root (path-expand "private" owned-root))
  (create-directory (list path: private-root permissions: #o700))
  (def transcript (run-process
    (list "timeout" "--signal=TERM" "--kill-after=5s" "240s"
          "just" "compile-mop-store-boundary" artifact-root)
    coprocess: (lambda (process)
      ;; Forward only actual child output progress while retaining the complete
      ;; issuance pipe. Buffering to EOF hid native compiler work from the
      ;; outer Harness idle guard; a timer would merely hide a real stall.
      (def text
        (call-with-output-string
          (lambda (port)
            (let loop ((line (read-line process)) (count 0))
              (unless (eof-object? line)
                (display line port) (newline port)
                (execution-progress! '(authority-compiler-output) (1+ count))
                (loop (read-line process) (1+ count)))))))
      ;; Preserve failed child output outside rollback-owned fixture storage.
      (call-with-output-file (list path: (path-expand "authority-compiler.log" (path-directory owned-root)) truncate: #t)
        (cut display text <>))
      text)))
  (displayln "AUTHORITY-PHASE compile-complete") (force-output)
  (def compilation (one-record transcript "COMPILER-ISSUANCE "))
  (def resources (one-record transcript "RESOURCE-ISSUANCE "))
  (def previous (load-path))
  (dynamic-wind
    (lambda () (set-load-path! (cons (path-expand "lib" artifact-root) previous)))
    (lambda ()
      (def input-rows (append (car compilation) (list-ref compilation 3) resources))
      (displayln "AUTHORITY-PHASE closure-capture-start") (force-output)
      (def issued (capture-closure "yuanxu/t/qualification/mop-state/precompiled-stores"
        input-rows (list-ref compilation 2) (list-ref compilation 1)))
      (displayln "AUTHORITY-PHASE closure-capture-complete") (force-output)
      (unless (null? (closure-issues issued)) (error "compiler pipe artifact admission failed"))
      (def index (make-hash-table))
      (for-each (lambda (row) (hash-put! index (.get row name) row)) (.get issued units))
      ;; These generated kernels are trusted compiler job outputs; copy verified
      ;; bytes, not mutable path aliases. The private directory remains in TCB.
      (for-each (lambda (entry)
        (def data (bytes (car entry)))
        (unless (equal? (digest data) (cdr entry)) (error "issued resource changed" (car entry)))
        (write-bytes (path-expand (path-strip-directory (car entry)) private-root) data)) resources)
      (make-authority artifact-root private-root issued input-rows index (make-hash-table) '()))
    (lambda () (set-load-path! previous))))
(def (authority-private-pool state) (authority-pool state))
(def (event! state phase name detail)
  (authority-events-set! state (cons (list phase name detail) (authority-events state))))
(def (authority-status state)
  (def history (reverse (authority-events state)))
  (.o events: history
      consumed: (filter (lambda (event) (eq? (car event) 'consumed)) history)))
(def (check-row! name row)
  (unless (and (equal? (__find-library-module name) (.get row path))
               (equal? (file-digest (.get row path)) (.get row digest))
               (equal? (file-digest (.get row emitted)) (.get row emitted-digest))
               (andmap (lambda (entry) (and (file-exists? (car entry))
                 (equal? (file-digest (car entry)) (cdr entry)))) (.get row metadata)))
    (error "issued native artifact changed" name)))
(def (authorize-request! name)
  (when active
   (let* ((state active) (row (hash-get (authority-index state) name)))
    (event! state 'request name #f)
    (when (and row (string=? name "yuanxu/t/qualification/mop-state/precompiled-stores"))
      (let* ((inputs (authority-inputs state))
             (units (.get (authority-issued state) units))
             (source-expected (call-with-output-string (cut write inputs <>)))
             (source-checked (call-with-output-string
               (cut write (map (lambda (entry)
                 (cons (car entry) (and (file-exists? (car entry)) (file-digest (car entry))))) inputs) <>)))
             (unit-expected (call-with-output-string
               (cut write (map (lambda (entry) (list (.get entry name) (.get entry path) (.get entry digest))) units) <>)))
             (unit-checked (call-with-output-string
               (cut write (map (lambda (entry)
                 (let (actual (__find-library-module (.get entry name)))
                   (list (.get entry name) actual (and actual (file-digest actual))))) units) <>))))
        (event! state 'authorization name
          (vector source-expected source-checked unit-expected unit-checked))))
    (cond
      (row
       (for-each (lambda (entry)
         (unless (and (file-exists? (car entry))
                      (equal? (file-digest (car entry)) (cdr entry)))
           (error "issued source or record changed" (car entry))))
         (authority-inputs state))
       (check-row! name row)
       (when (string=? name "yuanxu/t/qualification/mop-state/precompiled-stores")
         (for-each (lambda (entry) (check-row! (.get entry name) entry))
           (.get (authority-issued state) units)))
       (when (string-prefix? "yuanxu/t/qualification/mop-state/precompiled-stores" name)
         (let (resident (hash-get __modules name))
           (when (and (string? resident)
                      (not (equal? resident (hash-get (authority-loaded state) name))))
             (error "resident callback has no issuer association" name)))))
      ((let (path (__find-library-module name))
         (and path (string-prefix? (authority-artifacts state) path)))
       (error "unissued native dependency" name))))))
(def (load-owned! name path)
  (def state active)
  (def row (and state (hash-get (authority-index state) name)))
  (if (not row) (load path)
    (let ()
      ((current-transfer-probe) 'resolved name path)
      (authorize-request! name)
      (def data (bytes path))
      (unless (equal? (digest data) (.get row digest))
        (error "issued native bytes changed" name))
      (def snapshot (path-expand
        (string-append (.get row digest) "/" (path-strip-directory path)) (authority-pool state)))
      (unless (file-exists? snapshot) (write-bytes snapshot data))
      ((current-transfer-probe) 'snapshot name path)
      (authorize-request! name)
      (def checked-snapshot (file-digest snapshot))
      (event! state 'snapshot-check name (vector (.get row digest) checked-snapshot))
      (unless (equal? checked-snapshot (.get row digest))
        (error "private native snapshot changed" name))
      ;; This final fault seam demonstrates why private-pool authority is a
      ;; premise: artifact-tree changes cannot alter the already copied bytes.
      ((current-transfer-probe) 'consuming name path)
      (event! state 'consume name (.get row digest))
      (def result (load snapshot))
      (hash-put! (authority-loaded state) name result)
      (event! state 'consumed name
        (vector (.get row digest) checked-snapshot
                (equal? (file-digest path) (.get row digest))))
      result)))
(def (install-authority! state)
  (set! active state)
  (set-load-path! (cons (path-expand "lib" (authority-artifacts state)) (load-path)))
  ;; The policy's compiler-owned kernel LOAD also uses the verified private
  ;; resource copy. This is process-local, serial qualification, not thread-local.
  (setenv "CORE_STORE_ROOT" (authority-pool state))
  (load (path-expand "loader-runtime.o1" (authority-pool state))))
(def (prepare-source-authority! state)
  (set! active state)
  (set-load-path! (cons (path-expand "lib" (authority-artifacts state)) (load-path)))
  (setenv "CORE_STORE_ROOT" (authority-pool state))
  ;; Bootstrap the complete issued module through the native loader. Loading
  ;; only ~0 bypasses the module initializer and is not a portable entrypoint.
  ;; Both units stay in the compiler-issued, private pool throughout activation.
  (def bootstrap (path-expand "bootstrap/lib" (authority-pool state)))
  (def directory (path-expand "yuanxu/t/qualification/mop-state" bootstrap))
  (create-directory* directory)
  (for-each
    (lambda (name)
      (def input (path-expand name (authority-pool state)))
      (def output (path-expand name directory))
      (write-bytes output (bytes input))
      (unless (equal? (file-digest input) (file-digest output))
        (error "private loader bootstrap bytes changed" name)))
    '("source-loader.o1" "source-loader~0.o1"))
  (def previous (load-path))
  (dynamic-wind
    (lambda () (set-load-path! (cons bootstrap previous)))
    (lambda ()
      (displayln "AUTHORITY-PHASE loader-bootstrap-start") (force-output)
      (def result (load-module "yuanxu/t/qualification/mop-state/source-loader"))
      (displayln "AUTHORITY-PHASE loader-bootstrap-complete") (force-output)
      result)
    (lambda () (set-load-path! previous))))
(def (deactivate-authority!) (set! active #f))
(def (reset-native-errors! state)
  (for-each (lambda (entry)
    (when (hash-key? (authority-index state) (car entry))
      (let (value (hash-get __modules (car entry)))
        (when (and (pair? value) (eq? (car value) 'error))
          (hash-remove! __modules (car entry))))))
    (list-modules)))

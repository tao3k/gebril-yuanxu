;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Isolation compiler/artifact verifier. It reads emitted files, never loads
;;; the selected callback. The issuer and its frozen digest data are trusted.
(import :clan/poo/object
        (only-in :gerbil/runtime/loader __find-library-module list-modules)
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode)
        (only-in :std/misc/ports read-all-as-u8vector))
(export capture-closure compiler-code-facts closure-issues inspect-closure file-digest read-forms native-edges)
(def primitives '(##structure-set! ##direct-structure-set! ##unchecked-structure-set!))
(def checker 'yuanxu/t/qualification/mop-state/store-policy#before-store!)
(def callback-prefix "yuanxu/t/qualification/mop-state/precompiled-stores")
(def (audited-unit? name)
  (and (string-prefix? "yuanxu/t/qualification/mop-state/" name)
       (not (string-prefix? "yuanxu/t/qualification/mop-state/store-policy" name))))
(def (file-digest path)
  (hex-encode (sha256 (call-with-input-file path read-all-as-u8vector))))
(def (read-forms path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((result '()))
        (let (form (read port))
          (if (eof-object? form) (reverse result)
            (loop (cons form result))))))))
(def (quoted? form) (and (pair? form) (memq (car form) '(quote quasiquote declare))))
(def (native-edges forms)
  (def result '())
  (def (visit form)
    (when (and (pair? form) (not (quoted? form)))
      (if (and (eq? (car form) 'load-module) (= (length form) 2)
               (string? (cadr form)))
        (unless (member (cadr form) result) (set! result (cons (cadr form) result)))
        (begin (visit (car form)) (visit (cdr form))))))
  (for-each visit forms)
  (reverse result))
(def (store-issues forms forbidden)
  (def covered (make-hash-table-eq))
  (def issues '())
  (def (visit form)
    (cond
      ((symbol? form)
       (when (memq form forbidden) (set! issues (cons 'unlowered-native-reference issues))))
      ((or (not (pair? form)) (quoted? form)) (void))
      (else
       ;; Exact shape emitted by the owned lowering; a nearby checker name is
       ;; insufficient. The same target must precede this primitive store.
       (when (and (eq? (car form) 'let) (list? form) (= (length form) 4)
                  (list? (caddr form)) (= (length (caddr form)) 2)
                  (eq? (caaddr form) checker)
                  (pair? (cadddr form)) (memq (car (cadddr form)) primitives)
                  (eq? (cadr (caddr form)) (cadr (cadddr form))))
         (hash-put! covered (cadddr form) #t))
       (when (and (memq (car form) primitives) (not (hash-key? covered form)))
         (set! issues (cons 'unmediated-primitive issues)))
       (visit (car form)) (visit (cdr form)))))
  (for-each visit forms)
  (reverse issues))
(def (unit-row unit-name)
  (def runtime-path (__find-library-module unit-name))
  (unless runtime-path (error "artifact not found" unit-name))
  (def emitted-path (string-append (path-strip-extension runtime-path) ".scm"))
  (unless (file-exists? emitted-path) (error "emitted artifact source missing" unit-name emitted-path))
  (def code-forms (read-forms emitted-path))
  (def base (path-strip-extension runtime-path))
  (def owner (if (string-suffix? "~0" base)
               (substring base 0 (- (string-length base) 2)) base))
  (def metadata-paths
    (filter file-exists? (map (cut string-append owner <>) '(".ssi" ".ssxi.ss"))))
  ;; Freeze observations now. Lazy digest slots would otherwise read changed
  ;; bytes only when the supposedly issued snapshot was compared later.
  (def binary-digest (file-digest runtime-path))
  (def source-digest (file-digest emitted-path))
  (def metadata-facts (map (lambda (path) (cons path (file-digest path))) metadata-paths))
  (def import-edges (native-edges code-forms))
  (.o name: unit-name path: runtime-path digest: binary-digest
      emitted: emitted-path emitted-digest: source-digest
      metadata: metadata-facts edges: import-edges forms: code-forms))
(def (walk-units entry)
  (def seen (make-hash-table))
  (def rows '())
  (def (visit name)
    (unless (hash-key? seen name)
      (hash-put! seen name #t)
      (let (row (unit-row name))
        (set! rows (cons row rows))
        (for-each visit (.get row edges)))))
  (visit entry)
  (reverse rows))
(def (row-facts row)
  (list (.get row name) (.get row path) (.get row digest)
        (.get row emitted) (.get row emitted-digest) (.get row metadata) (.get row edges)))
(def (code-facts units)
  (map (lambda (row)
    (list (.get row name) (.get row digest) (.get row emitted-digest)
          (map (lambda (entry) (cons (path-strip-directory (car entry)) (cdr entry)))
               (.get row metadata))
          (.get row edges))) units))
(def (audit-units! observed-units native-bindings)
  (for-each
    (lambda (row)
      (when (audited-unit? (.get row name))
        (let (issues (store-issues (.get row forms) native-bindings))
          (unless (null? issues) (error "unprocessed callback artifact" issues))))) observed-units))
;; Called by the trusted compiler immediately after its jobs complete, not by
;; a user declaration. Runtime admission cannot issue a fresh expected digest.
(def (compiler-code-facts root-entry native-bindings)
  (def units (walk-units root-entry))
  (audit-units! units native-bindings)
  (code-facts units))
(def (capture-closure root-entry compiler-inputs native-bindings compiler-facts)
  (def observed-units (walk-units root-entry))
  (audit-units! observed-units native-bindings)
  (unless (equal? compiler-facts (code-facts observed-units))
    (error "unissued or changed compiler artifact" root-entry))
  (.o entry: root-entry units: observed-units inputs: compiler-inputs forbidden: native-bindings))
(def (inspect-closure issued)
  (def issues '())
  (def prior-loaded? #f)
  (def source-current? #t)
  (def stores-valid? #t)
  (def (issue kind path) (set! issues (cons (list kind path) issues)))
  ;; Loading an old callback before this gate invalidates a file-only decision.
  (for-each
    (lambda (entry)
      (when (string-prefix? callback-prefix (car entry))
        (set! prior-loaded? #t)
        (issue 'callback-already-loaded (car entry))))
    (list-modules))
  (for-each
    (lambda (entry)
      (unless (and (file-exists? (car entry))
                   (equal? (cdr entry) (file-digest (car entry))))
        (set! source-current? #f)
        (issue 'stale-compiler-input (car entry))))
    (.get issued inputs))
  (def actual (walk-units (.get issued entry)))
  (unless (equal? (map row-facts actual) (map row-facts (.get issued units)))
    (issue 'artifact-closure-changed (.get issued entry)))
  (for-each
    (lambda (row)
      (when (audited-unit? (.get row name))
        (let (failures (store-issues (.get row forms) (.get issued forbidden)))
          (unless (null? failures) (set! stores-valid? #f))
          (for-each (cut issue <> (.get row name)) failures)))) actual)
  (def expected-facts (call-with-output-string (cut write (map row-facts (.get issued units)) <>)))
  (def observed-facts (call-with-output-string (cut write (map row-facts actual) <>)))
  (def observed-issues (reverse issues))
  (.o issues: observed-issues expected: expected-facts observed: observed-facts
      valid: stores-valid? current: source-current? loaded: prior-loaded?))
(def (closure-issues issued) (.get (inspect-closure issued) issues))

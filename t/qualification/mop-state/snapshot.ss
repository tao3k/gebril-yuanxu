;;; Qualification-only raw-state projection, never a production admission API.
(import :clan/poo/object
        (prefix-in (only-in :gerbil/runtime/mop slot-ref object-class) runtime.)
        (only-in :clan/poo/mop make-slot-read slot-read-receiver slot-read-key
                 slot-read-revision slot-read-instance slot-read-value slot-read-dependencies)
        (only-in :yuanxu/module-system/source/admission current-module-source-observer))
(export capture-state state-current! state-closed? state-reads state-objects
        read-view-checker read-view-record object-view-value selected-ancestors)
(defstruct object-view (value revision refs supers order anchors) final: #t)
(defstruct read-view (record checker refs key dependencies) final: #t)
(defstruct state (roots reads objects observer) final: #t)
(def record-class (runtime.object-class (make-slot-read #f #f 0 #f #f '() values)))
(def absent (gensym 'absent-cache))
(def (copy-list value) (and value (map values value)))
(def (same-refs? left right)
  (and (= (length left) (length right)) (andmap eq? left right)))
(def (same-optional? left right)
  (if left (and right (same-refs? left right)) (not right)))
(def (selected-ancestors roots)
  (def seen (make-hash-table-eq))
  (def result '())
  (def (visit value)
    (unless (object? value) (error "invalid native receiver"))
    (unless (hash-key? seen value)
      (hash-put! seen value #t)
      (set! result (cons value result))
      (for-each visit (object-supers value))))
  (for-each visit roots)
  (reverse result))
(def (capture-object value)
  (make-object-view value (object-revision value)
    (list (object-%slots value) (object-%defaults value) (object-%reads value)
          (object-%layout value) (object-%instance value) (object-%slot-funs value)
          (object-%all-slots value) (object-%protocol value) (object-%overrides value)
          (object-%declarations value))
    (map values (object-supers value)) (copy-list (object-%precedence-list value))
    (map (lambda (entry) (cons (car entry) (cdr entry))) (or (object-%bootstrap value) '()))))
(def (capture-read read)
  (unless (eq? (runtime.object-class read) record-class) (error "foreign native read type"))
  (def receiver (slot-read-receiver read))
  (unless (object? receiver) (error "invalid native receiver"))
  (def key (slot-read-key read))
  (def instance (object-%instance receiver))
  (def table (object-%reads receiver))
  (make-read-view read (runtime.slot-ref read 'current?)
    (list receiver (slot-read-revision read) (slot-read-instance read) (slot-read-value read)
      (and table (hash-ref table key absent))
      (if (and instance (symbol? key)) (hash-ref instance key absent) absent))
    (if (pair? key) (map values key) key) (map values (slot-read-dependencies read))))
(def (capture-state roots)
  (def seen (make-hash-table-eq))
  (def reads '())
  (def (visit record)
    (unless (hash-key? seen record)
      (let (row (capture-read record))
        (hash-put! seen record #t)
        (set! reads (cons row reads))
        (for-each visit (read-view-dependencies row)))))
  (for-each visit roots)
  (def ordered (reverse reads))
  (make-state (map values roots) ordered
    (map capture-object
      (selected-ancestors (map (lambda (row) (slot-read-receiver (read-view-record row))) ordered)))
    (current-module-source-observer)))
(def (same-object? left right)
  (and (eq? (object-view-value left) (object-view-value right))
       (= (object-view-revision left) (object-view-revision right))
       (same-refs? (object-view-refs left) (object-view-refs right))
       (same-refs? (object-view-supers left) (object-view-supers right))
       (same-optional? (object-view-order left) (object-view-order right))
       (same-refs? (map car (object-view-anchors left)) (map car (object-view-anchors right)))
       (same-refs? (map cdr (object-view-anchors left)) (map cdr (object-view-anchors right)))))
(def (same-read? left right)
  (and (eq? (read-view-record left) (read-view-record right))
       (eq? (read-view-checker left) (read-view-checker right))
       (same-refs? (read-view-refs left) (read-view-refs right))
       (equal? (read-view-key left) (read-view-key right))
       (same-refs? (read-view-dependencies left) (read-view-dependencies right))))
(def (same-rows? compare left right)
  (and (= (length left) (length right)) (andmap compare left right)))
(def (state-current! previous)
  (def current (capture-state (state-roots previous)))
  (unless (and (eq? (state-observer previous) (state-observer current))
               (same-rows? same-read? (state-reads previous) (state-reads current))
               (same-rows? same-object? (state-objects previous) (state-objects current)))
    (error "MOP snapshot changed"))
  #t)
(def (state-closed? snapshot)
  ;; No arbitrary checker is called. This is a conservative sufficient gate;
  ;; the test does not certify arbitrary source operations or callback bodies.
  (and (not (state-observer snapshot))
       (andmap
         (lambda (row)
           (and (eq? (read-view-checker row) object-read-current?)
                (or (not (object-read-current? (read-view-record row)))
                    (object-%precedence-list (slot-read-receiver (read-view-record row)))
                    (andmap (lambda (value) (not (object-%protocol value)))
                      (selected-ancestors (list (slot-read-receiver (read-view-record row))))))))
         (state-reads snapshot))
       (state-current! snapshot)))

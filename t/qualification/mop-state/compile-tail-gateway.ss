;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Compile exactly one temporary source-event gateway; never edit installed Core.
(import :gerbil/compiler :gerbil/expander (only-in :std/misc/ports read-all-as-string))
(def root (path-expand (getenv "CORE_SOURCE_TAIL_ROOT")))
(def core (path-expand (getenv "CORE_SOURCE_TAIL_CORE")))
(def started (real-time))
(def cpu-started (cpu-time))
(def (report-stage stage)
  (displayln "SOURCE-TAIL-GATEWAY-STAGE " stage
             " elapsed=" (- (real-time) started)
             " scheme-cpu=" (- (cpu-time) cpu-started))
  (force-output))
(def original
  "(def (observe-source kind (amount 1))\n  (when (and (symbol? kind) (current-module-source-operation-times))\n    (hash-update! (current-module-source-operation-times) (list 'source kind)\n      (cut + <> amount) 0))\n  (when (current-module-source-observer)\n    ((current-module-source-observer) kind amount)))")
(def candidate
  "(def (observe-source kind (amount 1))\n  (when (and (symbol? kind) (current-module-source-operation-times))\n    (hash-update! (current-module-source-operation-times) (list 'source kind)\n      (cut + <> amount) 0))\n  (when (current-module-source-observer)\n    (when (memq (current-module-source-phase) '(slot-replay return-currentness))\n      (error \"opaque source observer in return tail\"))\n    ((current-module-source-observer) kind amount)))")
;; Snapshot current runtime sources as one coherent package. A single relocated
;; Core library mixed with live source imports is correctly refused by the reader.
;; Copy source/data roles, not compiled artifacts or a frozen older qualification.
(def source-core (path-expand "source/yuanxu/" root))
(def (snapshot directory relative)
  (for-each
    (lambda (name)
      (unless (member name '(".git" ".gerbil" ".cache" ".lake" ".data" "docs" "dev"))
        (let ((input (path-expand name directory)) (local (string-append relative name)))
          (if (eq? (file-info-type (file-info input #f)) 'directory)
            (snapshot input (string-append local "/"))
            ;; Standard qualification declarations also bind literal text inputs;
            ;; those bytes must survive relocation rather than fall back live.
            (when (or (member (path-extension name) '(".ss" ".scm" ".json" ".txt"))
                      (string=? name "gerbil.pkg"))
              (let (output (path-expand local source-core))
                (create-directory* (path-directory output))
                ;; Preserve executable build entries as well as source bytes:
                ;; the snapshot uses official gerbil build for preparation.
                (copy-file input output)))))))
    (directory-files directory)))
(snapshot core "")
(report-stage 'snapshot)
(def path (path-expand "source/yuanxu/module-system/source/observations.ss" root))
(def text (call-with-input-file (path-expand "module-system/source/observations.ss" core) read-all-as-string))
(def offset (string-contains text original))
(unless offset (error "source event gateway changed; re-audit before qualification"))
(when (string-contains (substring text (+ offset (string-length original)) (string-length text)) original)
  (error "ambiguous source event gateway"))
(create-directory* (path-directory path))
(create-directory* (path-expand "lib" root))
(call-with-output-file (list path: path truncate: #t)
  (lambda (port)
    (display (substring text 0 offset) port)
    (display candidate port)
    (display (substring text (+ offset (string-length original)) (string-length text)) port)))
(def original-import (current-expander-module-import))
(def seen (make-hash-table-eq))
(def skipped-optimizer-inputs 0)
;; The package has one ordinary namespace and one explicitly named prelude.
;; Route both to the same snapshot; never mix the host's prelude into its clone.
(def (snapshot-source name)
  (cond
    ((equal? name "yuanxu/prelude") (path-expand "prelude.ss" source-core))
    ((and name (string-prefix? "yuanxu/" name))
     (path-expand (string-append (substring name (string-length "yuanxu/") (string-length name)) ".ss") source-core))
    (else #f)))
(def (source-import path (reload? #f))
  (def datum (syntax-e path))
  (def name (and (symbol? datum) (symbol->string datum)))
  (def source (and name (string-prefix? ":" name)
                     (snapshot-source (substring name 1 (string-length name)))))
  ;; An installed optimization interface cannot supply bindings for its
  ;; snapshot owner. Gerbil can use the locally issued interface by path.
  (when (and name (string-prefix? ":" name) (string-suffix? ".ssxi.ss" name)
             (let (owner (snapshot-source (substring name 1 (- (string-length name) 8))))
               (and owner (file-exists? owner))))
    (set! skipped-optimizer-inputs (1+ skipped-optimizer-inputs))
    (error "cannot find library module" datum))
  (original-import (if (and source (file-exists? source)) source path) reload?))
(def (import-context value)
  (cond
    ((module-import? value) (import-context (module-import-source value)))
    ((module-export? value) (import-context (module-export-context value)))
    ((import-set? value) (import-context (import-set-source value)))
    (else value)))
(def (context-source context)
  (let (identity (expander-context-id context))
    (and (symbol? identity) (snapshot-source (symbol->string identity)))))
(def (rebuild-contexts roots)
  (def parents (make-hash-table-eq))
  (def visited (make-hash-table-eq))
  (def prelude-owners (make-hash-table-eq))
  (def affected (make-hash-table-eq))
  (def edited 'yuanxu/module-system/source/observations)
  (def edited-context #f)
  (def complete? #t)
  (def (walk node)
    (unless (hash-key? visited node)
      (hash-put! visited node #t)
      (let* ((language (and (module-context? node) (core-context-prelude node)))
             (prelude-owner (and (prelude-context? node) (hash-get prelude-owners node)))
             (imports (if (module-context? node) (module-context-import node)
                        (prelude-context-import node))))
        (when (and (prelude-context? node) (expander-context-id node) (not prelude-owner))
          (set! complete? #f))
        (when (eq? (expander-context-id node) edited)
          (when edited-context (error "ambiguous gateway source Context" edited))
          (unless (and (module-context? node)
                       (string? (module-context-path node))
                       (equal? (path-normalize (module-context-path node))
                               (path-normalize path)))
            (error "gateway source Context does not own the snapshot" edited))
          (set! edited-context node))
        (for-each
          (lambda (edge)
            (let (input (import-context edge))
              (when (or (module-context? input) (prelude-context? input))
                (hash-update! parents input (cut cons node <>) '())
                (walk input))))
          (cond (language (cons language imports))
                (prelude-owner (cons prelude-owner imports))
                (else imports))))))
  (def (mark node)
    (unless (hash-key? affected node)
      (hash-put! affected node #t)
      (for-each mark (hash-ref parents node '()))))
  ;; Named prelude Contexts share the source of their standard module owner.
  (hash-for-each
    (lambda (owner value)
      (when (and (module-context? owner) (prelude-context? value))
        (hash-put! prelude-owners value owner)))
    __module-registry)
  (for-each walk roots)
  (unless edited-context (error "gateway source has no standard owner" edited))
  (when complete?
    (mark edited-context)
    (for-each (lambda (entry) (hash-put! affected entry #t)) roots))
  (displayln "SOURCE-TAIL-PLAN mode=" (if complete? 'affected 'full)
    " contexts=" (hash-length visited) " affected=" (hash-length affected))
  (force-output)
  (values (and complete? affected) prelude-owners))
(def (visit context affected prelude-owners)
  (unless (hash-key? seen context)
    (hash-put! seen context #t)
    (cond
     ((module-context? context)
      (when affected
        (let (language (core-context-prelude context))
          (when language (visit language affected prelude-owners))))
      (for-each (lambda (edge) (visit (import-context edge) affected prelude-owners))
                (module-context-import context))
      (let (source (context-source context))
        (when (and source (file-exists? source)
                   (or (not affected) (hash-key? affected context)))
          (displayln "SOURCE-TAIL-COMPILE " (expander-context-id context)) (force-output)
          (compile-module source [output-dir: (path-expand "lib" root)
                                  optimize: #t generate-ssxi: #t
                                  invoke-gsc: #t keep-scm: #t parallel: #t]))))
     ((and affected (prelude-context? context))
      (let (owner (hash-get prelude-owners context))
        (when owner (visit owner affected prelude-owners)))
      (for-each (lambda (edge) (visit (import-context edge) affected prelude-owners))
                (prelude-context-import context))))))
(parameterize ((current-expander-context (make-top-context))
               (current-expander-module-import source-import))
  ;; The Harness imports init at runtime, and test-projection deliberately
  ;; delays TestingScript until .run. Compile those actual roots as well as
  ;; the test body; a static walk of the body alone misses their Core imports.
  ;; This prepares code only: no Script or selected business scope executes.
  (def roots (map (lambda (file) (core-import-module (path-expand file source-core)))
                  '("init.ss" "observability/testing-script.ss" "t/source-admission-gateway-test.ss")))
  (defvalues (affected prelude-owners) (rebuild-contexts roots))
  (for-each (lambda (context) (visit context affected prelude-owners)) roots)
  (when affected
    (hash-for-each
      (lambda (context _)
        (when (and (module-context? context) (context-source context)
                   (not (hash-key? seen context)))
          (error "affected gateway owner outside compile walk" (expander-context-id context))))
      affected)))
(displayln "SOURCE-TAIL-OPTIMIZER omitted-installed-ssxi=" skipped-optimizer-inputs)
(report-stage 'contexts)
(execute-pending-compile-jobs!)
(report-stage 'build-jobs)
(displayln "SOURCE-TAIL-GATEWAY-COMPILED: one temporary dispatcher; current source import closure")

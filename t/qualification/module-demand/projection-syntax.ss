;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Isolated lowering experiment. Not a public macro or a Loader entry point.
(import :clan/poo/object (for-syntax :gerbil/expander))
(export include-projected-interface)
(defsyntax (include-projected-interface input)
  (syntax-case input ()
    ((_ path (names ...))
     (let-values (((_prelude _id _namespace forms) (core-read-module/sexp (stx-e #'path))))
       ;; Inspect a disposable expansion, then emit the original declaration
       ;; through this SAME include frame. An extra macro frame changes exports.
       (def (check-declaration declaration)
         (let* ((declaration (syntax-local-rewrap declaration))
                (fields (cddr (syntax->list declaration)))
                (key (let loop ((rest fields))
                       (if (eq? (stx-e (car rest)) 'core:) (car rest)
                           (loop (cddr rest)))))
                (expected (datum->syntax (stx-car declaration) 'core (stx-source key)))
                (expanded (core-expand1 declaration))
                (native (find (lambda (form)
                                (syntax-case form ()
                                  ((head _ ...) (eq? (stx-e #'head) 'native-.def/ctx))
                                  (_ #f)))
                              (cdr (syntax->list expanded))))
                (row (and native
                          (find (lambda (row) (eq? (stx-e (stx-car row)) 'core))
                                (cdddr (syntax->list native))))))
           (unless (and row (bound-identifier=? (stx-car row) expected)
                        (stx-source key) (equal? (stx-source row) (stx-source key))
                        (equal? (stx-source (stx-car row)) (stx-source key)))
             (raise-syntax-error #f "declaration lost original core binding or location" input))))
       ;; Native .def stays at module level. Only value expressions acquire
       ;; the original native Core receiver's lexical export aliases.
       (def (map-fields rows transform)
         (syntax-case rows ()
           (() #'())
           ((key value . tail)
            (with-syntax ((value (transform #'key #'value))
                          (next (map-fields #'tail transform)))
              #'(key value . next)))
           (_ (raise-syntax-error #f "closed fields require keyword/value pairs" rows))))
       (def (map-object object transform)
         (syntax-case object ()
           ((head . fields)
            (with-syntax ((fields (map-fields #'fields transform))) #'(head . fields)))))
       (def (wrap value receiver)
         (def context (if (identifier? value) value (stx-car value)))
         (with-syntax ((receiver receiver) (value value)
                       ((aliases ...) (map (lambda (name) (datum->syntax context (stx-e name)))
                                           (syntax->list #'(names ...)))))
           (syntax/loc #'value
             (with-slots (aliases ...) (.get receiver roles) value))))
       (def (wrap-requires value receiver)
         (map-object value
           (lambda (_alias spec)
             (map-object spec
               (lambda (key value)
                 (if (eq? (stx-e key) 'contract:) (wrap value receiver) value))))))
       (def (wrap-core core)
         (syntax-case core ()
           ((head (:: self parents) . slots)
            (with-syntax ((slots
              (map-fields #'slots
                (lambda (key value)
                  (case (stx-e key)
                    ((requires:) (wrap-requires value #'self))
                    ((roles:) value)
                    (else (wrap value #'self)))))))
              #'(head (:: self parents) . slots)))
           (_ (raise-syntax-error #f "closed Core requires its native receiver binder" core))))
       (def (rewrite form)
         (syntax-case form ()
           ((head name . slots)
            (with-syntax ((slots (map-fields #'slots
                                  (lambda (key value)
                                    (if (eq? (stx-e key) 'core:) (wrap-core value) value)))))
              #'(head name . slots)))))
       (syntax-local-rewrap
         (stx-wrap-source (core-cons 'begin (map (lambda (form)
           (let (rewritten (rewrite form))
             (check-declaration rewritten) rewritten)) forms)) (stx-source input)))))))

(import :std/test :clan/poo/object
        (only-in "../init.ss" yuanxu.init.exports)
        (only-in :std/io/tempfile call-with-temporary-directory)
        (only-in :yuanxu/ops/interface Ops)
        (only-in :yuanxu/ops/func run-script)
        (only-in :yuanxu/module-system/source/admission module-source-read)
        (only-in :yuanxu/observability/testing-script make-compiler-progress-reader TestingScript.))
(export selected-source-view-lifecycle-test)
(def source-root (.get yuanxu.init.exports tests source source-root))
(def runtime-option (car (.get TestingScript. runtime-options)))
(def runtime-environment
  (string-append (let (inherited-options (getenv "GAMBOPT" #f))
                       (if inherited-options (string-append inherited-options ",") ""))
                 (substring runtime-option 2 (string-length runtime-option))))
(def (write-source path text)
  (create-directory* (path-directory path))
  (call-with-output-file (list path: path truncate: #t) (lambda (out) (display text out))))
(def (run command (forward? #t))
  (run-script (.cc (.get Ops prototypes Script) command: command directory: source-root
                   environment: (.o GAMBOPT: runtime-environment)
                   progress: make-compiler-progress-reader
                   timeout: 180 idle-timeout: 60 check-status: #f)
              '() output-port: (and forward? (current-error-port))))
(def (action root lib operation (selection "full") (forward? #t))
  (run (list "gxi" "t/qualification/selected-packages/source-view-worker.ss"
             root lib operation selection) forward?))
(def (successful result)
  (unless (zero? (.get result status)) (error "source-view worker failed" (.get result output)))
  (def output (.get result output))
  (when (ormap (lambda (marker) (string-contains output marker))
          '("*** ERROR" "ERROR CASE" "ERROR CHECK" "ERROR HARNESS" "Heap overflow" "Stack overflow"))
    (error "source-view worker reported an error" output))
  output)
(def (compile-events output)
  (call-with-input-string output
    (lambda (port)
      (let loop ((events '()))
        (def line (read-line port))
        (cond ((eof-object? line) (list-sort string<? events))
              ((string-prefix? "... compile " line)
               (loop (cons (substring line 12 (string-length line)) events)))
              (else (loop events)))))))
(def (backdate path)
  (successful (run (list "touch" "-t" "200001010000" path)))
  (time->seconds (file-info-last-modification-time (file-info path))))
(def producer "selected-view-producer/value")
(def consumer "selected-view-consumer/main")
(def (marker lib identity)
  (path-expand (string-append "static/" (if (equal? identity producer)
                                         "selected-view-producer__value" "selected-view-consumer__main") ".scm") lib))
(def selected-source-view-lifecycle-test
  (test-suite "Production selected-source input retry and reuse"
    (test-case "equal-mtime byte changes, interrupted retry and selection isolation"
      (call-with-temporary-directory "selected-view-lifecycle-"
        (lambda (root)
          (def source (path-expand "producer/value.ss" root))
          (def a (path-expand "a/lib" root))
          (def b (path-expand "b/lib" root))
          (write-source (path-expand "producer/gerbil.pkg" root)
                        "(package: selected-view-producer prelude: :gerbil/core)\n")
          (write-source (path-expand "consumer/gerbil.pkg" root)
                        "(package: selected-view-consumer prelude: :gerbil/core)\n")
          (write-source source "(export value) (def value 1)\n")
          (write-source (path-expand "producer/independent.ss" root)
                        "(export independent) (def independent #t)\n")
          (def original-time (backdate source))
          (write-source (path-expand "consumer/main.ss" root)
                        "(import :selected-view-producer/value) (export answer) (def answer value)\n")
          (def affected (list-sort string<? (list producer consumer)))
          (def identities (list-sort string<? (cons "selected-view-producer/independent" affected)))
          (check-equal? (compile-events (successful (action root a "compile"))) identities)
          (check-equal? (compile-events (successful (action root a "compile"))) '())
          (check-equal? (and (string-contains (successful (action root a "use")) "SOURCE-VIEW-VALUE 1") #t) #t)
          (check-equal? (compile-events (successful (action root b "compile"))) identities)
          (def b-marker (module-source-read (marker b producer)))
          ;; Preserve the EXACT original mtime: bytes, not newer-than, must
          ;; invalidate the production adapter's standard completion association.
          (write-source source "(export value) (def value 2)\n")
          (check-equal? (backdate source) original-time)
          (check-equal? (compile-events (successful (action root a "compile"))) affected)
          (check-equal? (and (string-contains (successful (action root a "use")) "SOURCE-VIEW-VALUE 2") #t) #t)
          ;; A callback exception follows preparation but precedes standard Make.
          (write-source source "(export value) (def value 3)\n")
          (check-equal? (backdate source) original-time)
          (check-equal? (and (string-contains (successful (action root a "interrupt")) "SOURCE-VIEW-INTERRUPTED") #t) #t)
          (check-equal? (file-exists? (marker a producer)) #f)
          (check-equal? (and (string-contains (successful (action root a "interrupt")) "SOURCE-VIEW-INTERRUPTED") #t) #t)
          (check-equal? (file-exists? (marker a producer)) #f)
          (check-equal? (compile-events (successful (action root a "compile"))) affected)
          (check-equal? (and (string-contains (successful (action root a "use")) "SOURCE-VIEW-VALUE 3") #t) #t)
          (check-equal? (compile-events (successful (action root a "compile"))) '())
          ;; Output B was never recompiled against the changed source.
          (check-equal? (module-source-read (marker b producer)) b-marker)
          (check-equal? (and (string-contains (successful (action root b "use")) "SOURCE-VIEW-VALUE 1") #t) #t)
          (successful (action root a "compile" "base"))
          (check-equal? (file-exists? (path-expand (string-append ".yuanxu-source/" consumer ".ss") a)) #f)
          (check-equal? (file-exists? (path-expand (string-append ".yuanxu-source/" producer ".ss") a)) #t)
          ;; A local compiler must leave an ordinary marker alone when a
          ;; narrower consumer has pruned its descriptor.
          (def consumer-marker (marker a consumer))
          (def consumer-before (module-source-read consumer-marker))
          (def consumer-time (time->seconds (file-info-last-modification-time (file-info consumer-marker))))
          (def local (successful (action root a "observe-local")))
          (check-equal? (and (string-contains local "SOURCE-VIEW-LOCAL-READY") #t) #t)
          (check-equal? (compile-events local) '())
          (check-equal? (file-exists? (path-expand (string-append ".yuanxu-source/" consumer ".ss") a)) #f)
          (check-equal? (module-source-read consumer-marker) consumer-before)
          (check-equal? (time->seconds (file-info-last-modification-time (file-info consumer-marker))) consumer-time)
          ;; An unknown view file is preserved and refuses before compilation.
          (def unknown (path-expand ".yuanxu-source/unowned.ss" a))
          (write-source unknown ";; user input\n")
          (def rejected (action root a "compile" "base" #f))
          (check-equal? (zero? (.get rejected status)) #f)
          (check-equal? (and (string-contains (.get rejected output) "unowned source in selected compiler view") #t) #t)
          (check-equal? (compile-events (.get rejected output)) '())
          (check-equal? (module-source-read unknown) ";; user input\n")
          (check-equal? (module-source-read (marker b producer)) b-marker)
          (displayln "SELECTED-SOURCE-VIEW equal-mtime=rebuild interrupted-retry=rebuild independent=hot fresh-values=1,2,3 hot=0 other-environment=unchanged prune=ok unowned=refused"))))))

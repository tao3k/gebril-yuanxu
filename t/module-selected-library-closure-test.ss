(import :std/test
        (only-in :std/io/tempfile call-with-temporary-directory)
        (only-in :clan/poo/object .get)
        (only-in :tao3k/yuanxu/module-system/building/source-package register-module-build-source!)
        (only-in :tao3k/yuanxu/module-system/building/build-projection yuanxu-project-source-spec))
(export module-selected-library-closure-test)
(def (write-source path text)
  (create-directory* (path-directory path))
  (call-with-output-file (list path: path truncate: #t) (cut display text <>)))
(def (quoted value) (call-with-output-string (cut write value <>)))
(def module-selected-library-closure-test
  (test-suite "Selected package native library closure"
    (test-case "an ordinary facade preserves a selected foreign package dependency and its source guard"
      (call-with-temporary-directory "selected-library-"
        (lambda (directory)
          (def provider-id (string-append "closure-provider-" (symbol->string (gensym))))
          (def consumer-id (string-append "closure-consumer-" (symbol->string (gensym))))
          (def provider (path-expand provider-id directory))
          (def consumer (path-expand consumer-id directory))
          (def original-path (load-path))
          (add-load-path! directory)
          (with-unwind-protect
           (lambda ()
          (for-each
            (lambda (row)
              (def root (car row))
              (def name (cadr row))
              (def module (caddr row))
              (write-source (path-expand "gerbil.pkg" root)
                (string-append "(package: " name ")\n"))
              (write-source (path-expand (string-append "modules/" module "/types.ss") root)
                "(import (only-in :clan/poo/object object?) (only-in :clan/poo/type Type.)) (export Scope) (def Scope (.cc Type. identity: 'fixture .element?: object?))\n")
              (for-each
                (lambda (role)
                  (write-source (path-expand (string-append "modules/" module "/" role ".ss") root) "(export)\n"))
                '("objects" "config")))
            (list (list provider provider-id "service") (list consumer consumer-id "client")))
          (def helper (path-expand "helpers/value.ss" provider))
          (write-source helper "(export value) (def value 7)\n")
          (write-source (path-expand "helpers/unreached.ss" provider)
            "(error \"unreached source must not initialize\")\n")
          (write-source (path-expand "helpers/facade.ss" consumer)
            (string-append "(import (only-in :" provider-id "/helpers/value value)) (export facade-value) (def facade-value value)\n"))
          (write-source (path-expand "modules/service/interface.ss" provider)
            "(import :clan/poo/object (only-in \"./types.ss\" Scope)) (export Service) (.def Service identity: 'service core: (.o scope-contract: Scope exports: (.o value: 1)) features: (.o))\n")
          (write-source (path-expand "modules/client/interface.ss" consumer)
            "(import :clan/poo/object (only-in \"./types.ss\" Scope) (only-in \"../../helpers/facade.ss\" facade-value)) (export Client) (.def Client identity: 'client core: (.o scope-contract: Scope exports: (.o value: facade-value)) features: (.o))\n")
          (write-source (path-expand "modules/client/entry.ss" consumer)
            "(import (only-in \"../../helpers/facade.ss\" facade-value)) (export value) (def value facade-value)\n")
          (write-source (path-expand "modules/client/build.ss" consumer)
            "(import (only-in :clan/poo/object .def .o)) (export Build) (.def Build defbuild-script: (.o spec: '(\"entry\")))\n")
          (register-module-build-source! provider (string->symbol provider-id) add-load-path?: #f)
          (register-module-build-source! consumer (string->symbol consumer-id) add-load-path?: #f)
          (def init (path-expand "init.ss" consumer))
          (write-source init
            (string-append "(yuanxu! :load-modules " (quoted (path-expand "modules" provider))
              " mode: explicit mount: Provider (service) :load-modules \"./modules\" mode: explicit mount: Consumer (client))\n"))
          (def projection (yuanxu-project-source-spec init '() consumer init))
          (def targets
            (map (lambda (target) (if (string? target) target (cadr target)))
                 (.get projection std-make-spec)))
          (check-equal? (and (member (string-append provider-id "/helpers/value") targets) #t) #t)
          (check-equal? (and (member (string-append consumer-id "/helpers/facade") targets) #t) #t)
          (check-equal? (member (string-append provider-id "/helpers/unreached") targets) #f)
          ((.get projection admit-current))
          (write-source helper "(export value) (def value 9)\n")
          (check-exception ((.get projection admit-current)) error?))
           (lambda () (set-load-path! original-path))))))))
